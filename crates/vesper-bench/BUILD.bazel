load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below), and every other port's ABBA benchmark uses it. The
# Vesper port (the Loom package in vesper/, Cargo feature `vesper-port`,
# port wave P3a lane 5, #1040) is non-default until it reaches parity. The
# compiler links neither: it links the Rust seed copy,
# //crates/vesper-bench/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "bench_vesper",
    library = "bench",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "bench_vesper_binding",
    srcs = [":bench_vesper"],
    output_group = "rust_binding",
)

# Unlike vesper-beacon, the default crate's build script gets no port
# object: crates in the compiler's closure (the other ports' seeds) take
# this package as a dev-dependency, so a port object here would make the
# compiler depend on itself. The port is built only by :port and its tests.
vesper_crate(
    # The causal-profiling test measures wall-clock speedups of spinning
    # threads; sharing the CPU with other test actions distorts it.
    test_tags = {"test/causal": ["exclusive"]},
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-bench/seed:__pkg__"],
)

# The Vesper build: the same sources with cfg(vesper_port), forwarding to
# the port through the committed binding (which the Cargo build checks
# against the generated one), and the crate's tests run unchanged against
# it. The object is linked into each test binary.
rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_bench",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["--cfg=vesper_port"],
    deps = ["//crates/vesper-port-abi"],
)

# The in-crate unit tests of the port build, compiled from the same sources
# as :port (a `crate = ":port"` test does not find the crate root here).
rust_test(
    name = "port_unit_test",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    compile_data = [":bench_vesper"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_bench",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [
        "--cfg=vesper_port",
        "-Clink-arg=$(location :bench_vesper)",
    ],
    deps = ["//crates/vesper-port-abi"],
)

[
    rust_test(
        name = "port_%s_test" % t,
        srcs = ["tests/%s.rs" % t],
        aliases = {"//crates/vesper-bench/seed": "vesper_bench_rust"},
        compile_data = [":bench_vesper"],
        crate_features = ["vesper-port"],
        crate_name = t,
        edition = "2024",
        rustc_flags = ["-Clink-arg=$(location :bench_vesper)"],
        tags = ["exclusive"] if t == "causal" else [],
        deps = [":port"] + (["//crates/vesper-bench/seed"] if t == "differential" else []),
    )
    for t in [
        "causal",
        "contract",
        "contract_gate",
        "differential",
        "execution",
        "gate_classification",
        "hodges_lehmann",
        "implementation",
        "layout",
        "observations",
        "paired_difference",
        "paired_sample_confidence",
        "signed_rank",
        "signed_rank_confidence",
        "statistics",
        "walsh",
        "wire",
    ]
]
