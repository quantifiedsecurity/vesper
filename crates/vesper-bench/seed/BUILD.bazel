# The frozen Rust seed copy of vesper-bench (package vesper-bench-seed,
# library vesper_bench) that the compiler links: ../src built without the
# port, so cfg(vesper_port) is off. Written by hand because its sources live
# in the parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-bench:rust_srcs"],
    crate_name = "vesper_bench",
    crate_root = "//crates/vesper-bench:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-bench-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-bench:tests/%s.rs" % t],
        crate_root = "//crates/vesper-bench:tests/%s.rs" % t,
        edition = "2024",
        # The causal-profiling test measures wall-clock speedups of spinning
        # threads; sharing the CPU with other test actions distorts it.
        tags = ["exclusive"] if t == "causal" else [],
        deps = [":seed"],
    )
    for t in [
        "causal",
        "contract",
        "contract_gate",
        "execution",
        "gate_classification",
        "hodges_lehmann",
        "implementation",
        "layout",
        "observations",
        "paired_difference",
        "paired_sample_confidence",
        "signed_rank",
        "signed_rank_confidence",
        "statistics",
        "walsh",
        "wire",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
