# The frozen Rust seed copy of vesper-alloc (package vesper-alloc-seed,
# library vesper_alloc) that the compiler and every other dependent link:
# ../src built without the port, so cfg(vesper_port) is off. Written by hand
# because its sources live in the parent package; see "Crates the compiler
# links" in docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# libc on unix, from this package's own Cargo metadata.
_CRATE_DATA = PACKAGES["crates/vesper-alloc/seed"].crate_data()

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-alloc:rust_srcs"],
    crate_name = "vesper_alloc",
    crate_root = "//crates/vesper-alloc:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-alloc-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(_CRATE_DATA, normal = True, platforms = _CRATE_DATA["platforms"]),
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

# Every integration test but the two that read files of the parent package
# (the #847 trace fixtures and lean/StrataCollections.lean); those run
# against the seed in Cargo (scripts/test-port-harness.sh) and against the
# port here.
[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-alloc:tests/%s.rs" % t],
        crate_root = "//crates/vesper-alloc:tests/%s.rs" % t,
        edition = "2024",
        rustc_env = {"CARGO_PKG_NAME": "vesper-alloc-seed"},
        deps = [":seed"],
    )
    for t in [
        "arena_core",
        "arena_model",
        "arena_region",
        "cache_btree",
        "collections",
        "flat_core",
        "flat_layout",
        "flat_model",
        "flat_region",
        "implementation",
        "region",
        "region_ref",
        "sharded",
        "slab",
        "tiled_aosoa",
        "tiled_core",
        "tiled_layout",
        "tiled_region",
        "virtual_arena",
        "zero_alloc",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
