load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features). The Vesper port of the
# choreography front end (the Loom package in vesper/, Cargo feature
# `vesper-port`, port wave P3b lane 6, #1068) is non-default until it
# reaches performance parity. The crate is outside the compiler's closure,
# so there is no seed package.
vesper_crate(
    # Lean resolves symlinked runfiles to the source tree and then rejects
    # them as outside --root, so these run in a copy of regular files.
    copy_test_cwd = ["test/lean"],
    extra_test_data = ["//:lean"],
)

vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "chorus_vesper",
    library = "chorus",
    package = ":port_package",
    target = VESPER_TARGET,
)

# The Vesper build: the same sources with the feature, forwarding to the
# port through the committed binding (which the Cargo build checks against
# the generated one). The object is linked into each test binary.
_CRATE_DATA = PACKAGES["crates/vesper-chorus"].crate_data()

rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    compile_data = ["README.md"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_chorus",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//crates/vesper-port-abi"] + all_crate_deps(
        _CRATE_DATA,
        normal = True,
        platforms = _CRATE_DATA["platforms"],
    ),
)

# The test files that do not need the TLS fixtures or Lean, against the
# port. Every test runs against the port in Cargo, in the Linux "Vesper
# ports" job (crates/vesper-chorus/port/test-port.sh).
[
    rust_test(
        name = "port_%s_test" % test,
        srcs = ["tests/%s.rs" % test] + glob(["tests/common/**/*.rs"]),
        compile_data = [":chorus_vesper"],
        crate_features = ["vesper-port"],
        crate_name = test,
        crate_root = "tests/%s.rs" % test,
        edition = "2024",
        rustc_flags = ["-Clink-arg=$(location :chorus_vesper)"],
        deps = [":port"] + (["//crates/vesper-simpulse"] if test in ["raft_sim", "session"] else []),
    )
    for test in [
        "differential",
        "implementation",
        "projection",
        "raft_depth",
        "raft_sim",
        "session",
    ]
]

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits, DIVERGENT in
# build.rs): each must build from a copy of the package with its edit
# applied, and crates/vesper-chorus/port/test-port.sh asserts which test
# catches each one.
[
    vesper_port_object(
        name = "chorus_vesper_divergent_" + module,
        edit_src = "vesper/src/%s.ves" % module,
        edits = {old: new},
        library = "chorus",
        package = ":port_package",
        target = VESPER_TARGET,
    )
    for module, old, new in [
        ("util", "                return 0;\n            }\n            return 2;", "                return 2;\n            }\n            return 0;"),
        ("tree", "    if nr > 1 {", "    if nr > 99 {"),
        ("local", "    if n == 1 {", "    if n == 0 {"),
        ("project", "        if !involves(in c, body, c.target) {", "        if involves(in c, body, c.target) {"),
        ("explore", "            bound_hit = true;", "            bound_hit = false;"),
        ("parse", "    if depth > 64 {", "    if depth > 100000 {"),
    ]
]
