// Vesper port of the vesper-quarry SQL front end (port wave P1 lane 7, #904):
// the lexer and parser (src/parse.rs), the catalog DDL replay and the
// checker (src/lib.rs, src/plan.rs), the predicate-placing optimizer, the
// reference row executor (src/execute.rs) and the index-selecting access
// path planner of spec/planner-ddl.md.
//
// Every entry point returns one `Q` handle. `err` is 0 on success, or the
// failed `ErrorKind` plus one (Syntax = 1 .. Unsupported = 10) with the
// message in `msg`. Results are flat word streams in `words` whose text
// fields are `(offset, length)` ranges of `pool`; the Rust wrapper
// (src/port.rs) rebuilds the crate's own types from them. The encodings are
// documented in src/port.rs.
//
// Errors are sticky: the first `fail` wins, and every step returns early
// once `err` is set. Fail[E] cannot be used here, because an abortable
// effect may not cross an active `inout` parameter (E0402).
//
// Shared codes:
//   ScalarType: U64 0, I64 1, F64 2, Bool 3, Text 4, Bytes 5. A type word is
//     0 for "none" and the type plus one otherwise.
//   Value tags: Null 0, U64 1, I64 2, F64 3, Bool 4, Text 5, Bytes 6, so a
//     non-null value's type word equals its tag.
//   Cmp: Eq 0, Ne 1, Lt 2, Le 3, Gt 4, Ge 5. JoinKind: Inner 0, Left 1,
//     Right 2, Full 3.
//   Limits: the 14 fields of `Limits` in declaration order, then the byte
//     sizes of a Rust `Value` and a Rust `Vec<Value>` (the row executor
//     charges them exactly as the Rust executor did).

// One SQL token. kind: Word 1 (a, b = pool range of the lowercase word),
// Param 2 (same), Int 3 (a = the i64 bits), Text 4 (a, b = pool range),
// Sym 5 (a = the ASCII byte), Op 6 (a = Cmp).
copy struct Tok {
    kind: u64,
    a: u64,
    b: u64,
    // For a Word: its reserved keyword id (1 select .. 31 using, in the
    // order of `keyword`), or 0.
    kw: u64
}

// One parsed (unchecked) expression. kind: Column 0 (a, b = qualifier range,
// a = none when unqualified; c, d = name range), Param 1 (a, b = name),
// Literal 2 (a = value tag, b, c = value words), Compare 3 (a = Cmp,
// b, c = operands), And 4 and Or 5 (b, c), Not 6 (b), IsNull 7 (a = negated,
// b = operand).
copy struct Raw {
    kind: u64,
    a: u64,
    b: u64,
    c: u64,
    d: u64
}

// A projection item: `expr` is none for `*`; the alias range has `aoff` none
// when absent.
copy struct Sel {
    expr: u64,
    aoff: u64,
    alen: u64
}

// A FROM or JOIN binding (kind is the JoinKind of a join, `on` its raw
// condition).
copy struct Bind {
    kind: u64,
    noff: u64,
    nlen: u64,
    aoff: u64,
    alen: u64,
    on: u64
}

// A catalog table: name range and its columns `cols[start .. start + n]`.
copy struct CTab {
    noff: u64,
    nlen: u64,
    start: u64,
    n: u64
}

// A column or parameter definition. `used` marks referenced parameters.
copy struct CCol {
    noff: u64,
    nlen: u64,
    ty: u64,
    nullable: bool,
    used: bool
}

// A checked column identity (`BoundColumn`).
copy struct BCol {
    aoff: u64,
    alen: u64,
    coff: u64,
    clen: u64,
    binding: u64,
    slot: u64,
    ty: u64,
    nullable: bool
}

// A pool range.
copy struct Rng {
    off: u64,
    len: u64
}

// A logical plan node. kind: Scan 0 (a, b = table range, c = binding,
// d = position of the slot words in `ex`, e = slot count, f/g = first/last
// predicate link or none), Filter 1 (a = predicate position in `ex`,
// b = input node), Join 2 (a = JoinKind, b = lhs, c = rhs, d = condition
// position in `ex`).
copy struct Node {
    kind: u64,
    a: u64,
    b: u64,
    c: u64,
    d: u64,
    e: u64,
    f: u64,
    g: u64
}

// A scan predicate list link: the predicate position in `ex` and the next
// link (or none).
copy struct Link {
    expr: u64,
    next: u64
}

// A value: tag and two payload words (see the header). F64 carries its bits
// in `a`; Text and Bytes carry a pool range.
copy struct Val {
    t: u64,
    a: u64,
    b: u64
}

// Access path statistics of one analyzed column (planner).
copy struct Stat {
    binding: u64,
    slot: u64,
    // Index name range, or none when the column has no index.
    ioff: u64,
    ilen: u64,
    nonnull: u64,
    distinct: u64,
    // The column's analyzed values, sorted, at `vals[start .. start + n]`
    // with their counts in `counts`.
    start: u64,
    n: u64
}

// A sargable bound collected for one column during access selection.
copy struct Bound {
    has_lo: bool,
    lo: Val,
    lo_incl: bool,
    has_hi: bool,
    hi: Val,
    hi_incl: bool,
    // A bound value is NULL: the path yields no rows.
    null: bool,
    // A bound value is a parameter with no value at planning.
    unknown: bool,
    // Every bound came from an `=` predicate.
    only_eq: bool
}

// Everything one call needs; returned to Rust as the result handle.
struct Q {
    err: u64,
    msg: ChunkSeq[u8],
    words: ChunkSeq[u64],
    pool: ChunkSeq[u8],
    lim: ChunkSeq[u64],
    toks: ChunkSeq[Tok],
    pos: u64,
    nodes: u64,
    raw: ChunkSeq[Raw],
    sels: ChunkSeq[Sel],
    binds: ChunkSeq[Bind],
    filter: u64,
    tabs: ChunkSeq[CTab],
    cols: ChunkSeq[CCol],
    params: ChunkSeq[CCol],
    bcols: ChunkSeq[BCol],
    aliases: ChunkSeq[Rng],
    nbindings: u64,
    ex: ChunkSeq[u64],
    plan: ChunkSeq[Node],
    links: ChunkSeq[Link],
    rows: ChunkSeq[u64],
    rowset: ChunkSeq[u64],
    flags: ChunkSeq[bool],
    work: u64,
    brows: u64,
    bbytes: u64,
    dtabs: ChunkSeq[CTab],
    decls: ChunkSeq[CCol],
    stats: ChunkSeq[Stat],
    vals: ChunkSeq[Val],
    counts: ChunkSeq[u64]
}

// ---------------------------------------------------------------------
// Small helpers.

fn none() -> u64 {
    18446744073709551615
}

fn new_q() -> Q {
    Q {
        err: 0,
        msg: ChunkSeq::new[u8](),
        words: ChunkSeq::new[u64](),
        pool: ChunkSeq::new[u8](),
        lim: ChunkSeq::new[u64](),
        toks: ChunkSeq::new[Tok](),
        pos: 0,
        nodes: 0,
        raw: ChunkSeq::new[Raw](),
        sels: ChunkSeq::new[Sel](),
        binds: ChunkSeq::new[Bind](),
        filter: none(),
        tabs: ChunkSeq::new[CTab](),
        cols: ChunkSeq::new[CCol](),
        params: ChunkSeq::new[CCol](),
        bcols: ChunkSeq::new[BCol](),
        aliases: ChunkSeq::new[Rng](),
        nbindings: 0,
        ex: ChunkSeq::new[u64](),
        plan: ChunkSeq::new[Node](),
        links: ChunkSeq::new[Link](),
        rows: ChunkSeq::new[u64](),
        rowset: ChunkSeq::new[u64](),
        flags: ChunkSeq::new[bool](),
        work: 0,
        brows: 0,
        bbytes: 0,
        dtabs: ChunkSeq::new[CTab](),
        decls: ChunkSeq::new[CCol](),
        stats: ChunkSeq::new[Stat](),
        vals: ChunkSeq::new[Val](),
        counts: ChunkSeq::new[u64]()
    }
}

fn sw(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn sb(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn cw(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn cb(in s: ChunkSeq[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn lim(in q: Q, i: u64) -> u64 {
    match q.lim.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn ex(in q: Q, i: u64) -> u64 {
    match q.ex.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn tok(in q: Q, i: u64) -> Tok {
    match q.toks.try_get(i) {
        Option::Some(t) => t,
        Option::None => Tok {
            kind: 0,
            a: 0,
            b: 0,
            kw: 0
        },
    }
}

fn raw(in q: Q, i: u64) -> Raw {
    match q.raw.try_get(i) {
        Option::Some(r) => r,
        Option::None => Raw {
            kind: 0,
            a: 0,
            b: 0,
            c: 0,
            d: 0
        },
    }
}

fn node(in q: Q, i: u64) -> Node {
    match q.plan.try_get(i) {
        Option::Some(n) => n,
        Option::None => Node {
            kind: 0,
            a: 0,
            b: 0,
            c: 0,
            d: 0,
            e: 0,
            f: none(),
            g: none()
        },
    }
}

fn link(in q: Q, i: u64) -> Link {
    match q.links.try_get(i) {
        Option::Some(l) => l,
        Option::None => Link {
            expr: 0,
            next: none()
        },
    }
}

fn bcol(in q: Q, i: u64) -> BCol {
    match q.bcols.try_get(i) {
        Option::Some(c) => c,
        Option::None => BCol {
            aoff: 0,
            alen: 0,
            coff: 0,
            clen: 0,
            binding: 0,
            slot: 0,
            ty: 0,
            nullable: false
        },
    }
}

fn empty_col() -> CCol {
    CCol {
        noff: 0,
        nlen: 0,
        ty: 0,
        nullable: false,
        used: false
    }
}

fn ccol(in q: Q, i: u64) -> CCol {
    match q.cols.try_get(i) {
        Option::Some(c) => c,
        Option::None => empty_col(),
    }
}

fn param(in q: Q, i: u64) -> CCol {
    match q.params.try_get(i) {
        Option::Some(c) => c,
        Option::None => empty_col(),
    }
}

fn ctab(in q: Q, i: u64) -> CTab {
    match q.tabs.try_get(i) {
        Option::Some(t) => t,
        Option::None => CTab {
            noff: 0,
            nlen: 0,
            start: 0,
            n: 0
        },
    }
}

fn null_val() -> Val {
    Val {
        t: 0,
        a: 0,
        b: 0
    }
}

fn bool_val(b: bool) -> Val {
    Val {
        t: 4,
        a: if b {
            1
        } else {
            0
        },
        b: 0
    }
}

fn vat(in q: Q, i: u64) -> Val {
    match q.vals.try_get(i) {
        Option::Some(v) => v,
        Option::None => null_val(),
    }
}

fn bflag(in q: Q, i: u64) -> bool {
    match q.flags.try_get(i) {
        Option::Some(b) => b,
        Option::None => false,
    }
}

// `(v / d, v % d)`, and `(0, 0)` when `d` is 0.
fn div_rem(v: u64, d: u64) -> (u64, u64) {
    if d == 0 {
        return (0, 0);
    }
    handle Fail[RuntimeError] in {
        (v / d, v % d)
    } with {
        return q => q,
        raise(e, k) => (0, 0),
    }
}

// ceil(a / b) for b > 0.
fn ceil_div(a: u64, b: u64) -> u64 {
    let (d, r) = div_rem(a, b);
    if r == 0 {
        d
    } else {
        wrapping_add(d, 1)
    }
}

fn put(inout m: ChunkSeq[u8], in s: Str) {
    for i in 0..s.len() {
        match s.try_byte_at(i) {
            Option::Some(b) => m.push(b),
            Option::None => (),
        }
    }
}

fn put_range(inout m: ChunkSeq[u8], in p: ChunkSeq[u8], off: u64, len: u64) {
    for i in 0..len {
        m.push(cb(in p, wrapping_add(off, i)));
    }
}

fn put_u64(inout m: ChunkSeq[u8], x: u64) {
    let from = m.len();
    let mut v = x;
    loop {
        let (d, r) = div_rem(v, 10);
        m.push(wrapping_u8(wrapping_add(r, 48)));
        v = d;
        if v == 0 {
            break;
        }
    }
    let mut i = from;
    let mut j = m.len();
    loop {
        if j <= i {
            break;
        }
        j = wrapping_sub(j, 1);
        if j <= i {
            break;
        }
        let a = cb(in m, i);
        let b = cb(in m, j);
        m.try_set(i, b);
        m.try_set(j, a);
        i = wrapping_add(i, 1);
    }
}

// Whether pool[off .. off + len] is the literal `s`.
fn is_lit(in p: ChunkSeq[u8], off: u64, len: u64, in s: Str) -> bool {
    if len != s.len() {
        return false;
    }
    for i in 0..len {
        let b = match s.try_byte_at(i) {
            Option::Some(b) => b,
            Option::None => 0,
        };
        if cb(in p, wrapping_add(off, i)) != b {
            return false;
        }
    }
    true
}

// Whether two pool ranges hold the same bytes.
fn same(in p: ChunkSeq[u8], ao: u64, al: u64, bo: u64, bl: u64) -> bool {
    if al != bl {
        return false;
    }
    for i in 0..al {
        if cb(in p, wrapping_add(ao, i)) != cb(in p, wrapping_add(bo, i)) {
            return false;
        }
    }
    true
}

// Byte-wise order of two pool ranges: 0 less, 1 equal, 2 greater.
fn order(in p: ChunkSeq[u8], ao: u64, al: u64, bo: u64, bl: u64) -> u64 {
    let n = if al < bl {
        al
    } else {
        bl
    };
    for i in 0..n {
        let x = cb(in p, wrapping_add(ao, i));
        let y = cb(in p, wrapping_add(bo, i));
        if x < y {
            return 0;
        }
        if x > y {
            return 2;
        }
    }
    if al < bl {
        0
    } else if al > bl {
        2
    } else {
        1
    }
}

// ---------------------------------------------------------------------
// Errors.

// Record the first error (kind is ErrorKind + 1); later ones are ignored.
fn fail(inout q: Q, kind: u64, in m: Str) {
    if q.err == 0 {
        q.err = kind;
        put(inout q.msg, m);
    }
}

// Record the first error as `prefix` followed by a pool range.
fn fail_name(inout q: Q, kind: u64, in prefix: Str, off: u64, len: u64) {
    if q.err == 0 {
        q.err = kind;
        put(inout q.msg, prefix);
        put_range(inout q.msg, in q.pool, off, len);
    }
}

fn syntax(inout q: Q, in m: Str) {
    if q.err == 0 {
        q.err = 1;
        put(inout q.msg, m);
        put(inout q.msg, " near token ");
        put_u64(inout q.msg, q.pos);
    }
}

// `bound(n, max, what)`: a Limit error when n > max.
fn bound(inout q: Q, n: u64, li: u64, in what: Str) -> bool {
    if n > lim(in q, li) {
        fail(inout q, 6, what);
        false
    } else {
        true
    }
}

fn hard(i: u64) -> u64 {
    if i == 0 {
        65536
    } else if i == 1 {
        8192
    } else if i == 2 {
        512
    } else if i == 3 {
        32
    } else if i == 4 {
        64
    } else if i == 5 {
        128
    } else if i == 6 {
        16
    } else if i == 7 {
        10000
    } else if i == 8 {
        4194304
    } else if i == 9 {
        1000000
    } else if i == 10 {
        10000
    } else if i == 11 {
        8388608
    } else if i == 12 {
        10000
    } else {
        4194304
    }
}

// Copy the limits in and check them against the hard ceilings
// (`Limits::validate`).
fn load_limits(inout q: Q, in limits: Slice[u64]) -> bool {
    let all: u64 = 16;
    for i in 0..all {
        q.lim.push(sw(in limits, i));
    }
    let n: u64 = 14;
    for i in 0..n {
        if lim(in q, i) > hard(i) {
            fail(inout q, 6, "limit exceeds hard ceiling");
            return false;
        }
    }
    true
}

// `identifier(pool[off..off+len])`: appends the lowercase copy to the pool
// and returns its offset, or records the Syntax error.
fn identifier(inout q: Q, off: u64, len: u64) -> u64 {
    let mut ok = len > 0 && len <= 128;
    for i in 0..len {
        let c = match q.pool.try_get(wrapping_add(off, i)) {
            Option::Some(c) => c,
            Option::None => 0,
        };
        let alpha = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
        let digit = c >= 48 && c <= 57;
        if i == 0 {
            if !alpha {
                ok = false;
            }
        } else if !alpha && !digit {
            ok = false;
        }
    }
    if !ok {
        fail(inout q, 1, "expected ASCII identifier of at most 128 bytes");
        return 0;
    }
    let start = q.pool.len();
    for i in 0..len {
        let c = match q.pool.try_get(wrapping_add(off, i)) {
            Option::Some(c) => c,
            Option::None => 0,
        };
        let lower = if c >= 65 && c <= 90 {
            wrapping_add(c, 32)
        } else {
            c
        };
        q.pool.push(lower);
    }
    start
}

// ---------------------------------------------------------------------
// Catalog input: [ntables, (name off, name len, ncols,
// (off, len, ty, nullable)*)*], ranges into the input text, which is the
// start of the pool.

fn load_catalog(inout q: Q, in meta: Slice[u64], at: u64) -> u64 {
    let n = sw(in meta, at);
    let mut p = wrapping_add(at, 1);
    for t in 0..n {
        let noff = sw(in meta, p);
        let nlen = sw(in meta, wrapping_add(p, 1));
        let nc = sw(in meta, wrapping_add(p, 2));
        p = wrapping_add(p, 3);
        q.tabs.push(CTab {
            noff: noff,
            nlen: nlen,
            start: q.cols.len(),
            n: nc
        });
        for c in 0..nc {
            q.cols.push(CCol {
                noff: sw(in meta, p),
                nlen: sw(in meta, wrapping_add(p, 1)),
                ty: sw(in meta, wrapping_add(p, 2)),
                nullable: sw(in meta, wrapping_add(p, 3)) != 0,
                used: false
            });
            p = wrapping_add(p, 4);
        }
    }
    p
}

// The catalog table named by a pool range, or none.
fn find_table(in q: Q, off: u64, len: u64) -> u64 {
    for i in 0..q.tabs.len() {
        let t = ctab(in q, i);
        if same(in q.pool, t.noff, t.nlen, off, len) {
            return i;
        }
    }
    none()
}

// ---------------------------------------------------------------------
// Lexer (src/parse.rs `lex`).

fn byte(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => widen_u64(x),
        Option::None => 0,
    }
}

fn is_space(c: u64) -> bool {
    c == 32 || c == 9 || c == 10 || c == 12 || c == 13
}

fn is_word_byte(c: u64) -> bool {
    (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
}

fn is_digit(c: u64) -> bool {
    c >= 48 && c <= 57
}

fn lex(inout q: Q, in sql: Slice[u8]) {
    let bn = sql.len();
    if !bound(inout q, bn, 0, "SQL byte limit") {
        return;
    }
    // The SQL text is copied after the input text so identifiers can be
    // normalized from the pool.
    let base = q.pool.len();
    q.pool.extend(in sql);
    let n = sql.len();
    let mut i: u64 = 0;
    loop {
        if i >= n || q.err != 0 {
            break;
        }
        let c = byte(in sql, i);
        if is_space(c) {
            i = wrapping_add(i, 1);
        } else {
        let bn = wrapping_add(q.toks.len(), 1);
        if !bound(inout q, bn, 1, "SQL token limit") {
            return;
        }
        let start = i;
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 58 {
            let is_param = c == 58;
            if is_param {
                i = wrapping_add(i, 1);
            }
            let word_start = i;
            loop {
                if i >= n || !is_word_byte(byte(in sql, i)) {
                    break;
                }
                i = wrapping_add(i, 1);
            }
            let len = wrapping_sub(i, word_start);
            let off = identifier(inout q, wrapping_add(base, word_start), len);
            if q.err != 0 {
                return;
            }
            let kw = if is_param {
                0
            } else {
                keyword(in q.pool, off, len)
            };
            q.toks.push(Tok {
                kind: if is_param {
                    2
                } else {
                    1
                },
                a: off,
                b: len,
                kw: kw
            });
        } else if is_digit(c) || c == 45 {
            i = wrapping_add(i, 1);
            loop {
                if i >= n || !is_digit(byte(in sql, i)) {
                    break;
                }
                i = wrapping_add(i, 1);
            }
            // Parse sql[start..i] as an i64.
            let neg = c == 45;
            let first = if neg {
                wrapping_add(start, 1)
            } else {
                start
            };
            let mut ok = first < i;
            let mut m: u64 = 0;
            let mut j = first;
            loop {
                if j >= i || !ok {
                    break;
                }
                if m > 922337203685477580 {
                    ok = false;
                } else {
                    m = wrapping_add(wrapping_mul(m, 10), wrapping_sub(byte(in sql, j), 48));
                    if m > 9223372036854775808 {
                        ok = false;
                    }
                }
                j = wrapping_add(j, 1);
            }
            if ok && !neg && m > 9223372036854775807 {
                ok = false;
            }
            if !ok {
                fail(inout q, 1, "invalid or overflowing i64 literal");
                return;
            }
            let v = if neg {
                wrapping_sub(0, m)
            } else {
                m
            };
            q.toks.push(Tok {
                kind: 3,
                a: v,
                b: 0,
                kw: 0
            });
        } else if c == 39 {
            i = wrapping_add(i, 1);
            let off = q.pool.len();
            let mut part = i;
            loop {
                if i == n {
                    fail(inout q, 1, "unterminated string");
                    return;
                }
                if byte(in sql, i) == 39 {
                    for k in part..i {
                        q.pool.push(sb(in sql, k));
                    }
                    i = wrapping_add(i, 1);
                    if i < n && byte(in sql, i) == 39 {
                        q.pool.push(39);
                        i = wrapping_add(i, 1);
                        part = i;
                    } else {
                        break;
                    }
                } else {
                    i = wrapping_add(i, 1);
                }
            }
            q.toks.push(Tok {
                kind: 4,
                a: off,
                b: wrapping_sub(q.pool.len(), off),
                kw: 0
            });
        } else if c == 61 {
            i = wrapping_add(i, 1);
            q.toks.push(Tok {
                kind: 6,
                a: 0,
                b: 0,
                kw: 0
            });
        } else if c == 60 || c == 62 || c == 33 {
            i = wrapping_add(i, 1);
            let second = if i < n {
                byte(in sql, i)
            } else {
                0
            };
            let mut op: u64 = 0;
            if c == 60 && second == 61 {
                i = wrapping_add(i, 1);
                op = 3;
            } else if c == 62 && second == 61 {
                i = wrapping_add(i, 1);
                op = 5;
            } else if (c == 60 && second == 62) || (c == 33 && second == 61) {
                i = wrapping_add(i, 1);
                op = 1;
            } else if c == 60 {
                op = 2;
            } else if c == 62 {
                op = 4;
            } else {
                fail(inout q, 1, "unsupported operator");
                return;
            }
            q.toks.push(Tok {
                kind: 6,
                a: op,
                b: 0,
                kw: 0
            });
        } else if c == 40 || c == 41 || c == 44 || c == 46 || c == 59 || c == 42 {
            i = wrapping_add(i, 1);
            q.toks.push(Tok {
                kind: 5,
                a: c,
                b: 0,
                kw: 0
            });
        } else {
            if q.err == 0 {
                q.err = 1;
                put(inout q.msg, "unsupported token at byte ");
                put_u64(inout q.msg, i);
            }
            return;
        }
        }
    }
}

// ---------------------------------------------------------------------
// Parser (src/parse.rs `Parser`).

fn at_end(in q: Q) -> bool {
    q.pos >= q.toks.len()
}

fn peek_is_word(in q: Q, kw: u64) -> bool {
    let t = tok(in q, q.pos);
    t.kind == 1 && t.kw == kw
}

fn peek_is_sym(in q: Q, c: u64) -> bool {
    let t = tok(in q, q.pos);
    t.kind == 5 && t.a == c
}

fn word(inout q: Q, kw: u64) -> bool {
    if q.err == 0 && peek_is_word(in q, kw) {
        q.pos = wrapping_add(q.pos, 1);
        true
    } else {
        false
    }
}

fn sym(inout q: Q, c: u64) -> bool {
    if q.err == 0 && peek_is_sym(in q, c) {
        q.pos = wrapping_add(q.pos, 1);
        true
    } else {
        false
    }
}

fn expect_word(inout q: Q, kw: u64, in s: Str) {
    if !word(inout q, kw) && q.err == 0 {
        q.err = 1;
        put(inout q.msg, "expected ");
        put(inout q.msg, s);
        put(inout q.msg, " near token ");
        put_u64(inout q.msg, q.pos);
    }
}

fn expect_sym(inout q: Q, c: u64) {
    if !sym(inout q, c) && q.err == 0 {
        q.err = 1;
        put(inout q.msg, "expected ");
        q.msg.push(wrapping_u8(c));
        put(inout q.msg, " near token ");
        put_u64(inout q.msg, q.pos);
    }
}

// `take`: the next token, or the "unexpected end" error (kind 0).
fn take(inout q: Q) -> Tok {
    if q.err != 0 {
        return tok(in q, none());
    }
    if at_end(in q) {
        syntax(inout q, "unexpected end");
        return tok(in q, none());
    }
    let t = tok(in q, q.pos);
    q.pos = wrapping_add(q.pos, 1);
    t
}

// The reserved keyword id of a lowercase word (`Tok::kw`), or 0.
fn keyword(in p: ChunkSeq[u8], off: u64, len: u64) -> u64 {
    let c = match p.try_get(off) {
        Option::Some(c) => c,
        Option::None => 0,
    };
    if len == 2 {
        if c == 111 && is_lit(in p, off, len, "on") {
            return 10;
        }
        if c == 97 && is_lit(in p, off, len, "as") {
            return 11;
        }
        if c == 111 && is_lit(in p, off, len, "or") {
            return 13;
        }
        if c == 105 && is_lit(in p, off, len, "is") {
            return 15;
        }
        if c == 98 && is_lit(in p, off, len, "by") {
            return 23;
        }
    } else if len == 3 {
        if c == 97 && is_lit(in p, off, len, "and") {
            return 12;
        }
        if c == 110 && is_lit(in p, off, len, "not") {
            return 14;
        }
    } else if len == 4 {
        if c == 102 && is_lit(in p, off, len, "from") {
            return 2;
        }
        if c == 106 && is_lit(in p, off, len, "join") {
            return 4;
        }
        if c == 108 && is_lit(in p, off, len, "left") {
            return 6;
        }
        if c == 102 && is_lit(in p, off, len, "full") {
            return 8;
        }
        if c == 110 && is_lit(in p, off, len, "null") {
            return 16;
        }
        if c == 116 && is_lit(in p, off, len, "true") {
            return 17;
        }
        if c == 100 && is_lit(in p, off, len, "drop") {
            return 20;
        }
    } else if len == 5 {
        if c == 119 && is_lit(in p, off, len, "where") {
            return 3;
        }
        if c == 105 && is_lit(in p, off, len, "inner") {
            return 5;
        }
        if c == 114 && is_lit(in p, off, len, "right") {
            return 7;
        }
        if c == 111 && is_lit(in p, off, len, "outer") {
            return 9;
        }
        if c == 102 && is_lit(in p, off, len, "false") {
            return 18;
        }
        if c == 116 && is_lit(in p, off, len, "table") {
            return 21;
        }
        if c == 111 && is_lit(in p, off, len, "order") {
            return 22;
        }
        if c == 103 && is_lit(in p, off, len, "group") {
            return 24;
        }
        if c == 108 && is_lit(in p, off, len, "limit") {
            return 25;
        }
        if c == 117 && is_lit(in p, off, len, "union") {
            return 26;
        }
        if c == 99 && is_lit(in p, off, len, "cross") {
            return 30;
        }
        if c == 117 && is_lit(in p, off, len, "using") {
            return 31;
        }
    } else if len == 6 {
        if c == 115 && is_lit(in p, off, len, "select") {
            return 1;
        }
        if c == 99 && is_lit(in p, off, len, "create") {
            return 19;
        }
        if c == 104 && is_lit(in p, off, len, "having") {
            return 28;
        }
        if c == 111 && is_lit(in p, off, len, "offset") {
            return 29;
        }
    } else if len == 8 {
        if c == 100 && is_lit(in p, off, len, "distinct") {
            return 27;
        }
    }
    0
}

// A non-keyword identifier, as a pool range.
fn ident(inout q: Q) -> Rng {
    let t = take(inout q);
    if q.err != 0 {
        return Rng {
            off: 0,
            len: 0
        };
    }
    if t.kind == 1 && t.kw == 0 {
        Rng {
            off: t.a,
            len: t.b
        }
    } else {
        syntax(inout q, "expected non-keyword identifier");
        Rng {
            off: 0,
            len: 0
        }
    }
}

// Count one expression node and store it.
fn push_raw(inout q: Q, r: Raw) -> u64 {
    if q.err != 0 {
        return none();
    }
    q.nodes = wrapping_add(q.nodes, 1);
    let bn = q.nodes;
    if !bound(inout q, bn, 2, "expression node limit") {
        return none();
    }
    q.raw.push(r);
    wrapping_sub(q.raw.len(), 1)
}

fn raw2(kind: u64, a: u64, b: u64, c: u64) -> Raw {
    Raw {
        kind: kind,
        a: a,
        b: b,
        c: c,
        d: 0
    }
}

fn parse_expr(inout q: Q, depth: u64) -> u64 {
    let bn = depth;
    if !bound(inout q, bn, 3, "expression nesting limit") {
        return none();
    }
    let mut lhs = parse_and(inout q, depth);
    loop {
        if q.err != 0 || !word(inout q, 13) {
            break;
        }
        let rhs = parse_and(inout q, depth);
        if q.err != 0 {
            break;
        }
        lhs = push_raw(inout q, raw2(5, 0, lhs, rhs));
    }
    lhs
}

fn parse_and(inout q: Q, depth: u64) -> u64 {
    let mut lhs = parse_not(inout q, depth);
    loop {
        if q.err != 0 || !word(inout q, 12) {
            break;
        }
        let rhs = parse_not(inout q, depth);
        if q.err != 0 {
            break;
        }
        lhs = push_raw(inout q, raw2(4, 0, lhs, rhs));
    }
    lhs
}

fn parse_not(inout q: Q, depth: u64) -> u64 {
    let bn = depth;
    if !bound(inout q, bn, 3, "expression nesting limit") {
        return none();
    }
    if word(inout q, 14) {
        let x = parse_not(inout q, wrapping_add(depth, 1));
        return push_raw(inout q, raw2(6, 0, x, 0));
    }
    let lhs = parse_atom(inout q, depth);
    if q.err != 0 {
        return none();
    }
    let t = tok(in q, q.pos);
    if t.kind == 6 {
        q.pos = wrapping_add(q.pos, 1);
        let rhs = parse_atom(inout q, depth);
        push_raw(inout q, raw2(3, t.a, lhs, rhs))
    } else if word(inout q, 15) {
        let negated = word(inout q, 14);
        expect_word(inout q, 16, "null");
        push_raw(
            inout q,
            raw2(
                7,
                if negated {
                    1
                } else {
                    0
                },
                lhs,
                0
            )
        )
    } else {
        lhs
    }
}

fn parse_atom(inout q: Q, depth: u64) -> u64 {
    if sym(inout q, 40) {
        let x = parse_expr(inout q, wrapping_add(depth, 1));
        expect_sym(inout q, 41);
        return x;
    }
    let t = take(inout q);
    if q.err != 0 {
        return none();
    }
    let r = if t.kind == 2 {
        raw2(1, t.a, t.b, 0)
    } else if t.kind == 3 {
        Raw {
            kind: 2,
            a: 2,
            b: t.a,
            c: 0,
            d: 0
        }
    } else if t.kind == 4 {
        Raw {
            kind: 2,
            a: 5,
            b: t.a,
            c: t.b,
            d: 0
        }
    } else if t.kind == 1 && t.kw == 16 {
        Raw {
            kind: 2,
            a: 0,
            b: 0,
            c: 0,
            d: 0
        }
    } else if t.kind == 1 && (t.kw == 17 || t.kw == 18) {
        Raw {
            kind: 2,
            a: 4,
            b: if t.kw == 17 {
                1
            } else {
                0
            },
            c: 0,
            d: 0
        }
    } else if t.kind == 1 && t.kw == 0 {
        if sym(inout q, 46) {
            let name = ident(inout q);
            Raw {
                kind: 0,
                a: t.a,
                b: t.b,
                c: name.off,
                d: name.len
            }
        } else {
            Raw {
                kind: 0,
                a: none(),
                b: 0,
                c: t.a,
                d: t.b
            }
        }
    } else {
        syntax(inout q, "expected scalar expression");
        return none();
    };
    push_raw(inout q, r)
}

fn parse_table(inout q: Q, kind: u64) -> Bind {
    let name = ident(inout q);
    let t = tok(in q, q.pos);
    let plain = q.err == 0 && t.kind == 1 && t.kw == 0;
    let alias = if word(inout q, 11) || plain {
        ident(inout q)
    } else {
        name
    };
    Bind {
        kind: kind,
        noff: name.off,
        nlen: name.len,
        aoff: alias.off,
        alen: alias.len,
        on: none()
    }
}

fn finish(inout q: Q) {
    sym(inout q, 59);
    if q.err == 0 && !at_end(in q) {
        syntax(inout q, "unsupported or trailing syntax");
    }
}

// SELECT: fills sels, binds (the FROM binding first) and filter.
fn parse_select(inout q: Q) {
    expect_word(inout q, 1, "select");
    loop {
        if q.err != 0 {
            return;
        }
        let star = sym(inout q, 42);
        let expr = if star {
            none()
        } else {
            parse_expr(inout q, 0)
        };
        let mut aoff = none();
        let mut alen: u64 = 0;
        if word(inout q, 11) {
            let a = ident(inout q);
            aoff = a.off;
            alen = a.len;
        }
        if q.err != 0 {
            return;
        }
        if star && aoff != none() {
            syntax(inout q, "star cannot be aliased");
            return;
        }
        q.sels.push(Sel {
            expr: expr,
            aoff: aoff,
            alen: alen
        });
        let bn = q.sels.len();
        if !bound(inout q, bn, 2, "projection limit") {
            return;
        }
        if !sym(inout q, 44) {
            break;
        }
    }
    expect_word(inout q, 2, "from");
    let from = parse_table(inout q, 0);
    if q.err != 0 {
        return;
    }
    q.binds.push(from);
    let bn: u64 = 1;
    if !bound(inout q, bn, 6, "relation limit") {
        return;
    }
    loop {
        if q.err != 0 || at_end(in q) || peek_is_sym(in q, 59) || peek_is_word(in q, 3) {
            break;
        }
        let kind: u64 = if word(inout q, 5) {
            0
        } else if word(inout q, 6) {
            word(inout q, 9);
            1
        } else if word(inout q, 7) {
            word(inout q, 9);
            2
        } else if word(inout q, 8) {
            word(inout q, 9);
            3
        } else {
            0
        };
        expect_word(inout q, 4, "join");
        if q.err != 0 {
            return;
        }
        // binds holds the FROM binding too, so its length is joins + 1.
        let bn = wrapping_add(q.binds.len(), 1);
        if !bound(inout q, bn, 6, "relation limit") {
            return;
        }
        let mut rhs = parse_table(inout q, kind);
        expect_word(inout q, 10, "on");
        let on = parse_expr(inout q, 0);
        if q.err != 0 {
            return;
        }
        rhs.on = on;
        q.binds.push(rhs);
    }
    if word(inout q, 3) {
        q.filter = parse_expr(inout q, 0);
    }
    finish(inout q);
}

// ---------------------------------------------------------------------
// DDL (src/parse.rs `ddl` and `HermeticCatalog::apply_ddl_changes`).

fn scalar_type(inout q: Q) -> u64 {
    let t = take(inout q);
    if q.err != 0 {
        return 0;
    }
    if t.kind != 1 {
        syntax(inout q, "expected scalar type");
        return 0;
    }
    let p = t.a;
    let n = t.b;
    if is_lit(in q.pool, p, n, "u64") {
        0
    } else if is_lit(in q.pool, p, n, "i64") || is_lit(in q.pool, p, n, "bigint") {
        1
    } else if is_lit(in q.pool, p, n, "f64") || is_lit(in q.pool, p, n, "double") {
        2
    } else if is_lit(in q.pool, p, n, "bool") || is_lit(in q.pool, p, n, "boolean") {
        3
    } else if is_lit(in q.pool, p, n, "text") {
        4
    } else if is_lit(in q.pool, p, n, "bytes") || is_lit(in q.pool, p, n, "blob") {
        5
    } else {
        syntax(inout q, "unsupported scalar type");
        0
    }
}

// Parses every statement into `words` as
// [0, name off, name len, ncols, (off, len, ty, nullable)*] or
// [1, name off, name len], and returns the statement count.
fn parse_ddl(inout q: Q) -> u64 {
    let mut count: u64 = 0;
    loop {
        if q.err != 0 || at_end(in q) {
            break;
        }
        let bn = wrapping_add(count, 1);
        if !bound(inout q, bn, 2, "DDL statement limit") {
            return count;
        }
        if word(inout q, 19) {
            expect_word(inout q, 21, "table");
            let name = ident(inout q);
            expect_sym(inout q, 40);
            if q.err != 0 {
                return count;
            }
            q.words.push(0);
            q.words.push(name.off);
            q.words.push(name.len);
            let at = q.words.len();
            q.words.push(0);
            let mut ncols: u64 = 0;
            loop {
                let col = ident(inout q);
                if q.err != 0 {
                    return count;
                }
                // Duplicate column names.
                for k in 0..ncols {
                    let p = wrapping_add(wrapping_add(at, 1), wrapping_mul(k, 4));
                    if same(in q.pool, cw(in q.words, p), cw(in q.words, wrapping_add(p, 1)), col.off, col.len) {
                        fail_name(inout q, 3, "column ", col.off, col.len);
                        return count;
                    }
                }
                let ty = scalar_type(inout q);
                if q.err != 0 {
                    return count;
                }
                let nullable = if word(inout q, 14) {
                    expect_word(inout q, 16, "null");
                    false
                } else {
                    word(inout q, 16);
                    true
                };
                if q.err != 0 {
                    return count;
                }
                let bn = wrapping_add(ncols, 1);
                if !bound(inout q, bn, 5, "column limit") {
                    return count;
                }
                q.words.push(col.off);
                q.words.push(col.len);
                q.words.push(ty);
                q.words.push(if nullable {
                    1
                } else {
                    0
                });
                ncols = wrapping_add(ncols, 1);
                if !sym(inout q, 44) {
                    break;
                }
            }
            q.words.try_set(at, ncols);
            expect_sym(inout q, 41);
        } else if word(inout q, 20) {
            expect_word(inout q, 21, "table");
            let name = ident(inout q);
            if q.err != 0 {
                return count;
            }
            q.words.push(1);
            q.words.push(name.off);
            q.words.push(name.len);
        } else {
            syntax(inout q, "only CREATE TABLE and DROP TABLE are supported");
            return count;
        }
        count = wrapping_add(count, 1);
        if !sym(inout q, 59) && q.err == 0 && !at_end(in q) {
            syntax(inout q, "expected statement separator");
        }
    }
    count
}

// `HermeticCatalog::apply_ddl_changes`. meta is the catalog encoding; text
// its names. On success, words holds [nchanges, changes...] in the parse
// encoding, with pool ranges; the new revision is revision + nchanges.
pub fn ddl_apply(in meta: Slice[u64], in text: Slice[u8], revision: u64, in sql: Slice[u8], in limits: Slice[u64]) -> Q {
    let mut q = new_q();
    q.pool.extend(in text);
    if !load_limits(inout q, limits) {
        return q;
    }
    load_catalog(inout q, meta, 0);
    lex(inout q, sql);
    if q.err != 0 {
        return q;
    }
    q.words.push(0);
    let count = parse_ddl(inout q);
    if q.err != 0 {
        return q;
    }
    q.words.try_set(0, count);
    // Replay against the live table set: tabs entries with nlen = none are
    // dropped.
    let mut live = q.tabs.len();
    let mut rev = revision;
    let mut p: u64 = 1;
    for s in 0..count {
        let kind = cw(in q.words, p);
        let noff = cw(in q.words, wrapping_add(p, 1));
        let nlen = cw(in q.words, wrapping_add(p, 2));
        let found = find_table(in q, noff, nlen);
        if kind == 0 {
            if found != none() {
                fail_name(inout q, 3, "table ", noff, nlen);
                return q;
            }
            let bn = wrapping_add(live, 1);
            if !bound(inout q, bn, 4, "catalog table limit") {
                return q;
            }
            q.tabs.push(CTab {
                noff: noff,
                nlen: nlen,
                start: 0,
                n: 0
            });
            live = wrapping_add(live, 1);
            p = wrapping_add(wrapping_add(p, 4), wrapping_mul(cw(in q.words, wrapping_add(p, 3)), 4));
        } else {
            if found == none() {
                fail_name(inout q, 2, "table ", noff, nlen);
                return q;
            }
            let mut t = ctab(in q, found);
            t.nlen = none();
            q.tabs.try_set(found, t);
            live = wrapping_sub(live, 1);
            p = wrapping_add(p, 3);
        }
        if rev == none() {
            fail(inout q, 9, "catalog revision overflow");
            return q;
        }
        rev = wrapping_add(rev, 1);
    }
    q
}

// ---------------------------------------------------------------------
// Checker (src/plan.rs `Checker` and `prepare`). Typed expressions are
// written to `ex` in prefix order as [tag, type word, nullable, payload..]:
//   Column 0: slot, binding
//   Param 1: name off, name len
//   Literal 2: value tag, a, b
//   Compare 3: Cmp, lhs, rhs
//   And 4, Or 5: lhs, rhs
//   Not 6: operand
//   IsNull 7: negated, operand

fn ex_set(inout q: Q, i: u64, v: u64) {
    q.ex.try_set(i, v);
}

fn ex_ty(in q: Q, p: u64) -> u64 {
    ex(in q, wrapping_add(p, 1))
}

fn ex_nullable(in q: Q, p: u64) -> bool {
    ex(in q, wrapping_add(p, 2)) != 0
}

// The end of the expression at p.
fn ex_end(in q: Q, p: u64) -> u64 {
    let tag = ex(in q, p);
    if tag == 0 || tag == 1 {
        wrapping_add(p, 5)
    } else if tag == 2 {
        wrapping_add(p, 6)
    } else if tag == 3 {
        ex_end(in q, ex_end(in q, wrapping_add(p, 4)))
    } else if tag == 4 || tag == 5 {
        ex_end(in q, ex_end(in q, wrapping_add(p, 3)))
    } else if tag == 6 {
        ex_end(in q, wrapping_add(p, 3))
    } else {
        ex_end(in q, wrapping_add(p, 4))
    }
}

fn header(inout q: Q, tag: u64) -> u64 {
    let p = q.ex.len();
    q.ex.push(tag);
    q.ex.push(0);
    q.ex.push(0);
    p
}

fn bool_word(b: bool) -> u64 {
    if b {
        1
    } else {
        0
    }
}

// `Checker::column`: the bound column for an optional qualifier and a name.
fn find_column(inout q: Q, qoff: u64, qlen: u64, noff: u64, nlen: u64) -> u64 {
    let mut found = none();
    for i in 0..q.bcols.len() {
        let c = bcol(in q, i);
        if same(in q.pool, c.coff, c.clen, noff, nlen) && (qoff == none() || same(in q.pool, qoff, qlen, c.aoff, c.alen)) {
            if found != none() {
                fail_name(inout q, 4, "column ", noff, nlen);
                return none();
            }
            found = i;
        }
    }
    if found == none() && q.err == 0 {
        q.err = 2;
        put(inout q.msg, "column ");
        if qoff != none() {
            put_range(inout q.msg, in q.pool, qoff, qlen);
            q.msg.push(46);
        }
        put_range(inout q.msg, in q.pool, noff, nlen);
    }
    found
}

fn emit_column(inout q: Q, c: BCol) -> u64 {
    let p = header(inout q, 0);
    q.ex.push(c.slot);
    q.ex.push(c.binding);
    ex_set(inout q, wrapping_add(p, 1), wrapping_add(c.ty, 1));
    ex_set(inout q, wrapping_add(p, 2), bool_word(c.nullable));
    p
}

// `Checker::expr`: check raw node r with an optional expected type word
// (0 = none) and return its position in `ex`.
fn check_expr(inout q: Q, r: u64, expected: u64) -> u64 {
    if q.err != 0 {
        return 0;
    }
    let e = raw(in q, r);
    let mut p: u64 = 0;
    if e.kind == 0 {
        let i = find_column(inout q, e.a, e.b, e.c, e.d);
        if q.err != 0 {
            return 0;
        }
        let c = bcol(in q, i);
        p = emit_column(inout q, c);
    } else if e.kind == 1 {
        let mut found = none();
        for i in 0..q.params.len() {
            let d = param(in q, i);
            if same(in q.pool, d.noff, d.nlen, e.a, e.b) {
                found = i;
            }
        }
        if found == none() {
            fail_name(inout q, 2, "parameter :", e.a, e.b);
            return 0;
        }
        let mut d = param(in q, found);
        d.used = true;
        q.params.try_set(found, d);
        p = header(inout q, 1);
        q.ex.push(e.a);
        q.ex.push(e.b);
        ex_set(inout q, wrapping_add(p, 1), wrapping_add(d.ty, 1));
        ex_set(inout q, wrapping_add(p, 2), bool_word(d.nullable));
    } else if e.kind == 2 {
        p = header(inout q, 2);
        q.ex.push(e.a);
        q.ex.push(e.b);
        q.ex.push(e.c);
        // The value tag is the type word (0 for NULL).
        ex_set(inout q, wrapping_add(p, 1), e.a);
        ex_set(inout q, wrapping_add(p, 2), bool_word(e.a == 0));
    } else if e.kind == 3 {
        p = header(inout q, 3);
        q.ex.push(e.a);
        let a = check_expr(inout q, e.b, 0);
        let b = check_expr(inout q, e.c, 0);
        if q.err != 0 {
            return 0;
        }
        let at = ex_ty(in q, a);
        let bt = ex_ty(in q, b);
        let ty = if at != 0 {
            at
        } else if bt != 0 {
            bt
        } else {
            4
        };
        if (at != 0 && at != ty) || (bt != 0 && bt != ty) {
            fail(inout q, 5, "comparison operands must have identical types");
            return 0;
        }
        ex_set(inout q, wrapping_add(a, 1), ty);
        ex_set(inout q, wrapping_add(b, 1), ty);
        ex_set(inout q, wrapping_add(p, 1), 4);
        let nb = bool_word(ex_nullable(in q, a) || ex_nullable(in q, b));
        ex_set(inout q, wrapping_add(p, 2), nb);
    } else if e.kind == 4 || e.kind == 5 {
        if expected != 0 && expected != 4 {
            fail(inout q, 5, "boolean type mismatch");
            return 0;
        }
        p = header(inout q, e.kind);
        let a = check_expr(inout q, e.b, 4);
        let b = check_expr(inout q, e.c, 4);
        if q.err != 0 {
            return 0;
        }
        ex_set(inout q, wrapping_add(p, 1), 4);
        let nb = bool_word(ex_nullable(in q, a) || ex_nullable(in q, b));
        ex_set(inout q, wrapping_add(p, 2), nb);
        return p;
    } else if e.kind == 6 {
        p = header(inout q, 6);
        let x = check_expr(inout q, e.b, 4);
        if q.err != 0 {
            return 0;
        }
        ex_set(inout q, wrapping_add(p, 1), 4);
        let nb = bool_word(ex_nullable(in q, x));
        ex_set(inout q, wrapping_add(p, 2), nb);
    } else {
        p = header(inout q, 7);
        q.ex.push(e.a);
        check_expr(inout q, e.b, 0);
        if q.err != 0 {
            return 0;
        }
        ex_set(inout q, wrapping_add(p, 1), 4);
        ex_set(inout q, wrapping_add(p, 2), 0);
    }
    if expected != 0 {
        let actual = ex_ty(in q, p);
        if actual != 0 && actual != expected {
            fail(inout q, 5, "expected boolean expression");
            return 0;
        }
        ex_set(inout q, wrapping_add(p, 1), expected);
    }
    p
}

// `Checker::table`: bind a FROM/JOIN table and return its Scan node.
fn check_table(inout q: Q, b: Bind) -> u64 {
    for i in 0..q.aliases.len() {
        let a = match q.aliases.try_get(i) {
            Option::Some(a) => a,
            Option::None => Rng {
                off: 0,
                len: 0
            },
        };
        if same(in q.pool, a.off, a.len, b.aoff, b.alen) {
            fail_name(inout q, 3, "table alias ", b.aoff, b.alen);
            return 0;
        }
    }
    q.aliases.push(Rng {
        off: b.aoff,
        len: b.alen
    });
    let t = find_table(in q, b.noff, b.nlen);
    if t == none() {
        fail_name(inout q, 2, "table ", b.noff, b.nlen);
        return 0;
    }
    let tab = ctab(in q, t);
    let binding = q.nbindings;
    q.nbindings = wrapping_add(binding, 1);
    let slots_at = q.ex.len();
    for k in 0..tab.n {
        let c = ccol(in q, wrapping_add(tab.start, k));
        let slot = q.bcols.len();
        q.ex.push(slot);
        q.bcols.push(BCol {
            aoff: b.aoff,
            alen: b.alen,
            coff: c.noff,
            clen: c.nlen,
            binding: binding,
            slot: slot,
            ty: c.ty,
            nullable: c.nullable
        });
    }
    q.plan.push(Node {
        kind: 0,
        a: b.noff,
        b: b.nlen,
        c: binding,
        d: slots_at,
        e: tab.n,
        f: none(),
        g: none()
    });
    wrapping_sub(q.plan.len(), 1)
}

fn set_nullable(inout q: Q, from: u64, to: u64) {
    for i in from..to {
        let mut c = bcol(in q, i);
        c.nullable = true;
        q.bcols.try_set(i, c);
    }
}

// Params input: [nparams, (off, len, ty, nullable)*]. Normalizes names,
// rejects duplicates and keeps them sorted by name (the BTreeMap order).
fn load_params(inout q: Q, in meta: Slice[u64], at: u64) {
    let n = sw(in meta, at);
    let bn = n;
    if !bound(inout q, bn, 2, "parameter count limit") {
        return;
    }
    let mut p = wrapping_add(at, 1);
    for k in 0..n {
        let off = identifier(inout q, sw(in meta, p), sw(in meta, wrapping_add(p, 1)));
        if q.err != 0 {
            return;
        }
        let len = sw(in meta, wrapping_add(p, 1));
        let d = CCol {
            noff: off,
            nlen: len,
            ty: sw(in meta, wrapping_add(p, 2)),
            nullable: sw(in meta, wrapping_add(p, 3)) != 0,
            used: false
        };
        p = wrapping_add(p, 4);
        // Insertion into the sorted list.
        let mut at_i = q.params.len();
        for i in 0..q.params.len() {
            let e = param(in q, i);
            let o = order(in q.pool, off, len, e.noff, e.nlen);
            if o == 1 {
                fail_name(inout q, 3, "parameter ", off, len);
                return;
            }
            if o == 0 && at_i == q.params.len() {
                at_i = i;
            }
        }
        q.params.push(d);
        let mut j = wrapping_sub(q.params.len(), 1);
        loop {
            if j <= at_i {
                break;
            }
            let prev = param(in q, wrapping_sub(j, 1));
            q.params.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        q.params.try_set(at_i, d);
    }
}

// ---------------------------------------------------------------------
// Plan streams. A plan is written in prefix order as
//   Scan:   [0, table off, table len, binding, nslots, slots..,
//            npredicates, predicates..]
//   Filter: [1, predicate, input]
//   Join:   [2, JoinKind, lhs, rhs, condition]

fn copy_expr(inout q: Q, p: u64) {
    let end = ex_end(in q, p);
    for i in p..end {
        let w = ex(in q, i);
        q.words.push(w);
    }
}

fn emit_plan(inout q: Q, n: u64) {
    let x = node(in q, n);
    if x.kind == 0 {
        q.words.push(0);
        q.words.push(x.a);
        q.words.push(x.b);
        q.words.push(x.c);
        q.words.push(x.e);
        for k in 0..x.e {
            let w = ex(in q, wrapping_add(x.d, k));
            q.words.push(w);
        }
        let at = q.words.len();
        q.words.push(0);
        let mut count: u64 = 0;
        let mut l = x.f;
        loop {
            if l == none() {
                break;
            }
            let k = link(in q, l);
            copy_expr(inout q, k.expr);
            count = wrapping_add(count, 1);
            l = k.next;
        }
        q.words.try_set(at, count);
    } else if x.kind == 1 {
        q.words.push(1);
        copy_expr(inout q, x.a);
        emit_plan(inout q, x.b);
    } else {
        q.words.push(2);
        q.words.push(x.a);
        emit_plan(inout q, x.b);
        emit_plan(inout q, x.c);
        copy_expr(inout q, x.d);
    }
}

// Decode a plan stream already copied into `ex` at p into plan nodes;
// returns (node, end).
fn decode_plan(inout q: Q, p: u64) -> (u64, u64) {
    let kind = ex(in q, p);
    if kind == 0 {
        let nslots = ex(in q, wrapping_add(p, 4));
        let slots_at = wrapping_add(p, 5);
        let preds_at = wrapping_add(slots_at, nslots);
        let npreds = ex(in q, preds_at);
        let mut first = none();
        let mut last = none();
        let mut e = wrapping_add(preds_at, 1);
        for k in 0..npreds {
            q.links.push(Link {
                expr: e,
                next: none()
            });
            let l = wrapping_sub(q.links.len(), 1);
            if last == none() {
                first = l;
            } else {
                let mut prev = link(in q, last);
                prev.next = l;
                q.links.try_set(last, prev);
            }
            last = l;
            e = ex_end(in q, e);
        }
        let ta = ex(in q, wrapping_add(p, 1));
        let tb = ex(in q, wrapping_add(p, 2));
        let tc = ex(in q, wrapping_add(p, 3));
        q.plan.push(Node {
            kind: 0,
            a: ta,
            b: tb,
            c: tc,
            d: slots_at,
            e: nslots,
            f: first,
            g: last
        });
        (wrapping_sub(q.plan.len(), 1), e)
    } else if kind == 1 {
        let pred = wrapping_add(p, 1);
        let at = ex_end(in q, pred);
        let (input, end) = decode_plan(inout q, at);
        q.plan.push(Node {
            kind: 1,
            a: pred,
            b: input,
            c: 0,
            d: 0,
            e: 0,
            f: none(),
            g: none()
        });
        (wrapping_sub(q.plan.len(), 1), end)
    } else {
        let (lhs, l_end) = decode_plan(inout q, wrapping_add(p, 2));
        let (rhs, r_end) = decode_plan(inout q, l_end);
        let jk = ex(in q, wrapping_add(p, 1));
        q.plan.push(Node {
            kind: 2,
            a: jk,
            b: lhs,
            c: rhs,
            d: r_end,
            e: 0,
            f: none(),
            g: none()
        });
        (wrapping_sub(q.plan.len(), 1), ex_end(in q, r_end))
    }
}

// Whether the plan below n has a scan of binding b.
fn has_binding(in q: Q, n: u64, b: u64) -> bool {
    let x = node(in q, n);
    if x.kind == 0 {
        x.c == b
    } else if x.kind == 1 {
        has_binding(in q, x.b, b)
    } else {
        has_binding(in q, x.b, b) || has_binding(in q, x.c, b)
    }
}

// Whether every column binding of the expression at p is scanned below n.
fn deps_within(in q: Q, p: u64, n: u64) -> bool {
    let tag = ex(in q, p);
    if tag == 0 {
        has_binding(in q, n, ex(in q, wrapping_add(p, 4)))
    } else if tag == 1 || tag == 2 {
        true
    } else if tag == 3 {
        let a = wrapping_add(p, 4);
        deps_within(in q, a, n) && deps_within(in q, ex_end(in q, a), n)
    } else if tag == 4 || tag == 5 {
        let a = wrapping_add(p, 3);
        deps_within(in q, a, n) && deps_within(in q, ex_end(in q, a), n)
    } else if tag == 6 {
        deps_within(in q, wrapping_add(p, 3), n)
    } else {
        deps_within(in q, wrapping_add(p, 4), n)
    }
}

fn new_filter(inout q: Q, pred: u64, input: u64) -> u64 {
    q.plan.push(Node {
        kind: 1,
        a: pred,
        b: input,
        c: 0,
        d: 0,
        e: 0,
        f: none(),
        g: none()
    });
    wrapping_sub(q.plan.len(), 1)
}

// `place`: push the predicate at p as far down the plan n as is valid.
fn place(inout q: Q, p: u64, n: u64) -> u64 {
    if ex(in q, p) == 4 {
        let a = wrapping_add(p, 3);
        let b = ex_end(in q, a);
        let inner = place(inout q, a, n);
        return place(inout q, b, inner);
    }
    let mut x = node(in q, n);
    if x.kind == 0 {
        q.links.push(Link {
            expr: p,
            next: none()
        });
        let l = wrapping_sub(q.links.len(), 1);
        if x.g == none() {
            x.f = l;
        } else {
            let mut prev = link(in q, x.g);
            prev.next = l;
            q.links.try_set(x.g, prev);
        }
        x.g = l;
        q.plan.try_set(n, x);
        n
    } else if x.kind == 2 {
        // A WHERE predicate can cross only a preserved side of an outer
        // join. Even IS NULL on the nullable side must remain above it.
        if (x.a == 0 || x.a == 1) && deps_within(in q, p, x.b) {
            x.b = place(inout q, p, x.b);
            q.plan.try_set(n, x);
            n
        } else if (x.a == 0 || x.a == 2) && deps_within(in q, p, x.c) {
            x.c = place(inout q, p, x.c);
            q.plan.try_set(n, x);
            n
        } else {
            new_filter(inout q, p, n)
        }
    } else {
        x.b = place(inout q, p, x.b);
        q.plan.try_set(n, x);
        n
    }
}

// `RelPlan::optimize`.
fn optimize_node(inout q: Q, n: u64) -> u64 {
    let mut x = node(in q, n);
    if x.kind == 1 {
        let input = optimize_node(inout q, x.b);
        // Conjunction splitting is valid under SQL three-valued WHERE
        // semantics.
        place(inout q, x.a, input)
    } else if x.kind == 2 {
        x.b = optimize_node(inout q, x.b);
        x.c = optimize_node(inout q, x.c);
        q.plan.try_set(n, x);
        n
    } else {
        n
    }
}

// `PreparedQuery::optimized` on a plan stream. Text ranges pass through.
pub fn optimize(in plan: Slice[u64]) -> Q {
    let mut q = new_q();
    q.ex.extend(in plan);
    let (root, end) = decode_plan(inout q, 0);
    let top = optimize_node(inout q, root);
    emit_plan(inout q, top);
    q
}

// `HermeticCatalog::prepare`. meta holds the catalog encoding followed by
// the parameter encoding; text their names. On success words holds
//   plan, ncols, (alias off, alias len, column off, column len, binding,
//   slot, ty, nullable)*, nproj, projection expressions..,
//   nout, (name off, name len, ty, nullable)*, nparams,
//   (name off, name len, ty, nullable)*
// with ranges into pool.
pub fn prepare(in meta: Slice[u64], in text: Slice[u8], in sql: Slice[u8], in limits: Slice[u64]) -> Q {
    let mut q = new_q();
    q.pool.extend(in text);
    if !load_limits(inout q, limits) {
        return q;
    }
    let after = load_catalog(inout q, meta, 0);
    let bn = q.tabs.len();
    if !bound(inout q, bn, 4, "catalog table limit") {
        return q;
    }
    for t in 0..q.tabs.len() {
        let bn = ctab(in q, t).n;
        if !bound(inout q, bn, 5, "catalog column limit") {
            return q;
        }
    }
    lex(inout q, sql);
    parse_select(inout q);
    load_params(inout q, meta, after);
    if q.err != 0 {
        return q;
    }
    // FROM and joins.
    let from = match q.binds.try_get(0) {
        Option::Some(b) => b,
        Option::None => Bind {
            kind: 0,
            noff: 0,
            nlen: 0,
            aoff: 0,
            alen: 0,
            on: 0
        },
    };
    let mut plan = check_table(inout q, from);
    for j in 1..q.binds.len() {
        if q.err != 0 {
            return q;
        }
        let b = match q.binds.try_get(j) {
            Option::Some(b) => b,
            Option::None => from,
        };
        let left_end = q.bcols.len();
        let rhs = check_table(inout q, b);
        let on = check_expr(inout q, b.on, 4);
        if q.err != 0 {
            return q;
        }
        let right_end = q.bcols.len();
        if b.kind == 2 || b.kind == 3 {
            set_nullable(inout q, 0, left_end);
        }
        if b.kind == 1 || b.kind == 3 {
            set_nullable(inout q, left_end, right_end);
        }
        q.plan.push(Node {
            kind: 2,
            a: b.kind,
            b: plan,
            c: rhs,
            d: on,
            e: 0,
            f: none(),
            g: none()
        });
        plan = wrapping_sub(q.plan.len(), 1);
    }
    if q.err != 0 {
        return q;
    }
    if q.filter != none() {
        let f = q.filter;
        let pred = check_expr(inout q, f, 4);
        if q.err != 0 {
            return q;
        }
        plan = new_filter(inout q, pred, plan);
    }
    // Projection: expressions in `ex`, output names as ranges in `rows`
    // (scratch), as (off, len) pairs.
    let mut proj: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for s in 0..q.sels.len() {
        let sel = match q.sels.try_get(s) {
            Option::Some(x) => x,
            Option::None => Sel {
                expr: 0,
                aoff: 0,
                alen: 0
            },
        };
        let mut count: u64 = 1;
        if sel.expr == none() {
            count = q.bcols.len();
        } else if sel.aoff == none() {
            let r = raw(in q, sel.expr);
            if r.kind != 0 {
                fail(inout q, 1, "non-column projection requires AS name");
                return q;
            }
        }
        for k in 0..count {
            let mut noff: u64 = 0;
            let mut nlen: u64 = 0;
            if sel.expr == none() {
                let c = bcol(in q, k);
                noff = c.coff;
                nlen = c.clen;
            } else if sel.aoff == none() {
                let r = raw(in q, sel.expr);
                noff = r.c;
                nlen = r.d;
            } else {
                noff = sel.aoff;
                nlen = sel.alen;
            }
            let bn = wrapping_add(proj.len(), 1);
            if !bound(inout q, bn, 2, "expanded projection limit") {
                return q;
            }
            let mut i: u64 = 0;
            loop {
                if wrapping_add(i, 1) >= q.rows.len() {
                    break;
                }
                if same(in q.pool, cw(in q.rows, i), cw(in q.rows, wrapping_add(i, 1)), noff, nlen) {
                    if q.err == 0 {
                        q.err = 3;
                        put(inout q.msg, "output name ");
                        put_range(inout q.msg, in q.pool, noff, nlen);
                        put(inout q.msg, "; use AS");
                    }
                    return q;
                }
                i = wrapping_add(i, 2);
            }
            q.rows.push(noff);
            q.rows.push(nlen);
            let p = if sel.expr == none() {
                let c = bcol(in q, k);
                emit_column(inout q, c)
            } else {
                check_expr(inout q, sel.expr, 0)
            };
            if q.err != 0 {
                return q;
            }
            if ex_ty(in q, p) == 0 {
                fail(inout q, 5, "NULL projection has no inferable type");
                return q;
            }
            proj.push(p);
        }
    }
    let mut used: u64 = 0;
    for i in 0..q.params.len() {
        if param(in q, i).used {
            used = wrapping_add(used, 1);
        }
    }
    if used != q.params.len() {
        fail(inout q, 2, "unused parameter declaration");
        return q;
    }
    // Output.
    emit_plan(inout q, plan);
    q.words.push(q.bcols.len());
    for i in 0..q.bcols.len() {
        let c = bcol(in q, i);
        q.words.push(c.aoff);
        q.words.push(c.alen);
        q.words.push(c.coff);
        q.words.push(c.clen);
        q.words.push(c.binding);
        q.words.push(c.slot);
        q.words.push(c.ty);
        q.words.push(bool_word(c.nullable));
    }
    q.words.push(proj.len());
    for i in 0..proj.len() {
        copy_expr(inout q, cw(in proj, i));
    }
    q.words.push(proj.len());
    for i in 0..proj.len() {
        let p = cw(in proj, i);
        q.words.push(cw(in q.rows, wrapping_mul(i, 2)));
        q.words.push(cw(in q.rows, wrapping_add(wrapping_mul(i, 2), 1)));
        let w = wrapping_sub(ex_ty(in q, p), 1);
        q.words.push(w);
        let w2 = ex(in q, wrapping_add(p, 2));
        q.words.push(w2);
    }
    q.words.push(q.params.len());
    for i in 0..q.params.len() {
        let d = param(in q, i);
        q.words.push(d.noff);
        q.words.push(d.nlen);
        q.words.push(d.ty);
        q.words.push(bool_word(d.nullable));
    }
    q
}

// ---------------------------------------------------------------------
// Values and the row executor (src/execute.rs).

fn val_at(in q: Q, in s: ChunkSeq[u64], p: u64) -> Val {
    Val {
        t: cw(in s, p),
        a: cw(in s, wrapping_add(p, 1)),
        b: cw(in s, wrapping_add(p, 2))
    }
}

// `Value::bytes`: the payload length of text and bytes, 8 otherwise.
fn vbytes(v: Val) -> u64 {
    if v.t == 5 || v.t == 6 {
        v.b
    } else {
        8
    }
}

// The heap bytes `row_bytes` adds besides `size_of::<Value>()`.
fn vheap(v: Val) -> u64 {
    if v.t == 5 || v.t == 6 {
        v.b
    } else {
        0
    }
}

fn finite(bits: u64) -> bool {
    ((bits >> 52) & 2047) != 2047
}

// `Value::valid` for a column or parameter type and nullability.
fn valid(v: Val, ty: u64, nullable: bool) -> bool {
    if v.t == 0 {
        nullable
    } else if v.t == 3 && !finite(v.a) {
        false
    } else {
        v.t == wrapping_add(ty, 1)
    }
}

fn size_value(in q: Q) -> u64 {
    lim(in q, 14)
}

fn size_vec(in q: Q) -> u64 {
    lim(in q, 15)
}

// A total order key for a finite f64 (-0.0 equals 0.0).
fn f64_key(bits: u64) -> u64 {
    let b = if bits == 9223372036854775808 {
        0
    } else {
        bits
    };
    if (b >> 63) == 1 {
        ~b
    } else {
        b | 9223372036854775808
    }
}

// Order of two non-null values of one tag: 0 less, 1 equal, 2 greater;
// 3 when the tags differ.
fn compare_vals(in q: Q, x: Val, y: Val) -> u64 {
    if x.t != y.t {
        return 3;
    }
    let (a, b) = if x.t == 2 {
        // Signed: flip the sign bit so unsigned order is signed order.
        (x.a ^ 9223372036854775808, y.a ^ 9223372036854775808)
    } else if x.t == 3 {
        (f64_key(x.a), f64_key(y.a))
    } else {
        (x.a, y.a)
    };
    if x.t == 5 || x.t == 6 {
        return order(in q.pool, x.a, x.b, y.a, y.b);
    }
    if a < b {
        0
    } else if a > b {
        2
    } else {
        1
    }
}

fn tick(inout q: Q, n: u64) {
    q.work = wrapping_add(q.work, n);
    let w = q.work;
    bound(inout q, w, 9, "execution work limit");
}

fn row_val(in q: Q, row: u64, slot: u64) -> Val {
    val_at(in q, in q.rows, wrapping_add(row, wrapping_mul(slot, 3)))
}

fn width(in q: Q) -> u64 {
    ex(in q, 16)
}

// `Budget::row`.
fn charge_row(inout q: Q, row: u64) {
    let w = width(in q);
    let mut heap: u64 = size_vec(in q);
    let mut payload: u64 = w;
    for k in 0..w {
        let v = row_val(in q, row, k);
        heap = wrapping_add(wrapping_add(heap, size_value(in q)), vheap(v));
        payload = wrapping_add(payload, vbytes(v));
    }
    q.brows = wrapping_add(q.brows, 1);
    q.bbytes = wrapping_add(q.bbytes, heap);
    let r = q.brows;
    let b = q.bbytes;
    if !bound(inout q, r, 10, "cumulative intermediate row limit") {
        return;
    }
    if !bound(inout q, b, 11, "cumulative intermediate byte limit") {
        return;
    }
    tick(inout q, payload);
}

// The parameter value bound to a name.
fn bind_val(in q: Q, off: u64, len: u64) -> Val {
    for i in 0..q.params.len() {
        let d = param(in q, i);
        if same(in q.pool, d.noff, d.nlen, off, len) {
            return vat(in q, d.ty);
        }
    }
    null_val()
}

// `truth`: 0 unknown (NULL), 1 false, 2 true; a Type error otherwise.
fn truth(inout q: Q, v: Val) -> u64 {
    if v.t == 0 {
        0
    } else if v.t == 4 {
        if v.a != 0 {
            2
        } else {
            1
        }
    } else {
        fail(inout q, 5, "non-boolean checked predicate");
        0
    }
}

fn three(t: u64) -> Val {
    if t == 0 {
        null_val()
    } else {
        bool_val(t == 2)
    }
}

// `eval` of the expression at p over the row starting at `row`.
fn eval(inout q: Q, p: u64, row: u64) -> Val {
    tick(inout q, 1);
    if q.err != 0 {
        return null_val();
    }
    let tag = ex(in q, p);
    if tag == 0 {
        let v = row_val(in q, row, ex(in q, wrapping_add(p, 3)));
        tick(inout q, vbytes(v));
        v
    } else if tag == 1 {
        let v = bind_val(in q, ex(in q, wrapping_add(p, 3)), ex(in q, wrapping_add(p, 4)));
        tick(inout q, vbytes(v));
        v
    } else if tag == 2 {
        let v = val_at(in q, in q.ex, wrapping_add(p, 3));
        tick(inout q, vbytes(v));
        v
    } else if tag == 3 {
        let op = ex(in q, wrapping_add(p, 3));
        let ap = wrapping_add(p, 4);
        let bp = ex_end(in q, ap);
        let a = eval(inout q, ap, row);
        let b = eval(inout q, bp, row);
        if q.err != 0 {
            return null_val();
        }
        if a.t == 0 || b.t == 0 {
            return null_val();
        }
        let o = compare_vals(in q, a, b);
        if o == 3 {
            fail(inout q, 5, "comparison mismatch");
            return null_val();
        }
        bool_val(if op == 0 {
            o == 1
        } else if op == 1 {
            o != 1
        } else if op == 2 {
            o == 0
        } else if op == 3 {
            o != 2
        } else if op == 4 {
            o == 2
        } else {
            o != 0
        })
    } else if tag == 4 || tag == 5 {
        let ap = wrapping_add(p, 3);
        let bp = ex_end(in q, ap);
        let av = eval(inout q, ap, row);
        let a = truth(inout q, av);
        let bv = eval(inout q, bp, row);
        let b = truth(inout q, bv);
        if q.err != 0 {
            return null_val();
        }
        if tag == 4 {
            if a == 1 || b == 1 {
                bool_val(false)
            } else if a == 2 && b == 2 {
                bool_val(true)
            } else {
                null_val()
            }
        } else if a == 2 || b == 2 {
            bool_val(true)
        } else if a == 1 && b == 1 {
            bool_val(false)
        } else {
            null_val()
        }
    } else if tag == 6 {
        let xv = eval(inout q, wrapping_add(p, 3), row);
        let x = truth(inout q, xv);
        if x == 0 {
            null_val()
        } else {
            bool_val(x == 1)
        }
    } else {
        let negated = ex(in q, wrapping_add(p, 3)) != 0;
        let v = eval(inout q, wrapping_add(p, 4), row);
        bool_val((v.t == 0) != negated)
    }
}

// Whether a predicate holds (`truth(eval(..)) == Some(true)`).
fn holds(inout q: Q, p: u64, row: u64) -> bool {
    let v = eval(inout q, p, row);
    let t = truth(inout q, v);
    q.err == 0 && t == 2
}

fn dtab(in q: Q, i: u64) -> CTab {
    match q.dtabs.try_get(i) {
        Option::Some(t) => t,
        Option::None => CTab {
            noff: 0,
            nlen: 0,
            start: 0,
            n: 0
        },
    }
}

fn find_data(in q: Q, off: u64, len: u64) -> u64 {
    for i in 0..q.dtabs.len() {
        let t = dtab(in q, i);
        if same(in q.pool, t.noff, t.nlen, off, len) {
            return i;
        }
    }
    none()
}

// The scan slots of the plan below n, in order (`RelPlan::slots`).
fn slots_of(in q: Q, n: u64, inout out: ChunkSeq[u64]) {
    let x = node(in q, n);
    if x.kind == 0 {
        for k in 0..x.e {
            out.push(ex(in q, wrapping_add(x.d, k)));
        }
    } else if x.kind == 1 {
        slots_of(in q, x.b, inout out);
    } else {
        slots_of(in q, x.b, inout out);
        slots_of(in q, x.c, inout out);
    }
}

// A new all-NULL row at the end of `rows`.
fn new_row(inout q: Q) -> u64 {
    let start = q.rows.len();
    let w = width(in q);
    for k in 0..w {
        q.rows.push(0);
        q.rows.push(0);
        q.rows.push(0);
    }
    start
}

fn set_val(inout q: Q, row: u64, slot: u64, v: Val) {
    let at = wrapping_add(row, wrapping_mul(slot, 3));
    q.rows.try_set(at, v.t);
    q.rows.try_set(wrapping_add(at, 1), v.a);
    q.rows.try_set(wrapping_add(at, 2), v.b);
}

// `run`: the rows of plan n, as a range of `rowset`.
fn run(inout q: Q, n: u64) -> (u64, u64) {
    let x = node(in q, n);
    if q.err != 0 {
        return (0, 0);
    }
    if x.kind == 0 {
        let first = q.rowset.len();
        let t = dtab(in q, find_data(in q, x.a, x.b));
        let mut p = t.start;
        for r in 0..t.n {
            if q.err != 0 {
                break;
            }
            let nvals = ex(in q, p);
            let row = new_row(inout q);
            let m = if nvals < x.e {
                nvals
            } else {
                x.e
            };
            for k in 0..m {
                let v = val_at(in q, in q.ex, wrapping_add(wrapping_add(p, 1), wrapping_mul(k, 3)));
                let slot = ex(in q, wrapping_add(x.d, k));
                set_val(inout q, row, slot, v);
            }
            p = wrapping_add(wrapping_add(p, 1), wrapping_mul(nvals, 3));
            // Charge rejected rows too: scanning and expression evaluation
            // remain bounded.
            charge_row(inout q, row);
            let mut keep = true;
            let mut l = x.f;
            loop {
                if l == none() || q.err != 0 {
                    break;
                }
                let k = link(in q, l);
                if !holds(inout q, k.expr, row) {
                    keep = false;
                    break;
                }
                l = k.next;
            }
            if keep && q.err == 0 {
                q.rowset.push(row);
            } else {
                q.rows.truncate(row);
            }
        }
        (first, q.rowset.len())
    } else if x.kind == 1 {
        let (s, e) = run(inout q, x.b);
        let first = q.rowset.len();
        for i in s..e {
            if q.err != 0 {
                break;
            }
            let row = cw(in q.rowset, i);
            if holds(inout q, x.a, row) {
                q.rowset.push(row);
            }
        }
        (first, q.rowset.len())
    } else {
        let (ls, le) = run(inout q, x.b);
        let (rs, re) = run(inout q, x.c);
        let mut slots: ChunkSeq[u64] = ChunkSeq::new[u64]();
        slots_of(in q, x.c, inout slots);
        let mut matched: ChunkSeq[bool] = ChunkSeq::new[bool]();
        for j in rs..re {
            matched.push(false);
        }
        let w = width(in q);
        let first = q.rowset.len();
        for i in ls..le {
            if q.err != 0 {
                break;
            }
            let l = cw(in q.rowset, i);
            let mut matched_left = false;
            for j in rs..re {
                if q.err != 0 {
                    break;
                }
                let r = cw(in q.rowset, j);
                tick(inout q, wrapping_add(1, w));
                let row = new_row(inout q);
                for k in 0..w {
                    let v = row_val(in q, l, k);
                    set_val(inout q, row, k, v);
                }
                for k in 0..slots.len() {
                    let slot = cw(in slots, k);
                    let v = row_val(in q, r, slot);
                    set_val(inout q, row, slot, v);
                }
                charge_row(inout q, row);
                if q.err == 0 && holds(inout q, x.d, row) {
                    matched_left = true;
                    matched.try_set(wrapping_sub(j, rs), true);
                    q.rowset.push(row);
                } else {
                    q.rows.truncate(row);
                }
            }
            if q.err == 0 && !matched_left && (x.a == 1 || x.a == 3) {
                charge_row(inout q, l);
                q.rowset.push(l);
            }
        }
        if x.a == 2 || x.a == 3 {
            for j in rs..re {
                if q.err != 0 {
                    break;
                }
                let m = match matched.try_get(wrapping_sub(j, rs)) {
                    Option::Some(b) => b,
                    Option::None => false,
                };
                if !m {
                    let r = cw(in q.rowset, j);
                    charge_row(inout q, r);
                    q.rowset.push(r);
                }
            }
        }
        (first, q.rowset.len())
    }
}

// `check_inputs`: every scanned table has data, in plan order.
fn check_inputs(inout q: Q, n: u64) {
    let x = node(in q, n);
    if q.err != 0 {
        return;
    }
    if x.kind == 0 {
        if find_data(in q, x.a, x.b) == none() {
            fail_name(inout q, 8, "missing data for ", x.a, x.b);
        }
    } else if x.kind == 1 {
        check_inputs(inout q, x.b);
    } else {
        check_inputs(inout q, x.b);
        check_inputs(inout q, x.c);
    }
}

// Load data tables at p of `ex`: [ndata, (name off, name len, nrows,
// (nvals, values..)*)*]. Returns the end.
fn load_data(inout q: Q, p: u64) -> u64 {
    let n = ex(in q, p);
    let mut at = wrapping_add(p, 1);
    for t in 0..n {
        let noff = ex(in q, at);
        let nlen = ex(in q, wrapping_add(at, 1));
        let nrows = ex(in q, wrapping_add(at, 2));
        at = wrapping_add(at, 3);
        q.dtabs.push(CTab {
            noff: noff,
            nlen: nlen,
            start: at,
            n: nrows
        });
        for r in 0..nrows {
            at = wrapping_add(wrapping_add(at, 1), wrapping_mul(ex(in q, at), 3));
        }
    }
    at
}

// `rows_bytes` of a data table.
fn table_bytes(in q: Q, t: CTab) -> u64 {
    let mut bytes: u64 = 0;
    let mut p = t.start;
    for r in 0..t.n {
        let nvals = ex(in q, p);
        bytes = wrapping_add(bytes, size_vec(in q));
        for k in 0..nvals {
            let v = val_at(in q, in q.ex, wrapping_add(wrapping_add(p, 1), wrapping_mul(k, 3)));
            bytes = wrapping_add(wrapping_add(bytes, size_value(in q)), vheap(v));
        }
        p = wrapping_add(wrapping_add(p, 1), wrapping_mul(nvals, 3));
    }
    bytes
}

// `validate_rows` of data table t against the catalog.
fn validate_rows(inout q: Q, t: CTab) {
    let c = find_table(in q, t.noff, t.nlen);
    if c == none() {
        fail_name(inout q, 2, "data table ", t.noff, t.nlen);
        return;
    }
    let tab = ctab(in q, c);
    let mut p = t.start;
    for r in 0..t.n {
        let nvals = ex(in q, p);
        if nvals != tab.n {
            fail_name(inout q, 8, "row width for ", t.noff, t.nlen);
            return;
        }
        for k in 0..nvals {
            let v = val_at(in q, in q.ex, wrapping_add(wrapping_add(p, 1), wrapping_mul(k, 3)));
            let col = ccol(in q, wrapping_add(tab.start, k));
            if !valid(v, col.ty, col.nullable) {
                if q.err == 0 {
                    q.err = 8;
                    put(inout q.msg, "invalid value for ");
                    put_range(inout q.msg, in q.pool, t.noff, t.nlen);
                    q.msg.push(46);
                    put_range(inout q.msg, in q.pool, col.noff, col.nlen);
                }
                return;
            }
        }
        p = wrapping_add(wrapping_add(p, 1), wrapping_mul(nvals, 3));
    }
}

// Load the catalog encoding stored in `ex` at p (the same layout as the
// `meta` input of `prepare`). Returns the end.
fn load_catalog_ex(inout q: Q, p: u64) -> u64 {
    let mut out: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let n = ex(in q, p);
    let mut at = wrapping_add(p, 1);
    out.push(n);
    for t in 0..n {
        let nc = ex(in q, wrapping_add(at, 2));
        let end = wrapping_add(wrapping_add(at, 3), wrapping_mul(nc, 4));
        for i in at..end {
            out.push(ex(in q, i));
        }
        at = end;
    }
    load_catalog(inout q, in out.as_slice(), 0);
    at
}

// `PreparedQuery::execute` after the Rust snapshot check. prog is
//   limits (16 words), width, plan, nproj, projection expressions..,
//   ndecl, (name off, name len, ty, nullable)*,
//   nbinds, (name off, name len, value)*, catalog, data
// with ranges into text. On success words holds
// [work, nrows, (values of one output row)*].
pub fn execute(in prog: Slice[u64], in text: Slice[u8]) -> Q {
    let mut q = new_q();
    q.pool.extend(in text);
    q.ex.extend(in prog);
    let nlim: u64 = 16;
    for i in 0..nlim {
        q.lim.push(sw(in prog, i));
    }
    let (root, plan_end) = decode_plan(inout q, 17);
    let nproj = ex(in q, plan_end);
    let mut proj: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut p = wrapping_add(plan_end, 1);
    for k in 0..nproj {
        proj.push(p);
        p = ex_end(in q, p);
    }
    let ndecl = ex(in q, p);
    p = wrapping_add(p, 1);
    for k in 0..ndecl {
        let d = CCol {
            noff: ex(in q, p),
            nlen: ex(in q, wrapping_add(p, 1)),
            ty: ex(in q, wrapping_add(p, 2)),
            nullable: ex(in q, wrapping_add(p, 3)) != 0,
            used: false
        };
        q.decls.push(d);
        p = wrapping_add(p, 4);
    }
    let nbinds = ex(in q, p);
    p = wrapping_add(p, 1);
    for k in 0..nbinds {
        let v = val_at(in q, in q.ex, wrapping_add(p, 2));
        let d = CCol {
            noff: ex(in q, p),
            nlen: ex(in q, wrapping_add(p, 1)),
            ty: q.vals.len(),
            nullable: false,
            used: false
        };
        q.vals.push(v);
        q.params.push(d);
        p = wrapping_add(p, 5);
    }
    p = load_catalog_ex(inout q, p);
    load_data(inout q, p);
    if nbinds != ndecl {
        fail(inout q, 8, "parameter set differs from declarations");
        return q;
    }
    let mut parameter_bytes: u64 = 0;
    for k in 0..ndecl {
        let d = match q.decls.try_get(k) {
            Option::Some(d) => d,
            Option::None => empty_col(),
        };
        let mut found = none();
        for i in 0..q.params.len() {
            let b = param(in q, i);
            if same(in q.pool, b.noff, b.nlen, d.noff, d.nlen) {
                found = i;
            }
        }
        if found == none() {
            fail_name(inout q, 8, "missing parameter :", d.noff, d.nlen);
            return q;
        }
        let v = vat(in q, param(in q, found).ty);
        if !valid(v, d.ty, d.nullable) {
            fail_name(inout q, 5, "parameter :", d.noff, d.nlen);
            return q;
        }
        parameter_bytes = wrapping_add(wrapping_add(parameter_bytes, size_value(in q)), vbytes(v));
    }
    if !bound(inout q, parameter_bytes, 8, "parameter byte limit") {
        return q;
    }
    let mut count: u64 = 0;
    let mut bytes = parameter_bytes;
    for i in 0..q.dtabs.len() {
        let t = dtab(in q, i);
        count = wrapping_add(count, t.n);
        bytes = wrapping_add(bytes, table_bytes(in q, t));
        if !bound(inout q, count, 7, "input row limit") {
            return q;
        }
        if !bound(inout q, bytes, 8, "input byte limit") {
            return q;
        }
        validate_rows(inout q, t);
        let mut at = t.start;
        for r in 0..t.n {
            if q.err != 0 {
                return q;
            }
            let nvals = ex(in q, at);
            tick(inout q, wrapping_add(1, nvals));
            at = wrapping_add(wrapping_add(at, 1), wrapping_mul(nvals, 3));
        }
        if q.err != 0 {
            return q;
        }
    }
    // Missing input must fail even if an optimizer could eliminate its rows.
    check_inputs(inout q, root);
    if q.err != 0 {
        return q;
    }
    let (s, e) = run(inout q, root);
    if q.err != 0 {
        return q;
    }
    q.words.push(0);
    q.words.push(0);
    let mut out: u64 = 0;
    let mut output_bytes: u64 = 0;
    for i in s..e {
        let row = cw(in q.rowset, i);
        let bn = wrapping_add(out, 1);
        if !bound(inout q, bn, 12, "output row limit") {
            return q;
        }
        let mut heap = size_vec(in q);
        for k in 0..nproj {
            let v = eval(inout q, cw(in proj, k), row);
            if q.err != 0 {
                return q;
            }
            heap = wrapping_add(wrapping_add(heap, size_value(in q)), vheap(v));
            q.words.push(v.t);
            q.words.push(v.a);
            q.words.push(v.b);
        }
        output_bytes = wrapping_add(output_bytes, heap);
        if !bound(inout q, output_bytes, 13, "output byte limit") {
            return q;
        }
        out = bn;
    }
    let w = q.work;
    q.words.try_set(0, w);
    q.words.try_set(1, out);
    q
}

// `DataSet::set_rows` checks. prog is
//   limits (16 words), table name off, table name len, catalog,
//   nrows, (nvals, values..)*, nother, (name off, name len, nrows,
//   (nvals, values..)*)*
// with ranges into text (other tables' text values carry only their
// length). On success words holds the normalized table name range.
pub fn set_rows(in prog: Slice[u64], in text: Slice[u8]) -> Q {
    let mut q = new_q();
    q.pool.extend(in text);
    q.ex.extend(in prog);
    if !load_limits(inout q, prog) {
        return q;
    }
    let toff = ex(in q, 16);
    let tlen = ex(in q, 17);
    let mut p = load_catalog_ex(inout q, 18);
    let name = identifier(inout q, toff, tlen);
    if q.err != 0 {
        return q;
    }
    let nrows = ex(in q, p);
    let rows = CTab {
        noff: name,
        nlen: tlen,
        start: wrapping_add(p, 1),
        n: nrows
    };
    if !bound(inout q, nrows, 7, "input row limit") {
        return q;
    }
    validate_rows(inout q, rows);
    if q.err != 0 {
        return q;
    }
    let mut count = nrows;
    let mut bytes = table_bytes(in q, rows);
    let mut e = wrapping_add(p, 1);
    for r in 0..nrows {
        e = wrapping_add(wrapping_add(e, 1), wrapping_mul(ex(in q, e), 3));
    }
    load_data(inout q, e);
    for i in 0..q.dtabs.len() {
        let t = dtab(in q, i);
        if !same(in q.pool, t.noff, t.nlen, name, tlen) {
            count = wrapping_add(count, t.n);
            bytes = wrapping_add(bytes, table_bytes(in q, t));
        }
    }
    if !bound(inout q, count, 7, "input row limit") {
        return q;
    }
    if !bound(inout q, bytes, 8, "input byte limit") {
        return q;
    }
    q.words.push(name);
    q.words.push(tlen);
    q
}

// ---------------------------------------------------------------------
// Access path selection (spec/planner-ddl.md, sections 1 and 2).

fn stat(in q: Q, i: u64) -> Stat {
    match q.stats.try_get(i) {
        Option::Some(s) => s,
        Option::None => Stat {
            binding: 0,
            slot: 0,
            ioff: 0,
            ilen: 0,
            nonnull: 0,
            distinct: 0,
            start: 0,
            n: 0
        },
    }
}

// ANALYZE of column k of data table d: the exact non-null count, distinct
// count and sorted distinct values with their counts. Cached in `stats`
// (`binding` is the data table, `slot` the column).
fn analyze(inout q: Q, d: u64, k: u64) -> Stat {
    for i in 0..q.stats.len() {
        let s = stat(in q, i);
        if s.binding == d && s.slot == k {
            return s;
        }
    }
    let t = dtab(in q, d);
    let start = q.vals.len();
    let mut nonnull: u64 = 0;
    let mut p = t.start;
    for r in 0..t.n {
        let nvals = ex(in q, p);
        let v = val_at(in q, in q.ex, wrapping_add(wrapping_add(p, 1), wrapping_mul(k, 3)));
        p = wrapping_add(wrapping_add(p, 1), wrapping_mul(nvals, 3));
        if v.t == 0 {
            continue_none();
        } else {
            nonnull = wrapping_add(nonnull, 1);
            // Binary search in vals[start .. end].
            let mut lo = start;
            let mut hi = q.vals.len();
            let mut found = false;
            loop {
                if lo >= hi {
                    break;
                }
                let (half, r2) = div_rem(wrapping_sub(hi, lo), 2);
                let mid = wrapping_add(lo, half);
                let o = compare_vals(in q, vat(in q, mid), v);
                if o == 1 {
                    let c = cw(in q.counts, mid);
                    q.counts.try_set(mid, wrapping_add(c, 1));
                    found = true;
                    break;
                } else if o == 0 {
                    lo = wrapping_add(mid, 1);
                } else {
                    hi = mid;
                }
            }
            if !found {
                // Insert at lo.
                q.vals.push(v);
                q.counts.push(1);
                let mut j = wrapping_sub(q.vals.len(), 1);
                loop {
                    if j <= lo {
                        break;
                    }
                    let prev = vat(in q, wrapping_sub(j, 1));
                    let pc = cw(in q.counts, wrapping_sub(j, 1));
                    q.vals.try_set(j, prev);
                    q.counts.try_set(j, pc);
                    j = wrapping_sub(j, 1);
                }
                q.vals.try_set(lo, v);
                q.counts.try_set(lo, 1);
            }
        }
    }
    let s = Stat {
        binding: d,
        slot: k,
        ioff: 0,
        ilen: 0,
        nonnull: nonnull,
        distinct: wrapping_sub(q.vals.len(), start),
        start: start,
        n: wrapping_sub(q.vals.len(), start)
    };
    q.stats.push(s);
    s
}

fn continue_none() {}

fn pages(n: u64) -> u64 {
    let p = ceil_div(n, 64);
    if p == 0 {
        1
    } else {
        p
    }
}

// 1 + ceil(log_128(pages(n))).
fn height(n: u64) -> u64 {
    let mut h: u64 = 1;
    let mut reach: u64 = 1;
    let p = pages(n);
    loop {
        if reach >= p {
            break;
        }
        reach = wrapping_mul(reach, 128);
        h = wrapping_add(h, 1);
    }
    h
}

fn no_bound() -> Bound {
    Bound {
        has_lo: false,
        lo: null_val(),
        lo_incl: false,
        has_hi: false,
        hi: null_val(),
        hi_incl: false,
        null: false,
        unknown: false,
        only_eq: true
    }
}

// A bound operand: a literal, or a parameter (known when it is bound).
// Returns (is an operand, value, known).
fn operand(in q: Q, p: u64) -> (bool, Val, bool) {
    let tag = ex(in q, p);
    if tag == 2 {
        (true, val_at(in q, in q.ex, wrapping_add(p, 3)), true)
    } else if tag == 1 {
        let off = ex(in q, wrapping_add(p, 3));
        let len = ex(in q, wrapping_add(p, 4));
        for i in 0..q.params.len() {
            let d = param(in q, i);
            if same(in q.pool, d.noff, d.nlen, off, len) {
                return (true, vat(in q, d.ty), true);
            }
        }
        (true, null_val(), false)
    } else {
        (false, null_val(), false)
    }
}

// Tighten bound b with `column op value` (op already oriented so the
// column is on the left).
fn tighten(in q: Q, b: Bound, op: u64, v: Val, known: bool) -> Bound {
    let mut r = b;
    if op != 0 {
        r.only_eq = false;
    }
    if !known {
        r.unknown = true;
    } else if v.t == 0 {
        r.null = true;
    }
    let lower = op == 0 || op == 4 || op == 5;
    let upper = op == 0 || op == 2 || op == 3;
    let incl = op == 0 || op == 3 || op == 5;
    if lower {
        if !r.has_lo {
            r.has_lo = true;
            r.lo = v;
            r.lo_incl = incl;
        } else if known && v.t != 0 && r.lo.t != 0 {
            let o = compare_vals(in q, v, r.lo);
            if o == 2 || (o == 1 && !incl) {
                r.lo = v;
                r.lo_incl = incl;
            }
        }
    }
    if upper {
        if !r.has_hi {
            r.has_hi = true;
            r.hi = v;
            r.hi_incl = incl;
        } else if known && v.t != 0 && r.hi.t != 0 {
            let o = compare_vals(in q, v, r.hi);
            if o == 0 || (o == 1 && !incl) {
                r.hi = v;
                r.hi_incl = incl;
            }
        }
    }
    r
}

// The sargable bounds on `slot` among the predicates of scan x.
fn bounds_of(in q: Q, x: Node, slot: u64) -> Bound {
    let mut b = no_bound();
    let mut l = x.f;
    loop {
        if l == none() {
            break;
        }
        let k = link(in q, l);
        l = k.next;
        let p = k.expr;
        if ex(in q, p) != 3 {
            continue_none();
        } else {
            let op = ex(in q, wrapping_add(p, 3));
            let a = wrapping_add(p, 4);
            let c = ex_end(in q, a);
            if op != 1 {
                if ex(in q, a) == 0 && ex(in q, wrapping_add(a, 3)) == slot {
                    let (is_op, v, known) = operand(in q, c);
                    if is_op {
                        b = tighten(in q, b, op, v, known);
                    }
                } else if ex(in q, c) == 0 && ex(in q, wrapping_add(c, 3)) == slot {
                    let (is_op, v, known) = operand(in q, a);
                    // `v > c` is `c < v`.
                    let flipped = if op == 2 {
                        4
                    } else if op == 3 {
                        5
                    } else if op == 4 {
                        2
                    } else if op == 5 {
                        3
                    } else {
                        op
                    };
                    if is_op {
                        b = tighten(in q, b, flipped, v, known);
                    }
                }
            }
        }
    }
    b
}

// The bound kind: eq 0, range 1, lower 2, upper 3.
fn bound_kind(in q: Q, b: Bound) -> u64 {
    if b.has_lo && b.has_hi {
        if b.lo_incl && b.hi_incl && !b.unknown && !b.null && compare_vals(in q, b.lo, b.hi) == 1 {
            0
        } else if (b.unknown || b.null) && b.only_eq {
            0
        } else {
            1
        }
    } else if b.has_lo {
        2
    } else {
        3
    }
}

// The estimated rows of an index path over column stats s.
fn index_rows(in q: Q, b: Bound, kind: u64, s: Stat, n: u64) -> u64 {
    if b.null {
        return 0;
    }
    if b.unknown {
        return if kind == 0 {
            if s.distinct == 0 {
                0
            } else {
                ceil_div(n, s.distinct)
            }
        } else if kind == 1 {
            ceil_div(n, 10)
        } else {
            ceil_div(n, 4)
        };
    }
    let mut m: u64 = 0;
    for i in 0..s.n {
        let v = vat(in q, wrapping_add(s.start, i));
        let above = if b.has_lo {
            let o = compare_vals(in q, v, b.lo);
            o == 2 || (o == 1 && b.lo_incl)
        } else {
            true
        };
        let below = if b.has_hi {
            let o = compare_vals(in q, v, b.hi);
            o == 0 || (o == 1 && b.hi_incl)
        } else {
            true
        };
        if above && below {
            m = wrapping_add(m, cw(in q.counts, wrapping_add(s.start, i)));
        }
    }
    m
}

// The column position of a slot in scan x, or none.
fn column_of(in q: Q, x: Node, slot: u64) -> u64 {
    for k in 0..x.e {
        if ex(in q, wrapping_add(x.d, k)) == slot {
            return k;
        }
    }
    none()
}

// The catalog column position of the index at index-list entry i on the
// table of scan x, or none when the index is on another table.
fn index_column(in q: Q, x: Node, i: u64) -> u64 {
    let base = cw(in q.rows, 0);
    let at = wrapping_add(base, wrapping_mul(i, 6));
    if !same(in q.pool, ex(in q, wrapping_add(at, 2)), ex(in q, wrapping_add(at, 3)), x.a, x.b) {
        return none();
    }
    let t = find_table(in q, x.a, x.b);
    let tab = ctab(in q, t);
    for k in 0..tab.n {
        let c = ccol(in q, wrapping_add(tab.start, k));
        if same(in q.pool, c.noff, c.nlen, ex(in q, wrapping_add(at, 4)), ex(in q, wrapping_add(at, 5))) {
            return k;
        }
    }
    none()
}

// Whether index name a sorts before index name b.
fn name_before(in q: Q, ao: u64, al: u64, bo: u64, bl: u64) -> bool {
    order(in q.pool, ao, al, bo, bl) == 0
}

// Collect the scans (by binding) and, for each join, its right-hand scan:
// scans[binding] = node; joins records (rhs binding, join node).
fn collect(in q: Q, n: u64, inout scans: ChunkSeq[u64], inout joins: ChunkSeq[u64]) {
    let x = node(in q, n);
    if x.kind == 0 {
        scans.try_set(x.c, n);
    } else if x.kind == 1 {
        collect(in q, x.b, inout scans, inout joins);
    } else {
        collect(in q, x.b, inout scans, inout joins);
        collect(in q, x.c, inout scans, inout joins);
        let r = node(in q, x.c);
        if r.kind == 0 {
            joins.push(r.c);
            joins.push(n);
        }
    }
}

// The equality conjuncts `b.c = a.d` of the condition at p, as
// (slot of b, binding of a, slot of a) triples appended to out.
fn join_keys(in q: Q, p: u64, b: u64, inout out: ChunkSeq[u64]) {
    let tag = ex(in q, p);
    if tag == 4 {
        let a = wrapping_add(p, 3);
        join_keys(in q, a, b, inout out);
        join_keys(in q, ex_end(in q, a), b, inout out);
    } else if tag == 3 && ex(in q, wrapping_add(p, 3)) == 0 {
        let x = wrapping_add(p, 4);
        let y = ex_end(in q, x);
        if ex(in q, x) == 0 && ex(in q, y) == 0 {
            let xb = ex(in q, wrapping_add(x, 4));
            let yb = ex(in q, wrapping_add(y, 4));
            if xb == b && yb != b {
                out.push(ex(in q, wrapping_add(x, 3)));
                out.push(yb);
                out.push(ex(in q, wrapping_add(y, 3)));
            } else if yb == b && xb != b {
                out.push(ex(in q, wrapping_add(y, 3)));
                out.push(xb);
                out.push(ex(in q, wrapping_add(x, 3)));
            }
        }
    }
}

// The access paths of an optimized plan. prog is
//   plan, nbinds, (name off, name len, value)*, catalog, data,
//   nindexes, (name off, name len, table off, table len, column off,
//   column len)*
// with ranges into text. On success words holds, per binding in FROM
// order, [kind, index off, index len, bound kind, outer binding,
// outer slot, rows, cost]: kind is scan 0, index 1, index_join 2.
pub fn access_paths(in prog: Slice[u64], in text: Slice[u8]) -> Q {
    let mut q = new_q();
    q.pool.extend(in text);
    q.ex.extend(in prog);
    let (root, plan_end) = decode_plan(inout q, 0);
    let mut p = plan_end;
    let nbinds = ex(in q, p);
    p = wrapping_add(p, 1);
    for k in 0..nbinds {
        let v = val_at(in q, in q.ex, wrapping_add(p, 2));
        let d = CCol {
            noff: ex(in q, p),
            nlen: ex(in q, wrapping_add(p, 1)),
            ty: q.vals.len(),
            nullable: false,
            used: false
        };
        q.vals.push(v);
        q.params.push(d);
        p = wrapping_add(p, 5);
    }
    p = load_catalog_ex(inout q, p);
    p = load_data(inout q, p);
    let nidx = ex(in q, p);
    // rows[0] records where the index list starts in `ex`.
    q.rows.push(wrapping_add(p, 1));
    let mut scans: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..q.plan.len() {
        scans.push(none());
    }
    let mut joins: ChunkSeq[u64] = ChunkSeq::new[u64]();
    collect(in q, root, inout scans, inout joins);
    // rows estimate of each binding's chosen path.
    let mut chosen: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for b in 0..scans.len() {
        let s = cw(in scans, b);
        if s == none() {
            break;
        }
        let x = node(in q, s);
        let d = find_data(in q, x.a, x.b);
        if d == none() {
            fail_name(inout q, 8, "missing data for ", x.a, x.b);
            return q;
        }
        let n = dtab(in q, d).n;
        // Scan.
        let mut kind: u64 = 0;
        let mut ioff: u64 = 0;
        let mut ilen: u64 = 0;
        let mut bkind: u64 = 0;
        let mut outer = none();
        let mut outer_slot = none();
        let mut rows = n;
        let mut cost = wrapping_add(wrapping_mul(1000, pages(n)), wrapping_mul(10, n));
        let base = cw(in q.rows, 0);
        // Index paths.
        for i in 0..nidx {
            let k = index_column(in q, x, i);
            if k == none() {
                continue_none();
            } else {
                let slot = ex(in q, wrapping_add(x.d, k));
                let bd = bounds_of(in q, x, slot);
                if bd.has_lo || bd.has_hi {
                    let st = analyze(inout q, d, k);
                    let bk = bound_kind(in q, bd);
                    let m = index_rows(in q, bd, bk, st, n);
                    let c = wrapping_add(wrapping_mul(1000, height(n)), wrapping_mul(1010, m));
                    let at = wrapping_add(base, wrapping_mul(i, 6));
                    let no = ex(in q, at);
                    let nl = ex(in q, wrapping_add(at, 1));
                    if c < cost || (c == cost && kind == 1 && name_before(in q, no, nl, ioff, ilen)) {
                        kind = 1;
                        ioff = no;
                        ilen = nl;
                        bkind = bk;
                        rows = m;
                        cost = c;
                    }
                }
            }
        }
        // Index nested-loop join paths, for the right side of INNER and
        // LEFT joins.
        let mut j: u64 = 0;
        loop {
            if wrapping_add(j, 1) >= joins.len() {
                break;
            }
            if cw(in joins, j) == b {
                let jn = node(in q, cw(in joins, wrapping_add(j, 1)));
                if jn.a == 0 || jn.a == 1 {
                    let mut keys: ChunkSeq[u64] = ChunkSeq::new[u64]();
                    join_keys(in q, jn.d, b, inout keys);
                    let mut t: u64 = 0;
                    loop {
                        if t >= keys.len() {
                            break;
                        }
                        let bslot = cw(in keys, t);
                        let ab = cw(in keys, wrapping_add(t, 1));
                        let aslot = cw(in keys, wrapping_add(t, 2));
                        t = wrapping_add(t, 3);
                        if !has_binding(in q, jn.b, ab) {
                            continue_none();
                        } else {
                            let k = column_of(in q, x, bslot);
                            let an = node(in q, cw(in scans, ab));
                            let ad = find_data(in q, an.a, an.b);
                            let ak = column_of(in q, an, aslot);
                            if k != none() && ad != none() && ak != none() {
                                let ast = analyze(inout q, ad, ak);
                                let mut kk = cw(in chosen, ab);
                                if kk > ast.distinct {
                                    kk = ast.distinct;
                                }
                                for i in 0..nidx {
                                    if index_column(in q, x, i) == k {
                                        let st = analyze(inout q, d, k);
                                        let probe = if st.distinct == 0 {
                                            0
                                        } else {
                                            ceil_div(wrapping_mul(kk, st.nonnull), st.distinct)
                                        };
                                        let c = wrapping_add(wrapping_mul(wrapping_mul(1000, height(n)), kk), wrapping_mul(1010, probe));
                                        let at = wrapping_add(base, wrapping_mul(i, 6));
                                        let no = ex(in q, at);
                                        let nl = ex(in q, wrapping_add(at, 1));
                                        if c < cost || (c == cost && kind == 2 && name_before(in q, no, nl, ioff, ilen)) {
                                            kind = 2;
                                            ioff = no;
                                            ilen = nl;
                                            outer = ab;
                                            outer_slot = aslot;
                                            rows = probe;
                                            cost = c;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            j = wrapping_add(j, 2);
        }
        chosen.push(rows);
        q.words.push(kind);
        q.words.push(ioff);
        q.words.push(ilen);
        q.words.push(bkind);
        q.words.push(outer);
        q.words.push(outer_slot);
        q.words.push(rows);
        q.words.push(cost);
    }
    q
}
