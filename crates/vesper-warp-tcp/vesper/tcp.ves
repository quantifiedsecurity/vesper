// Vesper port of vesper-warp-tcp (port wave P1 lane 11, #908): the sans-IO
// RFC 9293 endpoint of crates/vesper-warp-tcp/src. The Rust crate keeps its
// public types and forwards every function to this library (`tcp`) through
// port/binding.rs; src/port.rs is the forwarding layer.
//
// Every function that updates an `inout` value is total: failures are
// returned as `Result` values, and the bulk byte reads go through handled
// helpers (an abortable effect cannot cross an active `inout` borrow).
// Arithmetic that Rust performs with `wrapping_*`, or that its invariants
// keep in range, is `wrapping_*` here; Rust's `saturating_*`, `min` and
// `max` are the helpers below.

// ---------------------------------------------------------------------
// Integer helpers
// ---------------------------------------------------------------------

fn max_u64() -> u64 {
    18446744073709551615
}

fn max_u32() -> u32 {
    4294967295
}

fn min64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

fn max64(a: u64, b: u64) -> u64 {
    if a > b {
        a
    } else {
        b
    }
}

fn min32(a: u32, b: u32) -> u32 {
    if a < b {
        a
    } else {
        b
    }
}

fn max32(a: u32, b: u32) -> u32 {
    if a > b {
        a
    } else {
        b
    }
}

fn sat_add64(a: u64, b: u64) -> u64 {
    let s = wrapping_add(a, b);
    if s < a {
        max_u64()
    } else {
        s
    }
}

fn sat_sub64(a: u64, b: u64) -> u64 {
    if a > b {
        wrapping_sub(a, b)
    } else {
        0
    }
}

fn sat_add32(a: u32, b: u32) -> u32 {
    let s = wrapping_add(a, b);
    if s < a {
        max_u32()
    } else {
        s
    }
}

fn sat_sub32(a: u32, b: u32) -> u32 {
    if a > b {
        wrapping_sub(a, b)
    } else {
        0
    }
}

fn sat_mul32(a: u32, b: u32) -> u32 {
    let p = wrapping_mul(widen_u64(a), widen_u64(b));
    if p > widen_u64(max_u32()) {
        max_u32()
    } else {
        wrapping_u32(p)
    }
}

fn sat_mul4_64(a: u64) -> u64 {
    if a > 4611686018427387903 {
        max_u64()
    } else {
        wrapping_mul(a, 4)
    }
}

// `x << s` for `s < 64`, else 0 (bits shifted out are lost, as in Rust).
fn shl64(x: u64, s: u64) -> u64 {
    handle Fail[ArithOverflow] in {
        x << s
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

fn shr64(x: u64, s: u64) -> u64 {
    handle Fail[ArithOverflow] in {
        x >> s
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

fn shl32(x: u32, s: u64) -> u32 {
    handle Fail[ArithOverflow] in {
        x << s
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

// `a / b`, 0 when `b == 0` (callers divide by validated non-zero values).
fn div64(a: u64, b: u64) -> u64 {
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

fn rem64(a: u64, b: u64) -> u64 {
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

fn div32(a: u32, b: u32) -> u32 {
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

// ---------------------------------------------------------------------
// seq.rs: modular sequence arithmetic (RFC 9293 §3.4)
// ---------------------------------------------------------------------

pub fn sn_add(a: u32, n: u32) -> u32 {
    wrapping_add(a, n)
}

pub fn sn_diff(a: u32, b: u32) -> i32 {
    wrapping_i32(wrapping_sub(a, b))
}

pub fn sn_lt(a: u32, b: u32) -> bool {
    sn_diff(a, b) < 0
}

pub fn sn_le(a: u32, b: u32) -> bool {
    sn_diff(a, b) <= 0
}

pub fn sn_gt(a: u32, b: u32) -> bool {
    sn_diff(a, b) > 0
}

pub fn sn_ge(a: u32, b: u32) -> bool {
    sn_diff(a, b) >= 0
}

pub fn sn_in_window(s: u32, lo: u32, hi: u32) -> bool {
    sn_le(lo, s) && sn_lt(s, hi)
}

pub fn seqmap_seq(isn: u32, abs: u64) -> u32 {
    wrapping_add(isn, wrapping_u32(abs))
}

pub fn seqmap_abs(isn: u32, reference: u64, s: u32) -> Option[u64] {
    let delta: i64 = widen_i64(sn_diff(s, seqmap_seq(isn, reference)));
    let zero: i64 = 0;
    if delta >= zero {
        let up = wrapping_add(reference, wrapping_u64(delta));
        if up < reference {
            Option::None
        } else {
            Option::Some(up)
        }
    } else {
        let down = wrapping_u64(wrapping_sub(zero, delta));
        if down > reference {
            Option::None
        } else {
            Option::Some(wrapping_sub(reference, down))
        }
    }
}

// ---------------------------------------------------------------------
// rtt.rs: RFC 6298 retransmission-timeout estimation
// ---------------------------------------------------------------------

copy struct RtoConfig {
    initial_ns: u64,
    min_ns: u64,
    max_ns: u64,
    granularity_ns: u64
}

copy struct RttEstimator {
    cfg: RtoConfig,
    srtt_ns: u64,
    rttvar_ns: u64,
    min_ns: u64,
    latest_ns: u64,
    has_sample: bool,
    backoff_shift: u32
}

pub fn rtt_new(cfg: RtoConfig) -> RttEstimator {
    RttEstimator {
        cfg: cfg,
        srtt_ns: 0,
        rttvar_ns: 0,
        min_ns: max_u64(),
        latest_ns: 0,
        has_sample: false,
        backoff_shift: 0
    }
}

pub fn rtt_sample(inout e: RttEstimator, r_ns: u64) {
    e.latest_ns = r_ns;
    e.min_ns = min64(e.min_ns, r_ns);
    if e.has_sample {
        let err = if e.srtt_ns > r_ns {
            wrapping_sub(e.srtt_ns, r_ns)
        } else {
            wrapping_sub(r_ns, e.srtt_ns)
        };
        // RTTVAR = 3/4 RTTVAR + 1/4 |SRTT - R'|; SRTT = 7/8 SRTT + 1/8 R'.
        e.rttvar_ns = wrapping_add(wrapping_sub(e.rttvar_ns, e.rttvar_ns / 4), err / 4);
        e.srtt_ns = wrapping_add(wrapping_sub(e.srtt_ns, e.srtt_ns / 8), r_ns / 8);
    } else {
        e.srtt_ns = r_ns;
        e.rttvar_ns = r_ns / 2;
        e.has_sample = true;
    }
    // A new sample after backoff restores the computed RTO (§5.7).
    e.backoff_shift = 0;
}

pub fn rtt_backoff(inout e: RttEstimator) {
    if e.backoff_shift < 32 {
        e.backoff_shift = wrapping_add(e.backoff_shift, 1);
    }
}

pub fn rtt_reset_backoff(inout e: RttEstimator) {
    e.backoff_shift = 0;
}

pub fn rtt_rto_ns(e: RttEstimator) -> u64 {
    let raw = if e.has_sample {
        sat_add64(e.srtt_ns, max64(e.cfg.granularity_ns, sat_mul4_64(e.rttvar_ns)))
    } else {
        e.cfg.initial_ns
    };
    let base = if raw < e.cfg.min_ns {
        e.cfg.min_ns
    } else if raw > e.cfg.max_ns {
        e.cfg.max_ns
    } else {
        raw
    };
    let shift = widen_u64(e.backoff_shift);
    let shifted = if shift >= 64 {
        max_u64()
    } else {
        let v = shl64(base, shift);
        if shr64(v, shift) == base {
            v
        } else {
            max_u64()
        }
    };
    min64(shifted, e.cfg.max_ns)
}

// ---------------------------------------------------------------------
// cc.rs: the congestion-control boundary and NewReno (RFC 5681)
// ---------------------------------------------------------------------

copy struct AckedPacket {
    pn: u64,
    sent_ns: u64,
    bytes: u32
}

copy struct LostPacket {
    pn: u64,
    sent_ns: u64,
    bytes: u32
}

copy struct RttSample {
    latest_ns: u64,
    min_ns: u64,
    smoothed_ns: u64,
    ack_delay_ns: u64
}

copy enum CongestionEvent {
    Acked {
        packet: AckedPacket,
        bytes_in_flight: u32
    },
    Lost {
        packet: LostPacket,
        bytes_in_flight: u32
    },
    EcnCe {
        count: u64
    },
    PersistentCongestion,
    AppLimited
}

copy struct NewReno {
    mss: u32,
    cwnd: u32,
    ssthresh: u32,
    ca_acked: u32,
    recovery_start_ns: Option[u64],
    srtt_ns: u64
}

pub fn newreno_new(mss: u32, initial_segments: u32) -> NewReno {
    let m = max32(mss, 1);
    NewReno {
        mss: m,
        cwnd: sat_mul32(m, max32(initial_segments, 1)),
        ssthresh: max_u32(),
        ca_acked: 0,
        recovery_start_ns: Option::None,
        srtt_ns: 0
    }
}

pub fn newreno_set_mss(inout cc: NewReno, mss: u32, initial_segments: u32) {
    cc.mss = max32(mss, 1);
    cc.cwnd = sat_mul32(cc.mss, max32(initial_segments, 1));
}

fn newreno_in_recovery(cc: NewReno, sent_ns: u64) -> bool {
    match cc.recovery_start_ns {
        Option::Some(r) => sent_ns <= r,
        Option::None => false,
    }
}

fn newreno_reduce(inout cc: NewReno, now_ns: u64) {
    cc.recovery_start_ns = Option::Some(now_ns);
    cc.ssthresh = max32(cc.cwnd / 2, wrapping_mul(cc.mss, 2));
    cc.cwnd = cc.ssthresh;
    cc.ca_acked = 0;
}

pub fn newreno_on_mss(inout cc: NewReno, smss: u32) {
    let segments = max32(div32(cc.cwnd, cc.mss), 1);
    newreno_set_mss(inout cc, smss, segments);
}

pub fn newreno_on_rtt_sample(inout cc: NewReno, sample: RttSample) {
    cc.srtt_ns = sample.smoothed_ns;
}

pub fn newreno_on_event(inout cc: NewReno, event: CongestionEvent, now_ns: u64) {
    match event {
        CongestionEvent::Acked { packet, bytes_in_flight } => {
            if !newreno_in_recovery(cc, packet.sent_ns) {
                if cc.cwnd < cc.ssthresh {
                    // RFC 3465 appropriate byte counting with L = 2*SMSS.
                    cc.cwnd = sat_add32(cc.cwnd, min32(packet.bytes, wrapping_mul(cc.mss, 2)));
                } else {
                    cc.ca_acked = sat_add32(cc.ca_acked, packet.bytes);
                    if cc.ca_acked >= cc.cwnd {
                        cc.ca_acked = wrapping_sub(cc.ca_acked, cc.cwnd);
                        cc.cwnd = sat_add32(cc.cwnd, cc.mss);
                    }
                }
            }
        },
        CongestionEvent::Lost { packet, bytes_in_flight } => {
            if !newreno_in_recovery(cc, packet.sent_ns) {
                newreno_reduce(inout cc, now_ns);
            }
        },
        CongestionEvent::EcnCe { count } => {
            let due = match cc.recovery_start_ns {
                Option::Some(r) => now_ns > sat_add64(r, cc.srtt_ns),
                Option::None => true,
            };
            if due {
                newreno_reduce(inout cc, now_ns);
            }
        },
        CongestionEvent::PersistentCongestion => {
            // RFC 5681 §3.1 eq. (4) and the loss window of one segment.
            let fresh = match cc.recovery_start_ns {
                Option::Some(r) => now_ns > r,
                Option::None => true,
            };
            if fresh {
                cc.ssthresh = max32(cc.cwnd / 2, wrapping_mul(cc.mss, 2));
            }
            cc.cwnd = cc.mss;
            cc.ca_acked = 0;
            cc.recovery_start_ns = Option::Some(now_ns);
        },
        CongestionEvent::AppLimited => (),
    }
}

pub fn newreno_pacing_rate(cc: NewReno) -> u64 {
    max_u64()
}

pub fn newreno_schedule_edt(cc: NewReno, bytes: u32, now_ns: u64) -> u64 {
    now_ns
}

// ---------------------------------------------------------------------
// wire.rs: header and options, checksums (RFC 9293 §3.1, RFC 7323,
// RFC 2018, RFC 1071)
// ---------------------------------------------------------------------

copy enum WireError {
    Truncated,
    BadDataOffset,
    MalformedOption {
        kind: u8
    },
    OptionsTooLong,
    BufferTooSmall,
    TooLong,
    BadChecksum
}

// A SACK block of the option list (`wire::SackBlock` with plain words).
copy struct Blk {
    left: u32,
    right: u32
}

copy struct Timestamps {
    val: u32,
    ecr: u32
}

// `wire::TcpOptions`, with the four SACK blocks as fields.
copy struct Opts {
    mss: Option[u16],
    window_scale: Option[u8],
    sack_permitted: bool,
    b0: Blk,
    b1: Blk,
    b2: Blk,
    b3: Blk,
    sack_len: u8,
    timestamps: Option[Timestamps]
}

// `wire::HeaderFields` with plain words.
copy struct Hdr {
    src_port: u16,
    dst_port: u16,
    seq: u32,
    ack: u32,
    flags: u8,
    window: u16,
    urgent: u16
}

// A parsed segment header (`wire::Segment` without its borrowed payload,
// which starts at `header_len`).
copy struct Parsed {
    src_port: u16,
    dst_port: u16,
    seq: u32,
    ack: u32,
    flags: u8,
    window: u16,
    checksum: u16,
    urgent: u16,
    header_len: u64,
    options: Opts
}

// `wire::IpPair` with the addresses as big-endian words.
copy enum Ips {
    V4 {
        src: u32,
        dst: u32
    },
    V6 {
        s0: u64,
        s1: u64,
        d0: u64,
        d1: u64
    }
}

fn fin_bit() -> u8 {
    1
}

fn syn_bit() -> u8 {
    2
}

fn rst_bit() -> u8 {
    4
}

fn psh_bit() -> u8 {
    8
}

fn ack_bit() -> u8 {
    16
}

fn urg_bit() -> u8 {
    32
}

fn has(flags: u8, bit: u8) -> bool {
    flags & bit == bit
}

pub fn flags_contains(f: u8, other: u8) -> bool {
    f & other == other
}

pub fn flags_with(f: u8, other: u8) -> u8 {
    f | other
}

fn no_blk() -> Blk {
    Blk {
        left: 0,
        right: 0
    }
}

pub fn opts_default() -> Opts {
    Opts {
        mss: Option::None,
        window_scale: Option::None,
        sack_permitted: false,
        b0: no_blk(),
        b1: no_blk(),
        b2: no_blk(),
        b3: no_blk(),
        sack_len: 0,
        timestamps: Option::None
    }
}

fn opts_blk(o: Opts, k: u64) -> Blk {
    if k == 0 {
        o.b0
    } else if k == 1 {
        o.b1
    } else if k == 2 {
        o.b2
    } else {
        o.b3
    }
}

fn opts_set_blk(inout o: Opts, k: u64, b: Blk) {
    if k == 0 {
        o.b0 = b;
    } else if k == 1 {
        o.b1 = b;
    } else if k == 2 {
        o.b2 = b;
    } else {
        o.b3 = b;
    }
}

fn sack_count(o: Opts) -> u64 {
    min64(widen_u64(o.sack_len), 4)
}

pub fn opts_encoded_len(o: Opts) -> u64 {
    let mut n: u64 = 0;
    match o.mss {
        Option::Some(m) => {
            n = wrapping_add(n, 4);
        },
        Option::None => (),
    }
    match o.window_scale {
        Option::Some(w) => {
            n = wrapping_add(n, 4);
        },
        Option::None => (),
    }
    if o.sack_permitted {
        n = wrapping_add(n, 4);
    }
    match o.timestamps {
        Option::Some(t) => {
            n = wrapping_add(n, 12);
        },
        Option::None => (),
    }
    if o.sack_len > 0 {
        n = wrapping_add(n, wrapping_add(4, wrapping_mul(8, sack_count(o))));
    }
    n
}

// Byte access. Reads outside the slice are 0 and writes outside it are
// dropped; every caller checks the bounds first, as the Rust code does.
fn rd8(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn rd16(in b: Slice[u8], i: u64) -> u16 {
    widen_u16(rd8(in b, i)) << 8 | widen_u16(rd8(in b, wrapping_add(i, 1)))
}

fn rd32(in b: Slice[u8], i: u64) -> u32 {
    widen_u32(rd16(in b, i)) << 16 | widen_u32(rd16(in b, wrapping_add(i, 2)))
}

fn wr8(inout b: Slice[u8], i: u64, v: u8) {
    b.try_set(i, v);
}

fn wr16(inout b: Slice[u8], i: u64, v: u16) {
    b.try_set(i, wrapping_u8(v >> 8));
    b.try_set(wrapping_add(i, 1), wrapping_u8(v));
}

fn wr32(inout b: Slice[u8], i: u64, v: u32) {
    wr16(inout b, i, wrapping_u16(v >> 16));
    wr16(inout b, wrapping_add(i, 2), wrapping_u16(v));
}

// Write the options at `out[at..]`; the caller checked the room.
fn opts_put(o: Opts, inout out: Slice[u8], at: u64) -> u64 {
    let mut i = at;
    match o.mss {
        Option::Some(mss) => {
            wr8(inout out, i, 2);
            wr8(inout out, wrapping_add(i, 1), 4);
            wr16(inout out, wrapping_add(i, 2), mss);
            i = wrapping_add(i, 4);
        },
        Option::None => (),
    }
    match o.window_scale {
        Option::Some(ws) => {
            wr8(inout out, i, 1);
            wr8(inout out, wrapping_add(i, 1), 3);
            wr8(inout out, wrapping_add(i, 2), 3);
            wr8(inout out, wrapping_add(i, 3), ws);
            i = wrapping_add(i, 4);
        },
        Option::None => (),
    }
    if o.sack_permitted {
        wr8(inout out, i, 1);
        wr8(inout out, wrapping_add(i, 1), 1);
        wr8(inout out, wrapping_add(i, 2), 4);
        wr8(inout out, wrapping_add(i, 3), 2);
        i = wrapping_add(i, 4);
    }
    match o.timestamps {
        Option::Some(ts) => {
            wr8(inout out, i, 1);
            wr8(inout out, wrapping_add(i, 1), 1);
            wr8(inout out, wrapping_add(i, 2), 8);
            wr8(inout out, wrapping_add(i, 3), 10);
            wr32(inout out, wrapping_add(i, 4), ts.val);
            wr32(inout out, wrapping_add(i, 8), ts.ecr);
            i = wrapping_add(i, 12);
        },
        Option::None => (),
    }
    if o.sack_len > 0 {
        let n = sack_count(o);
        wr8(inout out, i, 1);
        wr8(inout out, wrapping_add(i, 1), 1);
        wr8(inout out, wrapping_add(i, 2), 5);
        wr8(inout out, wrapping_add(i, 3), wrapping_u8(wrapping_add(2, wrapping_mul(8, n))));
        i = wrapping_add(i, 4);
        for k in 0..n {
            let b = opts_blk(o, k);
            wr32(inout out, i, b.left);
            wr32(inout out, wrapping_add(i, 4), b.right);
            i = wrapping_add(i, 8);
        }
    }
    wrapping_sub(i, at)
}

pub fn opts_write(o: Opts, inout out: Slice[u8]) -> Result[u64, WireError] {
    let len = opts_encoded_len(o);
    if len > 40 {
        Result::Err(WireError::OptionsTooLong)
    } else if out.len() < len {
        Result::Err(WireError::BufferTooSmall)
    } else {
        Result::Ok(opts_put(o, inout out, 0))
    }
}

fn malformed(kind: u8) -> Result[Opts, WireError] {
    Result::Err(WireError::MalformedOption {
        kind: kind
    })
}

// Parse the option list `bytes[from..to]`.
fn opts_parse_at(in bytes: Slice[u8], from: u64, to: u64) -> Result[Opts, WireError] {
    let mut opts = opts_default();
    let mut i = from;
    loop {
        if i >= to {
            break;
        }
        let kind = rd8(in bytes, i);
        if kind == 0 {
            // End of option list; the rest is padding.
            break;
        }
        if kind == 1 {
            i = wrapping_add(i, 1);
        } else {
            if wrapping_add(i, 1) >= to {
                return malformed(kind);
            }
            let len = widen_u64(rd8(in bytes, wrapping_add(i, 1)));
            if len < 2 || wrapping_add(i, len) > to {
                return malformed(kind);
            }
            let body = wrapping_add(i, 2);
            if kind == 2 {
                let dup = match opts.mss {
                    Option::Some(m) => true,
                    Option::None => false,
                };
                if len != 4 || dup {
                    return malformed(kind);
                }
                opts.mss = Option::Some(rd16(in bytes, body));
            } else if kind == 3 {
                let dup = match opts.window_scale {
                    Option::Some(w) => true,
                    Option::None => false,
                };
                if len != 3 || dup {
                    return malformed(kind);
                }
                opts.window_scale = Option::Some(rd8(in bytes, body));
            } else if kind == 4 {
                if len != 2 || opts.sack_permitted {
                    return malformed(kind);
                }
                opts.sack_permitted = true;
            } else if kind == 5 {
                let n = wrapping_sub(len, 2) / 8;
                if wrapping_sub(len, 2) % 8 != 0 || n == 0 || n > 4 || opts.sack_len != 0 {
                    return malformed(kind);
                }
                for k in 0..n {
                    let at = wrapping_add(body, wrapping_mul(k, 8));
                    opts_set_blk(
                        inout opts,
                        k,
                        Blk {
                            left: rd32(in bytes, at),
                            right: rd32(in bytes, wrapping_add(at, 4))
                        }
                    );
                }
                opts.sack_len = wrapping_u8(n);
            } else if kind == 8 {
                let dup = match opts.timestamps {
                    Option::Some(t) => true,
                    Option::None => false,
                };
                if len != 10 || dup {
                    return malformed(kind);
                }
                opts.timestamps = Option::Some(
                    Timestamps {
                        val: rd32(in bytes, body),
                        ecr: rd32(in bytes, wrapping_add(body, 4))
                    }
                );
            }
            // Unknown options with a valid length are skipped.
            i = wrapping_add(i, len);
        }
    }
    Result::Ok(opts)
}

pub fn opts_parse(in bytes: Slice[u8]) -> Result[Opts, WireError] {
    opts_parse_at(in bytes, 0, bytes.len())
}

pub fn segment_parse(in bytes: Slice[u8]) -> Result[Parsed, WireError] {
    if bytes.len() < 20 {
        return Result::Err(WireError::Truncated);
    }
    let header_len = wrapping_mul(widen_u64(rd8(in bytes, 12) >> 4), 4);
    if header_len < 20 || header_len > bytes.len() {
        return Result::Err(WireError::BadDataOffset);
    }
    match opts_parse_at(in bytes, 20, header_len) {
        Result::Err(e) => Result::Err(e),
        Result::Ok(options) => Result::Ok(
            Parsed {
                src_port: rd16(in bytes, 0),
                dst_port: rd16(in bytes, 2),
                seq: rd32(in bytes, 4),
                ack: rd32(in bytes, 8),
                flags: rd8(in bytes, 13),
                window: rd16(in bytes, 14),
                checksum: rd16(in bytes, 16),
                urgent: rd16(in bytes, 18),
                header_len: header_len,
                options: options
            }
        ),
    }
}

pub fn segment_seq_len(flags: u8, payload_len: u64) -> u32 {
    let mut n = wrapping_u32(payload_len);
    if has(flags, syn_bit()) {
        n = wrapping_add(n, 1);
    }
    if has(flags, fin_bit()) {
        n = wrapping_add(n, 1);
    }
    n
}

pub fn write_header(inout out: Slice[u8], h: Hdr, o: Opts) -> Result[u64, WireError] {
    let opt_len = opts_encoded_len(o);
    if opt_len > 40 {
        return Result::Err(WireError::OptionsTooLong);
    }
    let header_len = wrapping_add(20, opt_len);
    if out.len() < header_len {
        return Result::Err(WireError::BufferTooSmall);
    }
    wr16(inout out, 0, h.src_port);
    wr16(inout out, 2, h.dst_port);
    wr32(inout out, 4, h.seq);
    wr32(inout out, 8, h.ack);
    wr8(inout out, 12, wrapping_u8(header_len / 4) << 4);
    wr8(inout out, 13, h.flags);
    wr16(inout out, 14, h.window);
    wr16(inout out, 16, 0);
    wr16(inout out, 18, h.urgent);
    opts_put(o, inout out, 20);
    Result::Ok(header_len)
}

pub fn ips_default_mss(ips: Ips) -> u16 {
    match ips {
        Ips::V4 { src, dst } => 536,
        Ips::V6 { s0, s1, d0, d1 } => 1220,
    }
}

pub fn ips_reversed(ips: Ips) -> Ips {
    match ips {
        Ips::V4 { src, dst } => Ips::V4 {
            src: dst,
            dst: src
        },
        Ips::V6 { s0, s1, d0, d1 } => Ips::V6 {
            s0: d0,
            s1: d1,
            d0: s0,
            d1: s1
        },
    }
}

fn ips_eq(a: Ips, b: Ips) -> bool {
    match a {
        Ips::V4 { src, dst } => match b {
            Ips::V4 { src: s2, dst: d2 } => src == s2 && dst == d2,
            Ips::V6 { s0, s1, d0, d1 } => false,
        },
        Ips::V6 { s0, s1, d0, d1 } => match b {
            Ips::V4 { src, dst } => false,
            Ips::V6 { s0: t0, s1: t1, d0: e0, d1: e1 } => s0 == t0 && s1 == t1 && d0 == e0 && d1 == e1,
        },
    }
}

fn words16_32(x: u32) -> u64 {
    wrapping_add(widen_u64(x >> 16), widen_u64(x & 65535))
}

fn words16_64(x: u64) -> u64 {
    wrapping_add(
        wrapping_add(x >> 48, x >> 32 & 65535),
        wrapping_add(x >> 16 & 65535, x & 65535)
    )
}

// The one's-complement sum of `bytes[from..to]` as big-endian 16-bit
// words, an odd trailing byte padded with zero (raw form: reads raise).
fn sum_range_raw(acc: u64, in bytes: Slice[u8], from: u64, to: u64) -> u64 eff [Fail[RuntimeError]] {
    let mut a = acc;
    let mut i = from;
    loop {
        if wrapping_add(i, 1) >= to {
            break;
        }
        a = wrapping_add(a, widen_u64(bytes[i]) << 8 | widen_u64(bytes[wrapping_add(i, 1)]));
        i = wrapping_add(i, 2);
    }
    if i < to {
        a = wrapping_add(a, widen_u64(bytes[i]) << 8);
    }
    a
}

fn sum_range(acc: u64, in bytes: Slice[u8], from: u64, to: u64) -> u64 {
    let end = min64(to, bytes.len());
    handle Fail[RuntimeError] in {
        sum_range_raw(acc, in bytes, from, end)
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

pub fn sum_bytes(acc: u64, in bytes: Slice[u8]) -> u64 {
    sum_range(acc, in bytes, 0, bytes.len())
}

pub fn fold(acc: u64) -> u16 {
    let mut a = acc;
    loop {
        if a >> 16 == 0 {
            break;
        }
        a = wrapping_add(a & 65535, a >> 16);
    }
    wrapping_u16(a)
}

pub fn pseudo_header_sum(ips: Ips, tcp_len: u64) -> Result[u64, WireError] {
    match ips {
        Ips::V4 { src, dst } => {
            if tcp_len > 65535 {
                Result::Err(WireError::TooLong)
            } else {
                Result::Ok(wrapping_add(wrapping_add(wrapping_add(words16_32(src), words16_32(dst)), 6), tcp_len))
            }
        },
        Ips::V6 { s0, s1, d0, d1 } => {
            if tcp_len > 4294967295 {
                Result::Err(WireError::TooLong)
            } else {
                let addrs = wrapping_add(
                    wrapping_add(words16_64(s0), words16_64(s1)),
                    wrapping_add(words16_64(d0), words16_64(d1))
                );
                Result::Ok(wrapping_add(wrapping_add(addrs, wrapping_add(tcp_len >> 16, tcp_len & 65535)), 6))
            }
        },
    }
}

pub fn compute_checksum(ips: Ips, in segment: Slice[u8]) -> Result[u16, WireError] {
    let n = segment.len();
    if n < 20 {
        return Result::Err(WireError::Truncated);
    }
    match pseudo_header_sum(ips, n) {
        Result::Err(e) => Result::Err(e),
        Result::Ok(p) => {
            let a = sum_range(p, in segment, 0, 16);
            Result::Ok(~fold(sum_range(a, in segment, 18, n)))
        },
    }
}

// `fill_checksum` over `segment[..n]`.
fn fill_checksum_n(ips: Ips, inout segment: Slice[u8], n: u64) -> Result[Unit, WireError] {
    if n < 20 {
        return Result::Err(WireError::Truncated);
    }
    match pseudo_header_sum(ips, n) {
        Result::Err(e) => Result::Err(e),
        Result::Ok(p) => {
            let a = sum_range(p, in segment, 0, 16);
            let c = ~fold(sum_range(a, in segment, 18, n));
            wr16(inout segment, 16, c);
            Result::Ok(())
        },
    }
}

pub fn fill_checksum(ips: Ips, inout segment: Slice[u8]) -> Result[Unit, WireError] {
    let n = segment.len();
    fill_checksum_n(ips, inout segment, n)
}

pub fn verify_checksum(ips: Ips, in segment: Slice[u8]) -> Result[Unit, WireError] {
    let n = segment.len();
    if n < 20 {
        return Result::Err(WireError::Truncated);
    }
    match pseudo_header_sum(ips, n) {
        Result::Err(e) => Result::Err(e),
        Result::Ok(p) => {
            if fold(sum_range(p, in segment, 0, n)) == 65535 {
                Result::Ok(())
            } else {
                Result::Err(WireError::BadChecksum)
            }
        },
    }
}

// ---------------------------------------------------------------------
// conn.rs: the connection (one TCB)
// ---------------------------------------------------------------------

copy enum State {
    Closed,
    Listen,
    SynSent,
    SynReceived,
    Established,
    FinWait1,
    FinWait2,
    CloseWait,
    Closing,
    LastAck,
    TimeWait
}

pub fn state_is_synchronized(s: State) -> bool {
    !(s == State::Closed || s == State::Listen || s == State::SynSent)
}

copy struct Config {
    local_port: u16,
    mss: u16,
    recv_buffer: u32,
    window_scale: Option[u8],
    sack: bool,
    timestamps: bool,
    rto: RtoConfig,
    max_retransmits: u32,
    time_wait_ns: u64,
    delayed_ack_ns: u64,
    max_in_flight_segments: u32,
    max_ooo_ranges: u32,
    challenge_ack_limit: u32,
    initial_window_segments: u32,
    nagle: bool
}

copy enum CloseReason {
    Reset,
    Refused,
    TimedOut,
    Aborted
}

copy enum Event {
    Connected,
    PeerFinished,
    Closed(Option[CloseReason])
}

// `conn::TcpError`; `InvalidConfig` carries an index into the Rust
// messages (`port::CONFIG_ERRORS`).
copy enum TcpFail {
    Wire(WireError),
    NotForThisConnection,
    RingSizeMismatch,
    InvalidState(State),
    ConnectionClosing,
    SendViewMissing {
        start: u64,
        end: u64
    },
    BufferTooSmall,
    InvalidConfig(u8),
    ReleaseExceedsUnread,
    Overflow
}

copy struct Stats {
    segments_sent: u64,
    retransmits: u64,
    retransmitted_bytes: u64,
    recoveries: u64,
    rtos: u64,
    window_probes: u64,
    challenge_acks: u64,
    challenge_acks_suppressed: u64,
    ooo_dropped: u64,
    paws_dropped: u64,
    dup_acks: u64
}

copy struct SentSeg {
    start: u64,
    end: u64,
    syn: bool,
    fin: bool,
    pn: u64,
    sent_ns: u64,
    retransmits: u32,
    sacked: bool,
    lost: bool,
    rexmit_in_recovery: bool
}

copy struct OooRange {
    start: u64,
    end: u64,
    stamp: u64
}

copy struct RstSpec {
    ips: Ips,
    src_port: u16,
    dst_port: u16,
    seq: u32,
    ack: Option[u32]
}

// A congestion-controller call, recorded in order for the Rust wrapper to
// apply to its `CongestionController` after the call that made it.
copy enum CcCmd {
    Mss(u32),
    Rtt(RttSample),
    Event {
        event: CongestionEvent,
        now: u64
    }
}

// In-order payload surfaced by one segment, as offsets: the segment's own
// bytes `[seg_start, seg_start + seg_len)`, then the ring
// `[ring_start, ring_start + ring_len1)` and `[0, ring_len2)`.
copy struct RecvOut {
    seg_start: u64,
    seg_len: u64,
    ring_start: u64,
    ring_len1: u64,
    ring_len2: u64,
    fin: bool
}

// One segment written by `tcb_poll_transmit`. For a sequence-space entry
// (`entry`), the wrapper asks its controller for the departure time of
// `bytes` and reports the send of `pn`; `edt_ns` is `now` until
// `tcb_commit_edt` moves it.
copy struct Tx {
    len: u64,
    edt_ns: u64,
    ips: Ips,
    entry: bool,
    pn: u64,
    bytes: u32
}

struct Tcb {
    cfg: Config,
    st: State,
    passive: bool,
    remote_port: u16,
    ips: Option[Ips],
    iss_base: u32,
    snd_isn: u32,
    snd_una: u64,
    snd_nxt: u64,
    snd_wnd: u32,
    max_snd_wnd: u32,
    snd_wl1: u32,
    snd_wl2: u32,
    snd_wscale: u8,
    rcv_wscale: u8,
    ws_ok: bool,
    sack_ok: bool,
    ts_ok: bool,
    peer_mss: u16,
    smss: u32,
    need_syn: bool,
    write_end: u64,
    fin_requested: bool,
    fin_abs: Option[u64],
    released_off: u64,
    sent: ChunkSeq[SentSeg],
    sent_head: u64,
    sent_len: u64,
    sent_cap: u64,
    next_pn: u64,
    rtt: RttEstimator,
    timed: Option[u64],
    rto_deadline: Option[u64],
    retries: u32,
    persist_deadline: Option[u64],
    persist_backoff: u32,
    probe_due: bool,
    dupacks: u32,
    recovery_point: Option[u64],
    force_retx: bool,
    rcv_isn: u32,
    have_irs: bool,
    rcv_nxt: u64,
    rcv_adv_right: u64,
    read_off: u64,
    ooo: ChunkSeq[OooRange],
    ooo_stamp: u64,
    ooo_fin: Option[u64],
    fin_received: bool,
    urgent_off: Option[u64],
    ts_recent: u32,
    ts_recent_valid: bool,
    last_ack_sent: u64,
    ack_now: bool,
    ack_pending: u32,
    delack_deadline: Option[u64],
    challenge_window_ns: u64,
    challenge_count: u32,
    pending_rst: Option[RstSpec],
    time_wait_deadline: Option[u64],
    events: u8,
    close_reason: Option[CloseReason],
    stats: Stats,
    cmds: ChunkSeq[CcCmd],
    edt_entry: Option[u64],
    edt_armed_rto: bool
}

fn dup_thresh() -> u32 {
    3
}

fn min_send_mss() -> u16 {
    64
}

fn ev_connected() -> u8 {
    1
}

fn ev_peer_fin() -> u8 {
    2
}

fn ev_closed() -> u8 {
    4
}

fn is_some(o: Option[u64]) -> bool {
    match o {
        Option::Some(v) => true,
        Option::None => false,
    }
}

fn no_seg() -> SentSeg {
    SentSeg {
        start: 0,
        end: 0,
        syn: false,
        fin: false,
        pn: 0,
        sent_ns: 0,
        retransmits: 0,
        sacked: false,
        lost: false,
        rexmit_in_recovery: false
    }
}

fn seg_bytes(s: SentSeg) -> u32 {
    // Entries are at most one MSS (+SYN/FIN).
    wrapping_u32(wrapping_sub(s.end, s.start))
}

fn seg_data_start(s: SentSeg) -> u64 {
    max64(s.start, 1)
}

fn seg_data_end(s: SentSeg) -> u64 {
    let e = if s.fin {
        wrapping_sub(s.end, 1)
    } else {
        s.end
    };
    max64(e, seg_data_start(s))
}

fn zero_stats() -> Stats {
    Stats {
        segments_sent: 0,
        retransmits: 0,
        retransmitted_bytes: 0,
        recoveries: 0,
        rtos: 0,
        window_probes: 0,
        challenge_acks: 0,
        challenge_acks_suppressed: 0,
        ooo_dropped: 0,
        paws_dropped: 0,
        dup_acks: 0
    }
}

fn no_recv() -> RecvOut {
    RecvOut {
        seg_start: 0,
        seg_len: 0,
        ring_start: 0,
        ring_len1: 0,
        ring_len2: 0,
        fin: false
    }
}

fn some_ips(o: Option[Ips]) -> Ips {
    match o {
        Option::Some(i) => i,
        Option::None => Ips::V4 {
            src: 0,
            dst: 0
        },
    }
}

// The sent queue: a fixed-capacity ring of `sent_cap` entries.

fn sq_slot(in t: Tcb, i: u64) -> u64 {
    let k = wrapping_add(t.sent_head, i);
    if k >= t.sent_cap {
        wrapping_sub(k, t.sent_cap)
    } else {
        k
    }
}

fn sq_get(in t: Tcb, i: u64) -> SentSeg {
    match t.sent.try_get(sq_slot(in t, i)) {
        Option::Some(s) => s,
        Option::None => no_seg(),
    }
}

fn sq_set(inout t: Tcb, i: u64, s: SentSeg) {
    let k = sq_slot(in t, i);
    t.sent.try_set(k, s);
}

fn sq_push(inout t: Tcb, s: SentSeg) -> bool {
    if t.sent_len == t.sent_cap {
        false
    } else {
        let k = sq_slot(in t, t.sent_len);
        t.sent.try_set(k, s);
        t.sent_len = wrapping_add(t.sent_len, 1);
        true
    }
}

fn sq_pop_front(inout t: Tcb) {
    if t.sent_len > 0 {
        t.sent_head = wrapping_add(t.sent_head, 1);
        if t.sent_head == t.sent_cap {
            t.sent_head = 0;
        }
        t.sent_len = wrapping_sub(t.sent_len, 1);
    }
}

fn sq_clear(inout t: Tcb) {
    t.sent_head = 0;
    t.sent_len = 0;
}

fn ooo_remove(inout t: Tcb, i: u64) {
    // swap_remove
    let last = wrapping_sub(t.ooo.len(), 1);
    match t.ooo.try_get(last) {
        Option::Some(r) => {
            t.ooo.try_set(i, r);
        },
        Option::None => (),
    }
    t.ooo.truncate(last);
}

fn ooo_at(in t: Tcb, i: u64) -> OooRange {
    match t.ooo.try_get(i) {
        Option::Some(r) => r,
        Option::None => OooRange {
            start: 0,
            end: 0,
            stamp: 0
        },
    }
}

fn cc_cmd(inout t: Tcb, c: CcCmd) {
    t.cmds.push(c);
}

fn cc_event(inout t: Tcb, event: CongestionEvent, now: u64) {
    t.cmds.push(CcCmd::Event {
        event: event,
        now: now
    });
}

pub fn config_validate(cfg: Config) -> Result[Unit, TcpFail] {
    let ws_bad = match cfg.window_scale {
        Option::Some(s) => s > 14,
        Option::None => false,
    };
    if cfg.mss < min_send_mss() {
        Result::Err(TcpFail::InvalidConfig(0))
    } else if cfg.recv_buffer == 0 || cfg.recv_buffer > 1073741824 {
        Result::Err(TcpFail::InvalidConfig(1))
    } else if ws_bad {
        Result::Err(TcpFail::InvalidConfig(2))
    } else if cfg.max_in_flight_segments == 0 || cfg.max_ooo_ranges == 0 {
        Result::Err(TcpFail::InvalidConfig(3))
    } else if cfg.rto.min_ns == 0 || cfg.rto.min_ns > cfg.rto.max_ns {
        Result::Err(TcpFail::InvalidConfig(4))
    } else {
        Result::Ok(())
    }
}

// A closed connection for a configuration `config_validate` accepted.
pub fn tcb_new(cfg: Config) -> Tcb {
    let cap = widen_u64(cfg.max_in_flight_segments);
    let mut sent: ChunkSeq[SentSeg] = ChunkSeq::with_capacity[SentSeg](cap);
    for i in 0..cap {
        sent.push(no_seg());
    }
    Tcb {
        cfg: cfg,
        st: State::Closed,
        passive: false,
        remote_port: 0,
        ips: Option::None,
        iss_base: 0,
        snd_isn: 0,
        snd_una: 0,
        snd_nxt: 0,
        snd_wnd: 0,
        max_snd_wnd: 0,
        snd_wl1: 0,
        snd_wl2: 0,
        snd_wscale: 0,
        rcv_wscale: 0,
        ws_ok: false,
        sack_ok: false,
        ts_ok: false,
        peer_mss: 536,
        smss: 536,
        need_syn: false,
        write_end: 0,
        fin_requested: false,
        fin_abs: Option::None,
        released_off: 0,
        sent: sent,
        sent_head: 0,
        sent_len: 0,
        sent_cap: cap,
        next_pn: 0,
        rtt: rtt_new(cfg.rto),
        timed: Option::None,
        rto_deadline: Option::None,
        retries: 0,
        persist_deadline: Option::None,
        persist_backoff: 0,
        probe_due: false,
        dupacks: 0,
        recovery_point: Option::None,
        force_retx: false,
        rcv_isn: 0,
        have_irs: false,
        rcv_nxt: 0,
        rcv_adv_right: 0,
        read_off: 0,
        ooo: ChunkSeq::with_capacity[OooRange](widen_u64(cfg.max_ooo_ranges)),
        ooo_stamp: 0,
        ooo_fin: Option::None,
        fin_received: false,
        urgent_off: Option::None,
        ts_recent: 0,
        ts_recent_valid: false,
        last_ack_sent: 0,
        ack_now: false,
        ack_pending: 0,
        delack_deadline: Option::None,
        challenge_window_ns: 0,
        challenge_count: 0,
        pending_rst: Option::None,
        time_wait_deadline: Option::None,
        events: 0,
        close_reason: Option::None,
        stats: zero_stats(),
        cmds: ChunkSeq::with_capacity[CcCmd](64),
        edt_entry: Option::None,
        edt_armed_rto: false
    }
}

// ----------------------------------------------------------------
// Accessors
// ----------------------------------------------------------------

fn data_rcv_end(in t: Tcb) -> u64 {
    if t.fin_received {
        sat_sub64(t.rcv_nxt, 2)
    } else {
        max_u64()
    }
}

pub fn tcb_acked_offset(in t: Tcb) -> u64 {
    min64(sat_sub64(t.snd_una, 1), t.write_end)
}

pub fn tcb_recv_offset(in t: Tcb) -> u64 {
    min64(sat_sub64(t.rcv_nxt, 1), data_rcv_end(in t))
}

pub fn tcb_unread(in t: Tcb) -> u64 {
    wrapping_sub(tcb_recv_offset(in t), t.read_off)
}

pub fn tcb_bytes_in_flight(in t: Tcb) -> u32 {
    pipe(in t)
}

pub fn tcb_recv_next_seq(in t: Tcb) -> Option[u32] {
    if t.have_irs {
        Option::Some(seqmap_seq(t.rcv_isn, t.rcv_nxt))
    } else {
        Option::None
    }
}

pub fn tcb_send_seqs(in t: Tcb) -> (u32, u32) {
    (seqmap_seq(t.snd_isn, t.snd_una), seqmap_seq(t.snd_isn, t.snd_nxt))
}

pub fn tcb_ooo_ranges(in t: Tcb) -> u64 {
    t.ooo.len()
}

pub fn tcb_written(in t: Tcb) -> u64 {
    t.write_end
}

fn opt_min(a: Option[u64], b: Option[u64]) -> Option[u64] {
    match a {
        Option::None => b,
        Option::Some(x) => match b {
            Option::None => a,
            Option::Some(y) => Option::Some(min64(x, y)),
        },
    }
}

pub fn tcb_poll_timeout(in t: Tcb) -> Option[u64] {
    opt_min(opt_min(t.rto_deadline, t.persist_deadline), opt_min(t.delack_deadline, t.time_wait_deadline))
}

// ----------------------------------------------------------------
// User calls (RFC 9293 §3.10.1–§3.10.6)
// ----------------------------------------------------------------

pub fn tcb_listen(inout t: Tcb, iss_base: u32) -> Result[Unit, TcpFail] {
    if t.st != State::Closed {
        return Result::Err(TcpFail::InvalidState(t.st));
    }
    reset_tcb(inout t);
    t.iss_base = iss_base;
    t.passive = true;
    t.st = State::Listen;
    Result::Ok(())
}

pub fn tcb_connect(inout t: Tcb, now: u64, ips: Ips, remote_port: u16, iss_base: u32) -> Result[Unit, TcpFail] {
    if t.st != State::Closed {
        return Result::Err(TcpFail::InvalidState(t.st));
    }
    reset_tcb(inout t);
    t.iss_base = iss_base;
    t.passive = false;
    t.ips = Option::Some(ips);
    t.remote_port = remote_port;
    t.peer_mss = ips_default_mss(ips);
    t.snd_isn = clock_iss(in t, now);
    t.need_syn = true;
    t.st = State::SynSent;
    Result::Ok(())
}

pub fn tcb_write(inout t: Tcb, n: u64) -> Result[Unit, TcpFail] {
    let s = t.st;
    let open = s == State::SynSent || s == State::SynReceived || s == State::Established || s == State::CloseWait;
    if open && !t.fin_requested {
        let v = wrapping_add(t.write_end, n);
        if v < t.write_end || v >= 4611686018427387904 {
            Result::Err(TcpFail::Overflow)
        } else {
            t.write_end = v;
            Result::Ok(())
        }
    } else if s == State::Closed || s == State::Listen {
        Result::Err(TcpFail::InvalidState(s))
    } else {
        Result::Err(TcpFail::ConnectionClosing)
    }
}

pub fn tcb_close(inout t: Tcb) -> Result[Unit, TcpFail] {
    let s = t.st;
    if s == State::Listen || s == State::SynSent {
        enter_closed(inout t, Option::None);
        Result::Ok(())
    } else if (s == State::SynReceived || s == State::Established || s == State::CloseWait) && !t.fin_requested {
        t.fin_requested = true;
        if s == State::Established {
            t.st = State::FinWait1;
        } else if s == State::CloseWait {
            t.st = State::LastAck;
        }
        // RFC 9293 §3.10.4 permits queueing until ESTABLISHED.
        Result::Ok(())
    } else if s == State::Closed {
        Result::Err(TcpFail::InvalidState(s))
    } else {
        Result::Err(TcpFail::ConnectionClosing)
    }
}

pub fn tcb_abort(inout t: Tcb) {
    if state_is_synchronized(t.st) && t.st != State::TimeWait {
        match t.ips {
            Option::Some(ips) => {
                t.pending_rst = Option::Some(
                    RstSpec {
                        ips: ips,
                        src_port: t.cfg.local_port,
                        dst_port: t.remote_port,
                        seq: seqmap_seq(t.snd_isn, t.snd_nxt),
                        ack: Option::None
                    }
                );
            },
            Option::None => (),
        }
    }
    if t.st != State::Closed {
        enter_closed(inout t, Option::Some(CloseReason::Aborted));
    }
}

pub fn tcb_recv_release(inout t: Tcb, n: u64) -> Result[Unit, TcpFail] {
    if n > tcb_unread(in t) {
        return Result::Err(TcpFail::ReleaseExceedsUnread);
    }
    t.read_off = wrapping_add(t.read_off, n);
    if state_is_synchronized(t.st) {
        let right = recv_right(in t);
        if sat_sub64(right, t.rcv_adv_right) >= sws_threshold(in t) {
            t.ack_now = true;
        }
    }
    Result::Ok(())
}

pub fn tcb_take_released(inout t: Tcb) -> Option[(u64, u64)] {
    let acked = tcb_acked_offset(in t);
    if acked > t.released_off {
        let start = t.released_off;
        t.released_off = acked;
        Option::Some((start, acked))
    } else {
        Option::None
    }
}

pub fn tcb_take_event(inout t: Tcb) -> Option[Event] {
    if t.events & ev_connected() != 0 {
        t.events = t.events & ~ev_connected();
        Option::Some(Event::Connected)
    } else if t.events & ev_peer_fin() != 0 {
        t.events = t.events & ~ev_peer_fin();
        Option::Some(Event::PeerFinished)
    } else if t.events & ev_closed() != 0 {
        t.events = t.events & ~ev_closed();
        Option::Some(Event::Closed(t.close_reason))
    } else {
        Option::None
    }
}

// ----------------------------------------------------------------
// Internal helpers
// ----------------------------------------------------------------

fn clock_iss(in t: Tcb, now: u64) -> u32 {
    wrapping_add(t.iss_base, wrapping_u32(now / 4000))
}

fn ts_now(now: u64) -> u32 {
    // The timestamp clock wraps by design (RFC 7323 §5.2).
    wrapping_u32(now / 1000000)
}

fn reset_tcb(inout t: Tcb) {
    t.passive = false;
    t.remote_port = 0;
    t.ips = Option::None;
    t.snd_isn = 0;
    t.snd_una = 0;
    t.snd_nxt = 0;
    t.snd_wnd = 0;
    t.max_snd_wnd = 0;
    t.snd_wl1 = 0;
    t.snd_wl2 = 0;
    t.snd_wscale = 0;
    t.rcv_wscale = 0;
    t.ws_ok = false;
    t.sack_ok = false;
    t.ts_ok = false;
    t.peer_mss = 536;
    t.smss = 536;
    t.need_syn = false;
    t.write_end = 0;
    t.fin_requested = false;
    t.fin_abs = Option::None;
    t.released_off = 0;
    sq_clear(inout t);
    t.rtt = rtt_new(t.cfg.rto);
    t.timed = Option::None;
    t.rto_deadline = Option::None;
    t.retries = 0;
    t.persist_deadline = Option::None;
    t.persist_backoff = 0;
    t.probe_due = false;
    t.dupacks = 0;
    t.recovery_point = Option::None;
    t.force_retx = false;
    t.rcv_isn = 0;
    t.have_irs = false;
    t.rcv_nxt = 0;
    t.rcv_adv_right = 0;
    t.read_off = 0;
    t.ooo.clear();
    t.ooo_fin = Option::None;
    t.fin_received = false;
    t.urgent_off = Option::None;
    t.ts_recent = 0;
    t.ts_recent_valid = false;
    t.last_ack_sent = 0;
    t.ack_now = false;
    t.ack_pending = 0;
    t.delack_deadline = Option::None;
    t.pending_rst = Option::None;
    t.time_wait_deadline = Option::None;
    t.close_reason = Option::None;
}

fn enter_closed(inout t: Tcb, reason: Option[CloseReason]) {
    t.st = State::Closed;
    t.close_reason = reason;
    t.events = t.events | ev_closed();
    sq_clear(inout t);
    t.ooo.clear();
    t.rto_deadline = Option::None;
    t.persist_deadline = Option::None;
    t.delack_deadline = Option::None;
    t.time_wait_deadline = Option::None;
    t.need_syn = false;
    t.ack_now = false;
    t.probe_due = false;
}

fn enter_time_wait(inout t: Tcb, now: u64) {
    t.st = State::TimeWait;
    t.rto_deadline = Option::None;
    t.persist_deadline = Option::None;
    t.time_wait_deadline = Option::Some(sat_add64(now, t.cfg.time_wait_ns));
}

fn enter_established(inout t: Tcb) {
    t.st = State::Established;
    t.events = t.events | ev_connected();
    if t.fin_requested {
        t.st = State::FinWait1;
    }
}

// Absolute right edge of the receive window (1 + read offset + ring).
fn recv_right(in t: Tcb) -> u64 {
    wrapping_add(wrapping_add(1, t.read_off), widen_u64(t.cfg.recv_buffer))
}

fn recv_window(in t: Tcb) -> u32 {
    // Bounded by recv_buffer (<= 2^30).
    wrapping_u32(sat_sub64(recv_right(in t), t.rcv_nxt))
}

fn sws_threshold(in t: Tcb) -> u64 {
    widen_u64(max32(min32(t.cfg.recv_buffer / 2, widen_u32(t.cfg.mss)), 1))
}

fn fin_acked(in t: Tcb) -> bool {
    match t.fin_abs {
        Option::Some(f) => t.snd_una > f,
        Option::None => false,
    }
}

fn pipe(in t: Tcb) -> u32 {
    let mut p: u32 = 0;
    for i in 0..t.sent_len {
        let s = sq_get(in t, i);
        if !s.sacked && !s.lost {
            p = sat_add32(p, seg_bytes(s));
        }
    }
    if is_some(t.recovery_point) && !t.sack_ok {
        // RFC 6582: each duplicate ACK signals a segment left the network
        // (the window-inflation equivalent for pipe).
        p = sat_sub32(p, sat_mul32(t.dupacks, t.smss));
    }
    p
}

fn set_send_mss(inout t: Tcb) {
    let base = if t.peer_mss < min_send_mss() {
        min_send_mss()
    } else {
        t.peer_mss
    };
    let capped = if base > t.cfg.mss {
        t.cfg.mss
    } else {
        base
    };
    let ts: u32 = if t.ts_ok {
        12
    } else {
        0
    };
    t.smss = wrapping_sub(widen_u32(capped), ts);
    let m = t.smss;
    cc_cmd(inout t, CcCmd::Mss(m));
}

fn negotiate(inout t: Tcb, opts: Opts, ips: Ips) {
    t.peer_mss = match opts.mss {
        Option::Some(m) => m,
        Option::None => ips_default_mss(ips),
    };
    let mut ws = false;
    match t.cfg.window_scale {
        Option::Some(ours) => match opts.window_scale {
            Option::Some(theirs) => {
                t.snd_wscale = if theirs > 14 {
                    14
                } else {
                    theirs
                };
                t.rcv_wscale = ours;
                t.ws_ok = true;
                ws = true;
            },
            Option::None => (),
        },
        Option::None => (),
    }
    if !ws {
        t.snd_wscale = 0;
        t.rcv_wscale = 0;
        t.ws_ok = false;
    }
    t.sack_ok = t.cfg.sack && opts.sack_permitted;
    match opts.timestamps {
        Option::Some(ts) => {
            t.ts_ok = t.cfg.timestamps;
            if t.ts_ok {
                t.ts_recent = ts.val;
                t.ts_recent_valid = true;
            }
        },
        Option::None => {
            t.ts_ok = false;
        },
    }
    set_send_mss(inout t);
}

fn queue_rst_reply(inout t: Tcb, ips_in: Ips, seg: Parsed, seq_len: u32) {
    // RFC 9293 §3.10.7.1: <SEQ=SEG.ACK><CTL=RST> if ACK is set, else
    // <SEQ=0><ACK=SEG.SEQ+SEG.LEN><CTL=RST,ACK>.
    let with_ack = has(seg.flags, ack_bit());
    t.pending_rst = Option::Some(
        RstSpec {
            ips: ips_reversed(ips_in),
            src_port: seg.dst_port,
            dst_port: seg.src_port,
            seq: if with_ack {
                seg.ack
            } else {
                0
            },
            ack: if with_ack {
                Option::None
            } else {
                Option::Some(sn_add(seg.seq, seq_len))
            }
        }
    );
}

fn challenge_ack(inout t: Tcb, now: u64) {
    if sat_sub64(now, t.challenge_window_ns) >= 1000000000 {
        t.challenge_window_ns = now;
        t.challenge_count = 0;
    }
    if t.challenge_count < t.cfg.challenge_ack_limit {
        t.challenge_count = wrapping_add(t.challenge_count, 1);
        t.stats.challenge_acks = wrapping_add(t.stats.challenge_acks, 1);
        t.ack_now = true;
    } else {
        t.stats.challenge_acks_suppressed = wrapping_add(t.stats.challenge_acks_suppressed, 1);
    }
}

// ----------------------------------------------------------------
// Segment arrival (RFC 9293 §3.10.7)
// ----------------------------------------------------------------

// A parsed segment and its payload `bytes[pay_off..pay_off + pay_len]`.
copy struct Seg {
    h: Parsed,
    pay_off: u64,
    pay_len: u64
}

fn copy_into(in src: Slice[u8], from: u64, inout dst: Slice[u8], at: u64, n: u64) {
    for k in 0..n {
        match src.try_get(wrapping_add(from, k)) {
            Option::Some(b) => {
                dst.try_set(wrapping_add(at, k), b);
            },
            Option::None => (),
        }
    }
}

fn wire_err[T](e: WireError) -> Result[T, TcpFail] {
    Result::Err(TcpFail::Wire(e))
}

pub fn tcb_on_segment(inout t: Tcb, now: u64, ips: Ips, in bytes: Slice[u8], inout ring: Slice[u8]) -> Result[RecvOut, TcpFail] {
    t.cmds.clear();
    if ring.len() != widen_u64(t.cfg.recv_buffer) {
        return Result::Err(TcpFail::RingSizeMismatch);
    }
    match verify_checksum(ips, in bytes) {
        Result::Err(e) => {
            return Result::Err(TcpFail::Wire(e));
        },
        Result::Ok(u) => (),
    }
    let h = match segment_parse(in bytes) {
        Result::Err(e) => {
            return Result::Err(TcpFail::Wire(e));
        },
        Result::Ok(h) => h,
    };
    if h.dst_port != t.cfg.local_port {
        return Result::Err(TcpFail::NotForThisConnection);
    }
    if !(t.st == State::Closed || t.st == State::Listen) {
        let same = match t.ips {
            Option::Some(mine) => ips_eq(mine, ips_reversed(ips)),
            Option::None => false,
        };
        if h.src_port != t.remote_port || !same {
            return Result::Err(TcpFail::NotForThisConnection);
        }
    }
    let seg = Seg {
        h: h,
        pay_off: h.header_len,
        pay_len: wrapping_sub(bytes.len(), h.header_len)
    };
    if t.st == State::Closed {
        if !has(h.flags, rst_bit()) {
            queue_rst_reply(inout t, ips, h, segment_seq_len(h.flags, seg.pay_len));
        }
        Result::Ok(no_recv())
    } else if t.st == State::Listen {
        on_listen(inout t, now, ips, seg);
        Result::Ok(no_recv())
    } else if t.st == State::SynSent {
        Result::Ok(on_syn_sent(inout t, now, ips, seg, in bytes, inout ring))
    } else {
        Result::Ok(on_synchronized(inout t, now, seg, in bytes, inout ring))
    }
}

fn on_listen(inout t: Tcb, now: u64, ips: Ips, seg: Seg) {
    let f = seg.h.flags;
    if has(f, rst_bit()) {
        return;
    }
    if has(f, ack_bit()) {
        queue_rst_reply(inout t, ips, seg.h, segment_seq_len(f, seg.pay_len));
        return;
    }
    if !has(f, syn_bit()) {
        return;
    }
    t.ips = Option::Some(ips_reversed(ips));
    t.remote_port = seg.h.src_port;
    t.rcv_isn = seg.h.seq;
    t.have_irs = true;
    t.rcv_nxt = 1;
    t.rcv_adv_right = 1;
    t.last_ack_sent = 1;
    t.snd_isn = clock_iss(in t, now);
    negotiate(inout t, seg.h.options, ips);
    // The window in a SYN is never scaled (RFC 7323 §2.2).
    t.snd_wnd = widen_u32(seg.h.window);
    t.max_snd_wnd = t.snd_wnd;
    t.snd_wl1 = seg.h.seq;
    t.snd_wl2 = seqmap_seq(t.snd_isn, 0);
    t.need_syn = true;
    t.st = State::SynReceived;
    // Data and FIN carried on the SYN are not acknowledged and will be
    // retransmitted by the peer (RFC 9293 permits queueing; we drop).
}

fn mark_first_lost(inout t: Tcb) {
    if t.sent_len > 0 {
        let mut e = sq_get(in t, 0);
        e.lost = true;
        sq_set(inout t, 0, e);
        t.force_retx = true;
    }
}

fn on_syn_sent(inout t: Tcb, now: u64, ips: Ips, seg: Seg, in bytes: Slice[u8], inout ring: Slice[u8]) -> RecvOut {
    let f = seg.h.flags;
    let mut acceptable_ack = false;
    if has(f, ack_bit()) {
        let iss = t.snd_isn;
        if sn_le(seg.h.ack, iss) || sn_gt(seg.h.ack, seqmap_seq(t.snd_isn, t.snd_nxt)) {
            if !has(f, rst_bit()) {
                queue_rst_reply(inout t, ips, seg.h, segment_seq_len(f, seg.pay_len));
            }
            return no_recv();
        }
        acceptable_ack = true;
    }
    if has(f, rst_bit()) {
        if acceptable_ack {
            enter_closed(inout t, Option::Some(CloseReason::Refused));
        }
        return no_recv();
    }
    if !has(f, syn_bit()) {
        return no_recv();
    }
    t.rcv_isn = seg.h.seq;
    t.have_irs = true;
    t.rcv_nxt = 1;
    t.rcv_adv_right = 1;
    t.last_ack_sent = 1;
    negotiate(inout t, seg.h.options, ips);
    t.snd_wnd = widen_u32(seg.h.window);
    t.max_snd_wnd = t.snd_wnd;
    t.snd_wl1 = seg.h.seq;
    t.snd_wl2 = seg.h.ack;
    if acceptable_ack {
        let ack_abs = match seqmap_abs(t.snd_isn, t.snd_una, seg.h.ack) {
            Option::Some(a) => a,
            Option::None => 1,
        };
        advance_una(inout t, now, ack_abs);
        enter_established(inout t);
        t.ack_now = true;
        // Data or FIN on the SYN-ACK continue at the sixth step.
        let mut rec = accept_text(inout t, now, seg, in bytes, inout ring);
        let fin = process_fin(inout t, now, seg);
        rec.fin = rec.fin || fin;
        rec
    } else {
        // Simultaneous open: resend our SYN as SYN,ACK.
        t.st = State::SynReceived;
        mark_first_lost(inout t);
        no_recv()
    }
}

fn rst_to_peer(inout t: Tcb, seq: u32) {
    t.pending_rst = Option::Some(
        RstSpec {
            ips: some_ips(t.ips),
            src_port: t.cfg.local_port,
            dst_port: t.remote_port,
            seq: seq,
            ack: Option::None
        }
    );
}

fn on_synchronized(inout t: Tcb, now: u64, seg0: Seg, in bytes: Slice[u8], inout ring: Slice[u8]) -> RecvOut {
    let mut seg = seg0;
    let f = seg.h.flags;
    let is_rst = has(f, rst_bit());

    // RFC 7323 §3.2 and §5.3 (PAWS).
    if t.ts_ok && !is_rst {
        match seg.h.options.timestamps {
            Option::None => {
                t.stats.paws_dropped = wrapping_add(t.stats.paws_dropped, 1);
                return no_recv();
            },
            Option::Some(ts) => {
                if t.ts_recent_valid && sn_lt(ts.val, t.ts_recent) {
                    t.stats.paws_dropped = wrapping_add(t.stats.paws_dropped, 1);
                    t.ack_now = true;
                    return no_recv();
                }
            },
        }
    }

    // Duplicate SYN while our SYN,ACK is unacknowledged: resend it.
    if t.st == State::SynReceived && has(f, syn_bit()) && !has(f, ack_bit()) && !is_rst && seg.h.seq == t.rcv_isn {
        mark_first_lost(inout t);
        return no_recv();
    }

    // First: sequence-number acceptability (RFC 9293 §3.10.7.4).
    let seg_len = segment_seq_len(f, seg.pay_len);
    let rcv_wnd = recv_window(in t);
    let nxt = seqmap_seq(t.rcv_isn, t.rcv_nxt);
    let hi = sn_add(nxt, rcv_wnd);
    let acceptable = if seg_len == 0 {
        if rcv_wnd == 0 {
            seg.h.seq == nxt
        } else {
            sn_in_window(seg.h.seq, nxt, hi)
        }
    } else if rcv_wnd == 0 {
        false
    } else {
        sn_in_window(seg.h.seq, nxt, hi) || sn_in_window(sn_add(seg.h.seq, wrapping_sub(seg_len, 1)), nxt, hi)
    };
    if !acceptable {
        if is_rst {
            return no_recv();
        }
        t.ack_now = true;
        if t.st == State::TimeWait && has(f, fin_bit()) {
            t.time_wait_deadline = Option::Some(sat_add64(now, t.cfg.time_wait_ns));
        }
        // Zero window: still honour valid ACK/RST information.
        if rcv_wnd == 0 && seg.h.seq == nxt {
            seg.pay_len = 0;
            seg.h.flags = seg.h.flags & ~(fin_bit() | syn_bit());
        } else {
            return no_recv();
        }
    }

    // RFC 7323 §4.3: update TS.Recent.
    if t.ts_ok {
        match seg.h.options.timestamps {
            Option::Some(ts) => {
                let last = seqmap_seq(t.rcv_isn, t.last_ack_sent);
                if sn_le(seg.h.seq, last) && (!t.ts_recent_valid || sn_ge(ts.val, t.ts_recent)) {
                    t.ts_recent = ts.val;
                    t.ts_recent_valid = true;
                }
            },
            Option::None => (),
        }
    }

    // Second: RST (RFC 5961 §3.2).
    if is_rst {
        if seg.h.seq == nxt {
            let s = t.st;
            if s == State::SynReceived && t.passive {
                let iss_base = t.iss_base;
                reset_tcb(inout t);
                t.iss_base = iss_base;
                t.passive = true;
                t.st = State::Listen;
            } else if s == State::SynReceived {
                enter_closed(inout t, Option::Some(CloseReason::Refused));
            } else if s == State::Established || s == State::FinWait1 || s == State::FinWait2 || s == State::CloseWait {
                enter_closed(inout t, Option::Some(CloseReason::Reset));
            } else {
                enter_closed(inout t, Option::None);
            }
        } else {
            challenge_ack(inout t, now);
        }
        return no_recv();
    }

    // Fourth: SYN in a synchronized state (RFC 5961 §4.2).
    if has(seg.h.flags, syn_bit()) {
        challenge_ack(inout t, now);
        return no_recv();
    }

    // Fifth: ACK.
    if !has(f, ack_bit()) {
        return no_recv();
    }
    let una = seqmap_seq(t.snd_isn, t.snd_una);
    let snd_nxt = seqmap_seq(t.snd_isn, t.snd_nxt);
    if sn_gt(seg.h.ack, snd_nxt) {
        if t.st == State::SynReceived {
            rst_to_peer(inout t, seg.h.ack);
        } else {
            t.ack_now = true;
        }
        return no_recv();
    }
    let zero: u32 = 0;
    if sn_lt(seg.h.ack, sn_add(una, wrapping_sub(zero, t.max_snd_wnd))) {
        challenge_ack(inout t, now);
        return no_recv();
    }
    if t.st == State::SynReceived {
        if sn_lt(una, seg.h.ack) && sn_le(seg.h.ack, snd_nxt) {
            t.snd_wnd = shl32(widen_u32(seg.h.window), widen_u64(t.snd_wscale));
            t.max_snd_wnd = max32(t.max_snd_wnd, t.snd_wnd);
            t.snd_wl1 = seg.h.seq;
            t.snd_wl2 = seg.h.ack;
            enter_established(inout t);
        } else {
            rst_to_peer(inout t, seg.h.ack);
            return no_recv();
        }
    }
    if t.st != State::TimeWait {
        handle_ack(inout t, now, seg);
    }
    if t.st == State::FinWait1 {
        if fin_acked(in t) {
            t.st = State::FinWait2;
        }
    } else if t.st == State::Closing {
        if fin_acked(in t) {
            enter_time_wait(inout t, now);
        } else {
            return no_recv();
        }
    } else if t.st == State::LastAck {
        if fin_acked(in t) {
            enter_closed(inout t, Option::None);
            return no_recv();
        }
    }

    // Sixth: URG (recorded; data is delivered inline).
    let s = t.st;
    let urgent_ok = has(f, urg_bit()) && (s == State::Established || s == State::FinWait1 || s == State::FinWait2);
    if urgent_ok {
        match seqmap_abs(t.rcv_isn, t.rcv_nxt, sn_add(seg.h.seq, widen_u32(seg.h.urgent))) {
            Option::Some(abs) => {
                let off = sat_sub64(abs, 1);
                t.urgent_off = match t.urgent_off {
                    Option::Some(u) => Option::Some(max64(u, off)),
                    Option::None => Option::Some(off),
                };
            },
            Option::None => (),
        }
    }

    // Seventh and eighth: text and FIN.
    let mut rec = accept_text(inout t, now, seg, in bytes, inout ring);
    let fin = process_fin(inout t, now, seg);
    rec.fin = rec.fin || fin;
    if !rec.fin {
        let at_fin = match t.ooo_fin {
            Option::Some(p) => p == t.rcv_nxt,
            Option::None => false,
        };
        if at_fin {
            rec.fin = consume_fin(inout t, now);
        }
    }
    rec
}

fn opt_eq(a: Option[u64], b: u64) -> bool {
    match a {
        Option::Some(v) => v == b,
        Option::None => false,
    }
}

// Cumulative acknowledgment up to `ack_abs` (> snd_una).
fn advance_una(inout t: Tcb, now: u64, ack_abs: u64) {
    if ack_abs <= t.snd_una {
        return;
    }
    let mut sample: Option[u64] = Option::None;
    loop {
        if t.sent_len == 0 {
            break;
        }
        let front = sq_get(in t, 0);
        if front.end <= ack_abs {
            if opt_eq(t.timed, front.pn) {
                if front.retransmits == 0 {
                    sample = Option::Some(sat_sub64(now, front.sent_ns));
                }
                t.timed = Option::None;
            }
            // Remove first so the event reports post-ACK bytes in flight.
            sq_pop_front(inout t);
            if !front.sacked {
                report_acked(inout t, now, front, seg_bytes(front));
            }
        } else if front.start < ack_abs {
            // Partial acknowledgment of a segment.
            let part = wrapping_u32(wrapping_sub(ack_abs, front.start));
            let mut cut = front;
            cut.start = ack_abs;
            sq_set(inout t, 0, cut);
            if !front.sacked {
                report_acked(inout t, now, front, part);
            }
            break;
        } else {
            break;
        }
    }
    t.snd_una = ack_abs;
    match t.timed {
        Option::Some(p) => {
            let mut found = false;
            for i in 0..t.sent_len {
                if sq_get(in t, i).pn == p {
                    found = true;
                }
            }
            if !found {
                t.timed = Option::None;
            }
        },
        Option::None => (),
    }
    match sample {
        Option::Some(r) => {
            rtt_sample(inout t.rtt, r);
            let s = RttSample {
                latest_ns: t.rtt.latest_ns,
                min_ns: t.rtt.min_ns,
                smoothed_ns: t.rtt.srtt_ns,
                ack_delay_ns: 0
            };
            cc_cmd(inout t, CcCmd::Rtt(s));
        },
        Option::None => (),
    }
    t.retries = 0;
    t.rto_deadline = if t.sent_len == 0 {
        Option::None
    } else {
        Option::Some(sat_add64(now, rtt_rto_ns(t.rtt)))
    };
}

fn report_acked(inout t: Tcb, now: u64, s: SentSeg, bytes: u32) {
    let packet = AckedPacket {
        pn: s.pn,
        sent_ns: s.sent_ns,
        bytes: bytes
    };
    let bytes_in_flight = pipe(in t);
    cc_event(inout t, CongestionEvent::Acked {
        packet: packet,
        bytes_in_flight: bytes_in_flight
    }, now);
}

fn mark_lost(inout t: Tcb, now: u64, i: u64) {
    let s = sq_get(in t, i);
    if s.lost || s.sacked {
        return;
    }
    let bytes_in_flight = pipe(in t);
    let mut e = s;
    e.lost = true;
    sq_set(inout t, i, e);
    let packet = LostPacket {
        pn: s.pn,
        sent_ns: s.sent_ns,
        bytes: seg_bytes(s)
    };
    cc_event(inout t, CongestionEvent::Lost {
        packet: packet,
        bytes_in_flight: bytes_in_flight
    }, now);
}

fn enter_recovery(inout t: Tcb) {
    if !is_some(t.recovery_point) {
        t.recovery_point = Option::Some(t.snd_nxt);
        t.stats.recoveries = wrapping_add(t.stats.recoveries, 1);
        t.force_retx = true;
    }
}

fn handle_ack(inout t: Tcb, now: u64, seg: Seg) {
    let ack_abs = match seqmap_abs(t.snd_isn, t.snd_una, seg.h.ack) {
        Option::Some(a) => min64(a, t.snd_nxt),
        Option::None => {
            return;
        },
    };
    let new_wnd = shl32(widen_u32(seg.h.window), widen_u64(t.snd_wscale));
    let old_wnd = t.snd_wnd;
    let prev_una = t.snd_una;

    // Duplicate-ACK test (RFC 5681 §2) before the window update.
    let is_dup = ack_abs == prev_una && seg.pay_len == 0 && !has(seg.h.flags, syn_bit()) && !has(seg.h.flags, fin_bit()) && new_wnd == old_wnd && t.sent_len > 0;

    // Window update (RFC 9293 §3.10.7.4, SND.WL1/WL2).
    if sn_lt(t.snd_wl1, seg.h.seq) || (t.snd_wl1 == seg.h.seq && sn_le(t.snd_wl2, seg.h.ack)) {
        t.snd_wnd = new_wnd;
        t.max_snd_wnd = max32(t.max_snd_wnd, new_wnd);
        t.snd_wl1 = seg.h.seq;
        t.snd_wl2 = seg.h.ack;
        if old_wnd == 0 && new_wnd > 0 {
            t.persist_deadline = Option::None;
            t.persist_backoff = 0;
            t.probe_due = false;
        }
    }

    if ack_abs > prev_una {
        advance_una(inout t, now, ack_abs);
        match t.recovery_point {
            Option::Some(rp) => {
                if t.snd_una >= rp {
                    t.recovery_point = Option::None;
                    t.dupacks = 0;
                    for i in 0..t.sent_len {
                        let mut e = sq_get(in t, i);
                        e.rexmit_in_recovery = false;
                        sq_set(inout t, i, e);
                    }
                } else if !t.sack_ok && t.sent_len > 0 {
                    // RFC 6582 partial ACK: retransmit the next hole.
                    t.dupacks = 0;
                    mark_lost(inout t, now, 0);
                    t.force_retx = true;
                }
            },
            Option::None => {
                t.dupacks = 0;
            },
        }
    } else if is_dup {
        t.dupacks = sat_add32(t.dupacks, 1);
        t.stats.dup_acks = wrapping_add(t.stats.dup_acks, 1);
    }

    if t.sack_ok {
        apply_sack(inout t, now, seg.h.options);
        scoreboard_losses(inout t, now);
    }
    if t.dupacks >= dup_thresh() && !is_some(t.recovery_point) && t.sent_len > 0 {
        mark_lost(inout t, now, 0);
        enter_recovery(inout t);
    }
}

fn apply_sack(inout t: Tcb, now: u64, opts: Opts) {
    for k in 0..sack_count(opts) {
        let b = opts_blk(opts, k);
        match seqmap_abs(t.snd_isn, t.snd_una, b.left) {
            Option::Some(l) => match seqmap_abs(t.snd_isn, t.snd_una, b.right) {
                Option::Some(r) => {
                    // Ignore blocks outside SND.UNA..SND.NXT (incl. D-SACK).
                    if !(l <= t.snd_una || r > t.snd_nxt || l >= r) {
                        for i in 0..t.sent_len {
                            let s = sq_get(in t, i);
                            if s.start >= r {
                                break;
                            }
                            if s.start >= l && s.end <= r && !s.sacked {
                                let mut e = s;
                                e.sacked = true;
                                e.lost = false;
                                sq_set(inout t, i, e);
                                report_acked(inout t, now, s, seg_bytes(s));
                            }
                        }
                    }
                },
                Option::None => (),
            },
            Option::None => (),
        }
    }
}

// RFC 6675 IsLost over the scoreboard (single reverse pass).
fn scoreboard_losses(inout t: Tcb, now: u64) {
    let mut sacked_count: u32 = 0;
    let mut sacked_bytes: u64 = 0;
    let mut any = false;
    let limit = wrapping_mul(widen_u64(wrapping_sub(dup_thresh(), 1)), widen_u64(t.smss));
    let n = t.sent_len;
    for j in 0..n {
        let i = wrapping_sub(wrapping_sub(n, 1), j);
        let s = sq_get(in t, i);
        if s.sacked {
            sacked_count = wrapping_add(sacked_count, 1);
            sacked_bytes = wrapping_add(sacked_bytes, widen_u64(seg_bytes(s)));
        } else if !s.lost && !s.rexmit_in_recovery && (sacked_count >= dup_thresh() || sacked_bytes > limit) {
            mark_lost(inout t, now, i);
            any = true;
        }
    }
    if any {
        enter_recovery(inout t);
    }
}

// Seventh step: accept segment text into the stream.
fn accept_text(inout t: Tcb, now: u64, seg: Seg, in bytes: Slice[u8], inout ring: Slice[u8]) -> RecvOut {
    let mut rec = no_recv();
    let s = t.st;
    if !(s == State::Established || s == State::FinWait1 || s == State::FinWait2) || seg.pay_len == 0 {
        return rec;
    }
    let mut start = match seqmap_abs(t.rcv_isn, t.rcv_nxt, seg.h.seq) {
        Option::Some(a) => a,
        Option::None => {
            return rec;
        },
    };
    if has(seg.h.flags, syn_bit()) {
        start = wrapping_add(start, 1);
    }
    let mut p_off = seg.pay_off;
    let mut p_len = seg.pay_len;
    let right = recv_right(in t);
    if start < t.rcv_nxt {
        let skip = wrapping_sub(t.rcv_nxt, start);
        if skip >= p_len {
            t.ack_now = true;
            return rec;
        }
        p_off = wrapping_add(p_off, skip);
        p_len = wrapping_sub(p_len, skip);
        start = t.rcv_nxt;
    }
    if start >= right {
        t.ack_now = true;
        return rec;
    }
    p_len = min64(wrapping_sub(right, start), p_len);
    let end = wrapping_add(start, p_len);
    let cap = widen_u64(t.cfg.recv_buffer);

    if start == t.rcv_nxt {
        rec.seg_start = p_off;
        rec.seg_len = p_len;
        t.rcv_nxt = end;
        let had_ooo = t.ooo.len() > 0;
        // Pull any buffered range that now continues the stream.
        let mut pull: Option[u64] = Option::None;
        let mut i: u64 = 0;
        loop {
            if i >= t.ooo.len() {
                break;
            }
            let r = ooo_at(in t, i);
            if r.end <= t.rcv_nxt {
                ooo_remove(inout t, i);
            } else if r.start <= t.rcv_nxt {
                pull = Option::Some(r.end);
                ooo_remove(inout t, i);
            } else {
                i = wrapping_add(i, 1);
            }
        }
        match pull {
            Option::Some(pend) => {
                let from = t.rcv_nxt;
                let p0 = rem64(wrapping_sub(from, 1), cap);
                let len = wrapping_sub(pend, from);
                let first = min64(len, wrapping_sub(ring.len(), p0));
                rec.ring_start = p0;
                rec.ring_len1 = first;
                rec.ring_len2 = wrapping_sub(len, first);
                t.rcv_nxt = pend;
            },
            Option::None => (),
        }
        match t.ooo_fin {
            Option::Some(fpos) => {
                if fpos < t.rcv_nxt {
                    // Data beyond a recorded FIN is a protocol violation;
                    // the FIN position is discarded rather than trusted.
                    t.ooo_fin = Option::None;
                }
            },
            Option::None => (),
        }
        if had_ooo {
            t.ack_now = true;
        } else {
            schedule_ack(inout t, now);
        }
    } else {
        // Out of order: copy into the ring at its stream position.
        if !insert_ooo(inout t, start, end) {
            t.stats.ooo_dropped = wrapping_add(t.stats.ooo_dropped, 1);
        } else {
            let p0 = rem64(wrapping_sub(start, 1), cap);
            let first = min64(p_len, wrapping_sub(ring.len(), p0));
            copy_into(in bytes, p_off, inout ring, p0, first);
            copy_into(in bytes, wrapping_add(p_off, first), inout ring, 0, wrapping_sub(p_len, first));
        }
        t.ack_now = true;
    }
    rec
}

fn schedule_ack(inout t: Tcb, now: u64) {
    t.ack_pending = wrapping_add(t.ack_pending, 1);
    if t.cfg.delayed_ack_ns == 0 || t.ack_pending >= 2 {
        t.ack_now = true;
    } else if !is_some(t.delack_deadline) {
        t.delack_deadline = Option::Some(sat_add64(now, t.cfg.delayed_ack_ns));
    }
}

// Insert `[start, end)` into the out-of-order table, merging. Returns false
// when the table is full and the range touches no existing one.
fn insert_ooo(inout t: Tcb, start: u64, end: u64) -> bool {
    t.ooo_stamp = wrapping_add(t.ooo_stamp, 1);
    let stamp = t.ooo_stamp;
    let mut ns = start;
    let mut ne = end;
    let mut merged = false;
    let mut i: u64 = 0;
    loop {
        if i >= t.ooo.len() {
            break;
        }
        let r = ooo_at(in t, i);
        if r.start <= ne && ns <= r.end {
            ns = min64(ns, r.start);
            ne = max64(ne, r.end);
            ooo_remove(inout t, i);
            merged = true;
        } else {
            i = wrapping_add(i, 1);
        }
    }
    if !merged && t.ooo.len() >= widen_u64(t.cfg.max_ooo_ranges) {
        return false;
    }
    // Capacity is reserved at construction; this push never reallocates.
    t.ooo.push(OooRange {
        start: ns,
        end: ne,
        stamp: stamp
    });
    true
}

// Eighth step: FIN. Returns whether a FIN was consumed.
fn process_fin(inout t: Tcb, now: u64, seg: Seg) -> bool {
    if !has(seg.h.flags, fin_bit()) || !state_is_synchronized(t.st) {
        return false;
    }
    let s = t.st;
    if !(s == State::Established || s == State::FinWait1 || s == State::FinWait2 || s == State::SynReceived) {
        // CLOSE-WAIT, CLOSING, LAST-ACK: remain; TIME-WAIT: restart.
        if s == State::TimeWait {
            t.time_wait_deadline = Option::Some(sat_add64(now, t.cfg.time_wait_ns));
        }
        t.ack_now = true;
        return false;
    }
    let mut seg_start = match seqmap_abs(t.rcv_isn, t.rcv_nxt, seg.h.seq) {
        Option::Some(a) => a,
        Option::None => {
            return false;
        },
    };
    if has(seg.h.flags, syn_bit()) {
        seg_start = wrapping_add(seg_start, 1);
    }
    let fin_pos = wrapping_add(seg_start, seg.pay_len);
    t.ack_now = true;
    if fin_pos > t.rcv_nxt {
        if fin_pos <= recv_right(in t) {
            t.ooo_fin = Option::Some(fin_pos);
        }
        return false;
    }
    if fin_pos < t.rcv_nxt {
        return false;
    }
    consume_fin(inout t, now)
}

fn consume_fin(inout t: Tcb, now: u64) -> bool {
    t.rcv_nxt = wrapping_add(t.rcv_nxt, 1);
    t.fin_received = true;
    t.ooo_fin = Option::None;
    t.events = t.events | ev_peer_fin();
    t.ack_now = true;
    t.delack_deadline = Option::None;
    let s = t.st;
    if s == State::SynReceived || s == State::Established {
        t.st = State::CloseWait;
    } else if s == State::FinWait1 {
        if fin_acked(in t) {
            enter_time_wait(inout t, now);
        } else {
            t.st = State::Closing;
        }
    } else if s == State::FinWait2 {
        enter_time_wait(inout t, now);
    }
    true
}

// ----------------------------------------------------------------
// Timers
// ----------------------------------------------------------------

fn due(d: Option[u64], now: u64) -> bool {
    match d {
        Option::Some(v) => v <= now,
        Option::None => false,
    }
}

// Fire every timer whose deadline is at or before `now`.
pub fn tcb_on_timeout(inout t: Tcb, now: u64) {
    t.cmds.clear();
    if due(t.delack_deadline, now) {
        t.delack_deadline = Option::None;
        t.ack_now = true;
    }
    if due(t.time_wait_deadline, now) {
        t.time_wait_deadline = Option::None;
        if t.st == State::TimeWait {
            enter_closed(inout t, Option::None);
        }
        return;
    }
    if due(t.persist_deadline, now) {
        t.persist_deadline = Option::None;
        t.probe_due = true;
    }
    if due(t.rto_deadline, now) {
        on_rto(inout t, now);
    }
}

fn on_rto(inout t: Tcb, now: u64) {
    t.rto_deadline = Option::None;
    if t.sent_len == 0 {
        return;
    }
    t.stats.rtos = wrapping_add(t.stats.rtos, 1);
    let probing = t.snd_wnd == 0 && state_is_synchronized(t.st);
    if !probing {
        t.retries = wrapping_add(t.retries, 1);
        if t.retries > t.cfg.max_retransmits {
            enter_closed(inout t, Option::Some(CloseReason::TimedOut));
            return;
        }
        cc_event(inout t, CongestionEvent::PersistentCongestion, now);
    }
    // RFC 2018 §8: forget SACK state after a timeout.
    for i in 0..t.sent_len {
        let mut e = sq_get(in t, i);
        e.sacked = false;
        e.lost = true;
        e.rexmit_in_recovery = false;
        sq_set(inout t, i, e);
    }
    t.recovery_point = Option::Some(t.snd_nxt);
    t.dupacks = 0;
    t.timed = Option::None;
    t.force_retx = true;
    rtt_backoff(inout t.rtt);
    t.rto_deadline = Option::Some(sat_add64(now, rtt_rto_ns(t.rtt)));
}

// ----------------------------------------------------------------
// Transmission
// ----------------------------------------------------------------

fn some_tx(r: Result[Tx, TcpFail]) -> Result[Option[Tx], TcpFail] {
    match r {
        Result::Ok(tx) => Result::Ok(Option::Some(tx)),
        Result::Err(e) => Result::Err(e),
    }
}

// Write the next segment to send into `out`, if any. `cwnd` is the
// controller's congestion window; `send` holds stream offsets
// `send_base..`.
pub fn tcb_poll_transmit(inout t: Tcb, now: u64, cwnd: u32, send_base: u64, in send: Slice[u8], inout out: Slice[u8]) -> Result[Option[Tx], TcpFail] {
    t.edt_entry = Option::None;
    t.edt_armed_rto = false;
    if out.len() < 60 {
        return Result::Err(TcpFail::BufferTooSmall);
    }
    match t.pending_rst {
        Option::Some(rst) => {
            t.pending_rst = Option::None;
            let flags = match rst.ack {
                Option::Some(a) => rst_bit() | ack_bit(),
                Option::None => rst_bit(),
            };
            let h = Hdr {
                src_port: rst.src_port,
                dst_port: rst.dst_port,
                seq: rst.seq,
                ack: match rst.ack {
                    Option::Some(a) => a,
                    Option::None => 0,
                },
                flags: flags,
                window: 0,
                urgent: 0
            };
            let n = match write_header(inout out, h, opts_default()) {
                Result::Ok(n) => n,
                Result::Err(e) => {
                    return wire_err(e);
                },
            };
            match fill_checksum_n(rst.ips, inout out, n) {
                Result::Ok(u) => (),
                Result::Err(e) => {
                    return wire_err(e);
                },
            }
            t.stats.segments_sent = wrapping_add(t.stats.segments_sent, 1);
            return Result::Ok(Option::Some(
                Tx {
                    len: n,
                    edt_ns: now,
                    ips: rst.ips,
                    entry: false,
                    pn: 0,
                    bytes: 0
                }
            ));
        },
        Option::None => (),
    }
    if t.st == State::Closed || t.st == State::Listen {
        return Result::Ok(Option::None);
    }
    if t.need_syn {
        let mut syn = no_seg();
        syn.end = 1;
        syn.syn = true;
        if !sq_push(inout t, syn) {
            return Result::Ok(Option::None);
        }
        t.need_syn = false;
        t.snd_nxt = max64(t.snd_nxt, 1);
        return some_tx(emit_entry(inout t, now, 0, send_base, in send, inout out, false));
    }
    if t.st != State::TimeWait {
        match try_retransmit(inout t, now, cwnd, send_base, in send, inout out) {
            Result::Err(e) => {
                return Result::Err(e);
            },
            Result::Ok(o) => match o {
                Option::Some(tx) => {
                    return Result::Ok(Option::Some(tx));
                },
                Option::None => (),
            },
        }
        match try_new_data(inout t, now, cwnd, send_base, in send, inout out) {
            Result::Err(e) => {
                return Result::Err(e);
            },
            Result::Ok(o) => match o {
                Option::Some(tx) => {
                    return Result::Ok(Option::Some(tx));
                },
                Option::None => (),
            },
        }
    }
    if t.ack_now && t.have_irs && t.st != State::SynSent {
        return some_tx(emit_ack(inout t, now, inout out));
    }
    Result::Ok(Option::None)
}

// The wrapper's controller scheduled the segment `tcb_poll_transmit` just
// wrote for `edt_ns` (later than `now`): record it as the send time.
pub fn tcb_commit_edt(inout t: Tcb, edt_ns: u64) {
    match t.edt_entry {
        Option::Some(i) => {
            let mut e = sq_get(in t, i);
            e.sent_ns = edt_ns;
            sq_set(inout t, i, e);
            if t.edt_armed_rto {
                t.rto_deadline = Option::Some(sat_add64(edt_ns, rtt_rto_ns(t.rtt)));
            }
        },
        Option::None => (),
    }
    t.edt_entry = Option::None;
    t.edt_armed_rto = false;
}

fn try_retransmit(inout t: Tcb, now: u64, cwnd: u32, send_base: u64, in send: Slice[u8], inout out: Slice[u8]) -> Result[Option[Tx], TcpFail] {
    let mut found: Option[u64] = Option::None;
    for i in 0..t.sent_len {
        let s = sq_get(in t, i);
        if s.lost && !s.sacked {
            found = Option::Some(i);
            break;
        }
    }
    match found {
        Option::None => {
            t.force_retx = false;
            Result::Ok(Option::None)
        },
        Option::Some(i) => {
            if !(t.force_retx || pipe(in t) < cwnd || sq_get(in t, i).syn) {
                return Result::Ok(Option::None);
            }
            t.force_retx = false;
            some_tx(emit_entry(inout t, now, i, send_base, in send, inout out, true))
        },
    }
}

fn try_new_data(inout t: Tcb, now: u64, cwnd: u32, send_base: u64, in send: Slice[u8], inout out: Slice[u8]) -> Result[Option[Tx], TcpFail] {
    // Data may flow once our SYN is acknowledged.
    let s = t.st;
    if !(s == State::Established || s == State::FinWait1 || s == State::Closing || s == State::CloseWait || s == State::LastAck) {
        return Result::Ok(Option::None);
    }
    if is_some(t.fin_abs) || t.sent_len == t.sent_cap {
        return Result::Ok(Option::None);
    }
    let data_end = wrapping_add(1, t.write_end);
    let unsent = sat_sub64(data_end, t.snd_nxt);
    let wnd_right = wrapping_add(t.snd_una, widen_u64(t.snd_wnd));
    let usable = sat_sub64(wnd_right, t.snd_nxt);
    if unsent == 0 {
        if !t.fin_requested {
            return Result::Ok(Option::None);
        }
        // FIN occupies sequence space, so it needs one octet of window;
        // against a zero window it goes out as the persist probe.
        if usable > 0 {
            return some_tx(emit_new(inout t, now, 0, true, send_base, in send, inout out));
        }
        if t.snd_wnd == 0 && t.sent_len == 0 {
            if t.probe_due {
                t.probe_due = false;
                t.stats.window_probes = wrapping_add(t.stats.window_probes, 1);
                return some_tx(emit_new(inout t, now, 0, true, send_base, in send, inout out));
            }
            arm_persist(inout t, now);
        }
        return Result::Ok(Option::None);
    }
    let p = pipe(in t);
    let cwnd_room = widen_u64(sat_sub32(cwnd, p));
    let smss = widen_u64(t.smss);

    if usable == 0 {
        // Zero window (or window fully used): RFC 9293 §3.8.6.1 probing.
        if t.snd_wnd == 0 && t.sent_len == 0 {
            if t.probe_due {
                t.probe_due = false;
                t.stats.window_probes = wrapping_add(t.stats.window_probes, 1);
                return some_tx(emit_new(inout t, now, 1, false, send_base, in send, inout out));
            }
            arm_persist(inout t, now);
        }
        return Result::Ok(Option::None);
    }
    let len = min64(min64(unsent, smss), min64(usable, cwnd_room));
    if len == 0 {
        return Result::Ok(Option::None);
    }
    // Sender SWS avoidance and Nagle (RFC 9293 §3.8.6.2.1).
    let full = len == smss;
    let all = len == unsent && (!t.cfg.nagle || t.sent_len == 0);
    let half_window = t.max_snd_wnd > 0 && len >= widen_u64(t.max_snd_wnd / 2);
    if !(full || all || half_window) {
        // Nothing in flight will clock this out: RFC 9293 §3.8.6.2.1 (d)
        // override timeout, driven by the persist timer.
        if t.sent_len == 0 {
            if t.probe_due {
                t.probe_due = false;
            } else {
                arm_persist(inout t, now);
                return Result::Ok(Option::None);
            }
        } else {
            return Result::Ok(Option::None);
        }
    }
    // Attach FIN only when its sequence number also fits the window.
    let tail = wrapping_add(t.snd_nxt, len);
    let with_fin = t.fin_requested && tail == data_end && tail < wnd_right;
    some_tx(emit_new(inout t, now, wrapping_u32(len), with_fin, send_base, in send, inout out))
}

fn arm_persist(inout t: Tcb, now: u64) {
    if !is_some(t.persist_deadline) {
        let backoff = shl64(rtt_rto_ns(t.rtt), widen_u64(min32(t.persist_backoff, 16)));
        t.persist_backoff = sat_add32(t.persist_backoff, 1);
        t.persist_deadline = Option::Some(sat_add64(now, min64(backoff, t.cfg.rto.max_ns)));
    }
}

fn emit_new(inout t: Tcb, now: u64, len: u32, fin: bool, send_base: u64, in send: Slice[u8], inout out: Slice[u8]) -> Result[Tx, TcpFail] {
    let start = t.snd_nxt;
    let fin_len: u64 = if fin {
        1
    } else {
        0
    };
    let end = wrapping_add(wrapping_add(start, widen_u64(len)), fin_len);
    let mut entry = no_seg();
    entry.start = start;
    entry.end = end;
    entry.fin = fin;
    // Validate before committing state.
    match check_view(entry, send_base, send.len(), out.len()) {
        Option::Some(e) => {
            return Result::Err(e);
        },
        Option::None => (),
    }
    if !sq_push(inout t, entry) {
        return Result::Err(TcpFail::Overflow);
    }
    t.snd_nxt = end;
    if fin {
        t.fin_abs = Option::Some(wrapping_sub(end, 1));
    }
    let i = wrapping_sub(t.sent_len, 1);
    emit_entry(inout t, now, i, send_base, in send, inout out, false)
}

fn check_view(s: SentSeg, send_base: u64, send_len: u64, out_len: u64) -> Option[TcpFail] {
    let ds = seg_data_start(s);
    let de = seg_data_end(s);
    if de > ds {
        let start = wrapping_sub(ds, 1);
        let end = wrapping_sub(de, 1);
        let view_end = sat_add64(send_base, send_len);
        if start < send_base || end > view_end {
            return Option::Some(TcpFail::SendViewMissing {
                start: start,
                end: end
            });
        }
    }
    if out_len < wrapping_add(60, wrapping_sub(de, ds)) {
        return Option::Some(TcpFail::BufferTooSmall);
    }
    Option::None
}

fn base_options(in t: Tcb, now: u64, syn: bool) -> Opts {
    let mut o = opts_default();
    let active_syn = t.st == State::SynSent;
    if syn {
        o.mss = Option::Some(t.cfg.mss);
        o.window_scale = if active_syn {
            t.cfg.window_scale
        } else if t.ws_ok {
            Option::Some(t.rcv_wscale)
        } else {
            Option::None
        };
        o.sack_permitted = if active_syn {
            t.cfg.sack
        } else {
            t.sack_ok
        };
    }
    if (syn && active_syn && t.cfg.timestamps) || t.ts_ok {
        o.timestamps = Option::Some(
            Timestamps {
                val: ts_now(now),
                ecr: if t.ts_ok {
                    t.ts_recent
                } else {
                    0
                }
            }
        );
    }
    o
}

fn fill_sack(in t: Tcb, inout o: Opts, room: u64) {
    if !t.sack_ok || t.ooo.len() == 0 {
        return;
    }
    let space = min64(sat_sub64(40, opts_encoded_len(o)), room);
    if space < 12 {
        return;
    }
    let max_blocks = min64(wrapping_sub(space, 4) / 8, 4);
    // Most recently updated ranges first (RFC 2018 §4).
    let mut last_stamp = max_u64();
    let mut n: u64 = 0;
    loop {
        if n >= max_blocks {
            break;
        }
        let mut best: Option[OooRange] = Option::None;
        for i in 0..t.ooo.len() {
            let r = ooo_at(in t, i);
            if r.stamp < last_stamp {
                let better = match best {
                    Option::Some(b) => r.stamp > b.stamp,
                    Option::None => true,
                };
                if better {
                    best = Option::Some(r);
                }
            }
        }
        match best {
            Option::None => {
                break;
            },
            Option::Some(b) => {
                last_stamp = b.stamp;
                opts_set_blk(
                    inout o,
                    n,
                    Blk {
                        left: seqmap_seq(t.rcv_isn, b.start),
                        right: seqmap_seq(t.rcv_isn, b.end)
                    }
                );
                n = wrapping_add(n, 1);
            },
        }
    }
    o.sack_len = wrapping_u8(n);
}

fn advertised_window(inout t: Tcb, syn: bool) -> u16 {
    let right = recv_right(in t);
    let adv_right = if sat_sub64(right, t.rcv_adv_right) >= sws_threshold(in t) {
        right
    } else {
        max64(t.rcv_adv_right, t.rcv_nxt)
    };
    let wnd = sat_sub64(adv_right, t.rcv_nxt);
    if syn {
        let w = min64(wnd, 65535);
        t.rcv_adv_right = max64(t.rcv_adv_right, wrapping_add(t.rcv_nxt, w));
        return wrapping_u16(w);
    }
    let shift = widen_u64(t.rcv_wscale);
    let scaled = min64(shr64(wnd, shift), 65535);
    t.rcv_adv_right = max64(t.rcv_adv_right, wrapping_add(t.rcv_nxt, shl64(scaled, shift)));
    wrapping_u16(scaled)
}

fn after_ack_sent(inout t: Tcb) {
    t.ack_now = false;
    t.ack_pending = 0;
    t.delack_deadline = Option::None;
    t.last_ack_sent = t.rcv_nxt;
}

fn emit_ack(inout t: Tcb, now: u64, inout out: Slice[u8]) -> Result[Tx, TcpFail] {
    let ips = match t.ips {
        Option::Some(i) => i,
        Option::None => {
            return Result::Err(TcpFail::InvalidState(t.st));
        },
    };
    let mut o = base_options(in t, now, false);
    fill_sack(in t, inout o, 40);
    let window = advertised_window(inout t, false);
    let h = Hdr {
        src_port: t.cfg.local_port,
        dst_port: t.remote_port,
        seq: seqmap_seq(t.snd_isn, t.snd_nxt),
        ack: seqmap_seq(t.rcv_isn, t.rcv_nxt),
        flags: ack_bit(),
        window: window,
        urgent: 0
    };
    let n = match write_header(inout out, h, o) {
        Result::Ok(n) => n,
        Result::Err(e) => {
            return wire_err(e);
        },
    };
    match fill_checksum_n(ips, inout out, n) {
        Result::Ok(u) => (),
        Result::Err(e) => {
            return wire_err(e);
        },
    }
    after_ack_sent(inout t);
    t.stats.segments_sent = wrapping_add(t.stats.segments_sent, 1);
    Result::Ok(Tx {
        len: n,
        edt_ns: now,
        ips: ips,
        entry: false,
        pn: 0,
        bytes: 0
    })
}

fn emit_entry(inout t: Tcb, now: u64, i: u64, send_base: u64, in send: Slice[u8], inout out: Slice[u8], retransmit: bool) -> Result[Tx, TcpFail] {
    let ips = match t.ips {
        Option::Some(v) => v,
        Option::None => {
            return Result::Err(TcpFail::InvalidState(t.st));
        },
    };
    let s = sq_get(in t, i);
    match check_view(s, send_base, send.len(), out.len()) {
        Option::Some(e) => {
            return Result::Err(e);
        },
        Option::None => (),
    }
    let ds = seg_data_start(s);
    let de = seg_data_end(s);
    let payload_len = wrapping_sub(de, ds);
    let mut o = base_options(in t, now, s.syn);
    if !s.syn {
        let peer = if t.peer_mss < min_send_mss() {
            min_send_mss()
        } else {
            t.peer_mss
        };
        let total = widen_u64(if peer > t.cfg.mss {
            t.cfg.mss
        } else {
            peer
        });
        let used = wrapping_add(payload_len, opts_encoded_len(o));
        fill_sack(in t, inout o, sat_sub64(total, used));
    }
    let with_ack = t.have_irs;
    let window = if with_ack || s.syn {
        advertised_window(inout t, s.syn)
    } else {
        0
    };
    let mut flags: u8 = 0;
    if s.syn {
        flags = flags | syn_bit();
    }
    if with_ack {
        flags = flags | ack_bit();
    }
    if s.fin {
        flags = flags | fin_bit();
    }
    if payload_len > 0 && wrapping_sub(de, 1) == t.write_end {
        flags = flags | psh_bit();
    }
    let h = Hdr {
        src_port: t.cfg.local_port,
        dst_port: t.remote_port,
        seq: seqmap_seq(t.snd_isn, s.start),
        ack: if with_ack {
            seqmap_seq(t.rcv_isn, t.rcv_nxt)
        } else {
            0
        },
        flags: flags,
        window: window,
        urgent: 0
    };
    let hl = match write_header(inout out, h, o) {
        Result::Ok(n) => n,
        Result::Err(e) => {
            return wire_err(e);
        },
    };
    if payload_len > 0 {
        let off = wrapping_sub(wrapping_sub(ds, 1), send_base);
        copy_into(in send, off, inout out, hl, payload_len);
    }
    let n = wrapping_add(hl, payload_len);
    match fill_checksum_n(ips, inout out, n) {
        Result::Ok(u) => (),
        Result::Err(e) => {
            return wire_err(e);
        },
    }

    let pn = t.next_pn;
    t.next_pn = wrapping_add(t.next_pn, 1);
    let bytes = seg_bytes(s);
    // The wrapper asks its controller for the departure time and moves
    // `sent_ns` with `tcb_commit_edt` when it is later than `now`.
    let edt_ns = now;
    let mut e = s;
    e.pn = pn;
    e.sent_ns = edt_ns;
    e.lost = false;
    if retransmit {
        e.retransmits = sat_add32(e.retransmits, 1);
        if is_some(t.recovery_point) {
            e.rexmit_in_recovery = true;
        }
        t.stats.retransmits = wrapping_add(t.stats.retransmits, 1);
        t.stats.retransmitted_bytes = wrapping_add(t.stats.retransmitted_bytes, payload_len);
    } else if !is_some(t.timed) && !s.syn {
        t.timed = Option::Some(pn);
    }
    if s.syn && !retransmit && !is_some(t.timed) {
        t.timed = Option::Some(pn);
    }
    sq_set(inout t, i, e);
    if !is_some(t.rto_deadline) {
        t.rto_deadline = Option::Some(sat_add64(edt_ns, rtt_rto_ns(t.rtt)));
        t.edt_armed_rto = true;
    }
    if with_ack {
        after_ack_sent(inout t);
    }
    t.stats.segments_sent = wrapping_add(t.stats.segments_sent, 1);
    t.edt_entry = Option::Some(i);
    Result::Ok(Tx {
        len: n,
        edt_ns: edt_ns,
        ips: ips,
        entry: true,
        pn: pn,
        bytes: bytes
    })
}
