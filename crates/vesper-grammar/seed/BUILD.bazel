# The frozen Rust seed copy of vesper-grammar (package vesper-grammar-seed,
# library vesper_grammar) that the compiler and every other dependent link:
# ../src built without the port, so cfg(vesper_port) is off. Written by hand
# because its sources live in the parent package; see "Crates the compiler
# links" in docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-grammar:rust_srcs"],
    crate_name = "vesper_grammar",
    crate_root = "//crates/vesper-grammar:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-grammar-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-grammar:tests/%s.rs" % t],
        compile_data = ["//crates/vesper-grammar:test_fixtures"],
        crate_root = "//crates/vesper-grammar:tests/%s.rs" % t,
        edition = "2024",
        deps = [":seed"],
    )
    for t in [
        "arrow",
        "capnp_packed",
        "codec",
        "codec_acceptance",
        "der",
        "framing",
        "grammar",
        "ipc",
        "no_panic",
        "protobuf",
        "repetition",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
