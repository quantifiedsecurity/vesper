load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# build.rs links the object built here from the Loom package in vesper/ and
# checks port/binding.rs against the generated binding
# (docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "aura_vesper",
    library = "aura",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "aura_vesper_binding",
    srcs = [":aura_vesper"],
    output_group = "rust_binding",
)

vesper_crate(
    build_script_data = [
        ":aura_vesper",
        ":aura_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :aura_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :aura_vesper_binding)",
    },
)
