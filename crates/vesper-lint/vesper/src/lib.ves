// @vesper/lint: `vesper_lint` in Vesper (self-hosting SH1 lane 13, #1156).
//
// Three entry points, each the Rust function of crates/vesper-lint/src it
// is named after, decision for decision:
//
// - `analyze` (`vesper_lint::analyze`): the unused effect capability
//   (L0102) and overbroad inout projection (L0101) rules over the checked
//   facts of a program. The Rust side passes the facts as a word stream and
//   a text blob (crates/vesper-lint/src/port.rs `encode`); this side decodes
//   them into @vesper/ast nodes (`TypeNode`, `EffectNode`, `EffectsNode`,
//   `GenericNode`, `ListRef`, with the AST's kind numbering), checks every
//   limit in the Rust order, runs both rules with the same work budget and
//   returns the findings, their messages and the skipped functions.
// - `policy_parse` (`vesper_lint::policy::Policy::parse`): the lexical and
//   structural preflight, a TOML reader that accepts and rejects exactly
//   what the `toml` crate (0.8, toml_edit 0.22) does for `toml::Value`, the
//   bounded walk of the decoded tree, and the `[lints]` policy extraction.
// - `apply_edits` (`vesper_lint::apply_edits`).
//
// Errors are `LintFail { code }`: the index of the Rust error message in
// port.rs's tables. tests/differential.rs runs the Rust code and this
// package on the same inputs and requires equal results.

use @vesper/ast::{
    TypeNode,
    EffectNode,
    EffectsNode,
    GenericNode,
    ListRef
};
use @vesper-std/intern::{
    Interner,
    Symbol,
    interner_new,
    symbol_from_id
};
use @vesper-std/sort::unstable::{
    sort
};

// ---------------------------------------------------------------- common

const NONE: u32 = 4294967295;
const U64_MAX: u64 = 18446744073709551615;
// End of input for `at`.
const EOF: u64 = 256;

pub copy struct LintFail {
    code: u64
}

fn fail(code: u64) eff [Fail[LintFail]] {
    Fail::raise(
        LintFail {
            code: code
        }
    );
}

fn at(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(c) => widen_u64(c),
        Option::None => EOF,
    }
}

fn word(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn u32_at(in s: ChunkSeq[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => NONE,
    }
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

// `a + b`, or `code` on overflow.
fn cadd(a: u64, b: u64, code: u64) -> u64 eff [Fail[LintFail]] {
    if a > wrapping_sub(U64_MAX, b) {
        fail(code);
    }
    wrapping_add(a, b)
}

// Packs `bytes` into `out` as its length, then eight bytes per word,
// little-endian.
fn push_text(inout out: ChunkSeq[u64], in bytes: Slice[u8]) {
    let n = bytes.len();
    out.push(n);
    let mut w: u64 = 0;
    let mut k: u64 = 0;
    for i in 0..n {
        w = w | wrapping_shl_u64(at(in bytes, i), wrapping_u32(wrapping_mul(k, 8)));
        k = inc(k);
        if k == 8 {
            out.push(w);
            w = 0;
            k = 0;
        }
    }
    if k != 0 {
        out.push(w);
    }
}

fn put(inout o: ChunkSeq[u8], in s: Str) {
    o.extend(in s.as_bytes());
}

// ================================================================ policy
//
// crates/vesper-lint/src/policy.rs. Error codes (`LintFail::code`) are the
// indices of `POLICY_ERRORS` in port.rs; each names the Rust error kind and
// message.

const P_INVALID_LIMITS: u64 = 0;
const P_WORK_OVERFLOW: u64 = 1;
const P_WORK_LIMIT: u64 = 2;
const P_BYTE_OVERFLOW: u64 = 3;
const P_DECODED_LIMIT: u64 = 4;
const P_VALUE_DEPTH: u64 = 5;
const P_TREE_OVERFLOW: u64 = 6;
const P_NODE_LIMIT: u64 = 7;
const P_KEY_BYTES: u64 = 8;
const P_INPUT_BYTES: u64 = 9;
const P_TOKEN_LIMIT: u64 = 10;
const P_ESTIMATE_OVERFLOW: u64 = 11;
const P_LEXICAL_ESTIMATE: u64 = 12;
const P_STRING_ESCAPE: u64 = 13;
const P_QUOTE_RUN: u64 = 14;
const P_UNTERMINATED: u64 = 15;
const P_PREPARSE_DEPTH: u64 = 16;
const P_AOT_HEADER: u64 = 17;
const P_HEADER: u64 = 18;
const P_HEADER_UNTERMINATED: u64 = 19;
const P_KEY: u64 = 20;
const P_MISMATCHED: u64 = 21;
const P_COMMA: u64 = 22;
const P_UNCLOSED: u64 = 23;
const P_TOML: u64 = 24;
const P_LINTS_SHAPE: u64 = 26;
const P_VESPER_SHAPE: u64 = 27;
const P_RULE_COUNT: u64 = 28;
const P_SEVERITY_STRING: u64 = 29;
const P_SEVERITY: u64 = 30;
const P_POLICY_KEY: u64 = 31;
const P_UNKNOWN_RULE: u64 = 32;
const P_UNAVAILABLE_DENY: u64 = 34;
const P_PLUGINS_SHAPE: u64 = 35;
const P_PLUGINS: u64 = 36;
const P_UNKNOWN_SECTION: u64 = 37;
// Not a Rust error: the document has a table whose first key is serde's
// private datetime marker, which `toml::Value` decodes with toml_datetime's
// own parser. The Rust code parses such a document.
const P_UNSUPPORTED: u64 = 38;

// `PolicyLimits::default()`, the hard ceilings.
const HARD_BYTES: u64 = 65536;
const HARD_DEPTH: u64 = 32;
const HARD_TOKENS: u64 = 8192;
const HARD_NODES: u64 = 4096;
const HARD_WORK: u64 = 262144;

copy struct Limits {
    bytes: u64,
    depth: u64,
    tokens: u64,
    nodes: u64,
    work: u64
}

// `policy::Budget`.
copy struct Budget {
    lim: Limits,
    work: u64,
    nodes: u64,
    value_bytes: u64
}

fn charge(inout b: Budget, n: u64) eff [Fail[LintFail]] {
    b.work = cadd(b.work, n, P_WORK_OVERFLOW);
    if b.work > b.lim.work {
        fail(P_WORK_LIMIT);
    }
}

fn text(inout b: Budget, n: u64) eff [Fail[LintFail]] {
    b.value_bytes = cadd(b.value_bytes, n, P_BYTE_OVERFLOW);
    if b.value_bytes > b.lim.bytes {
        fail(P_DECODED_LIMIT);
    }
    charge(inout b, n);
}

fn validate_limits(in l: Limits) eff [Fail[LintFail]] {
    if l.bytes == 0
        || l.bytes > HARD_BYTES
        || l.depth == 0
        || l.depth > HARD_DEPTH
        || l.tokens == 0
        || l.tokens > HARD_TOKENS
        || l.nodes == 0
        || l.nodes > HARD_NODES
        || l.work == 0
        || l.work > HARD_WORK {
        fail(P_INVALID_LIMITS);
    }
}

// ---------------------------------------------------------------- preflight
//
// `lexical`, `string_end`, `header` and `preflight` of policy.rs.

const T_ATOM: u8 = 0;
const T_STRING: u8 = 1;
const T_DOT: u8 = 2;
const T_EQ: u8 = 3;
const T_LEFT_ARRAY: u8 = 4;
const T_RIGHT_ARRAY: u8 = 5;
const T_LEFT_TABLE: u8 = 6;
const T_RIGHT_TABLE: u8 = 7;
const T_COMMA: u8 = 8;
const T_NEWLINE: u8 = 9;

fn atom_stop(c: u64) -> bool {
    c == 32
        || c == 9
        || c == 13
        || c == 10
        || c == 35
        || c == 39
        || c == 34
        || c == 46
        || c == 61
        || c == 91
        || c == 93
        || c == 123
        || c == 125
        || c == 44
}

fn string_end(in s: Slice[u8], start: u64) -> u64 eff [Fail[LintFail]] {
    let n = s.len();
    let quote = at(in s, start);
    let multiline = wrapping_add(start, 3) <= n
        && at(in s, inc(start)) == quote
        && at(in s, wrapping_add(start, 2)) == quote;
    let mut i = if multiline {
        wrapping_add(start, 3)
    } else {
        inc(start)
    };
    loop {
        if i >= n {
            break;
        }
        let c = at(in s, i);
        if quote == 34 && c == 92 {
            i = cadd(i, 2, P_STRING_ESCAPE);
            continue;
        }
        if c == quote {
            if !multiline {
                return inc(i);
            }
            let mut end = i;
            loop {
                if end >= n || at(in s, end) != quote {
                    break;
                }
                end = inc(end);
            }
            let run = wrapping_sub(end, i);
            if run >= 3 {
                if run > 5 {
                    fail(P_QUOTE_RUN);
                }
                return end;
            }
            i = end;
        } else {
            i = inc(i);
        }
    }
    fail(P_UNTERMINATED);
    0
}

fn lexical(in s: Slice[u8], inout b: Budget, inout out: ChunkSeq[u8]) eff [Fail[LintFail]] {
    let n = s.len();
    if n > b.lim.bytes {
        fail(P_INPUT_BYTES);
    }
    charge(inout b, n);
    let mut i: u64 = 0;
    let mut nodes: u64 = 1;
    loop {
        if i >= n {
            break;
        }
        let c = at(in s, i);
        let mut kind: u8 = T_ATOM;
        if c == 32 || c == 9 {
            i = inc(i);
            continue;
        } else if c == 35 {
            loop {
                if i >= n {
                    break;
                }
                let d = at(in s, i);
                if d == 10 || d == 13 {
                    break;
                }
                i = inc(i);
            }
            continue;
        } else if c == 10 || c == 13 {
            if c == 13 && at(in s, inc(i)) == 10 {
                i = inc(i);
            }
            i = inc(i);
            kind = T_NEWLINE;
        } else if c == 39 || c == 34 {
            i = string_end(in s, i);
            kind = T_STRING;
        } else {
            i = inc(i);
            if c == 46 {
                kind = T_DOT;
            } else if c == 61 {
                kind = T_EQ;
            } else if c == 91 {
                kind = T_LEFT_ARRAY;
            } else if c == 93 {
                kind = T_RIGHT_ARRAY;
            } else if c == 123 {
                kind = T_LEFT_TABLE;
            } else if c == 125 {
                kind = T_RIGHT_TABLE;
            } else if c == 44 {
                kind = T_COMMA;
            } else {
                loop {
                    if i >= n || atom_stop(at(in s, i)) {
                        break;
                    }
                    i = inc(i);
                }
                kind = T_ATOM;
            }
        }
        if out.len() >= b.lim.tokens {
            fail(P_TOKEN_LIMIT);
        }
        if kind == T_ATOM || kind == T_STRING || kind == T_LEFT_ARRAY || kind == T_LEFT_TABLE {
            nodes = cadd(nodes, 1, P_ESTIMATE_OVERFLOW);
            if nodes > b.lim.nodes {
                fail(P_LEXICAL_ESTIMATE);
            }
        }
        out.push(kind);
    }
}

const C_ARRAY: u8 = 0;
const C_TABLE: u8 = 1;

copy struct Frame {
    kind: u8,
    depth: u64,
    key: u64,
    expect_key: bool,
    value: bool,
    value_depth: u64
}

fn tok(in t: ChunkSeq[u8], i: u64) -> u8 {
    match t.try_get(i) {
        Option::Some(k) => k,
        // No token: not a kind any rule matches.
        Option::None => 255,
    }
}

fn check_depth(depth: u64, in b: Budget) eff [Fail[LintFail]] {
    if depth > b.lim.depth {
        fail(P_PREPARSE_DEPTH);
    }
}

// `header`: the index after the header and its depth.
fn header(in t: ChunkSeq[u8], start: u64, inout b: Budget) -> (u64, u64) eff [Fail[LintFail]] {
    let array = tok(in t, inc(start)) == T_LEFT_ARRAY;
    let mut i = if array {
        wrapping_add(start, 2)
    } else {
        inc(start)
    };
    let mut parts: u64 = 0;
    let mut expect = true;
    loop {
        if i >= t.len() {
            break;
        }
        let k = tok(in t, i);
        charge(inout b, 1);
        if (k == T_ATOM || k == T_STRING) && expect {
            parts = inc(parts);
            expect = false;
            check_depth(wrapping_mul(parts, 2), in b);
        } else if k == T_DOT && !expect {
            expect = true;
        } else if k == T_RIGHT_ARRAY && !expect {
            if array {
                if tok(in t, inc(i)) != T_RIGHT_ARRAY {
                    fail(P_AOT_HEADER);
                }
                charge(inout b, 1);
                i = inc(i);
            }
            return (inc(i), wrapping_mul(parts, 2));
        } else {
            fail(P_HEADER);
        }
        i = inc(i);
    }
    fail(P_HEADER_UNTERMINATED);
    (0, 0)
}

fn new_frame(kind: u8, depth: u64) -> Frame {
    Frame {
        kind: kind,
        depth: depth,
        key: 0,
        expect_key: true,
        value: kind == C_ARRAY,
        value_depth: depth
    }
}

// `preflight`: the number of tokens.
fn preflight(in s: Slice[u8], inout b: Budget) -> u64 eff [Fail[LintFail]] {
    let mut t = ChunkSeq::new[u8]();
    lexical(in s, inout b, inout t);
    let n = t.len();
    let mut root = new_frame(C_TABLE, 0);
    let mut stack = ChunkSeq::new[Frame]();
    let mut line_start = true;
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        charge(inout b, 1);
        let kind = tok(in t, i);
        if kind == T_NEWLINE {
            if stack.len() == 0 {
                root.key = 0;
                root.expect_key = true;
                root.value = false;
                line_start = true;
            }
            i = inc(i);
            continue;
        }
        if line_start && stack.len() == 0 && kind == T_LEFT_ARRAY && !root.value && root.key == 0 {
            let (next, depth) = header(in t, i, inout b);
            i = next;
            root.depth = depth;
            line_start = false;
            continue;
        }
        line_start = false;
        let nested = stack.len() != 0;
        let top = wrapping_sub(stack.len(), 1);
        let mut frame = if nested {
            match stack.try_get(top) {
                Option::Some(f) => f,
                Option::None => root,
            }
        } else {
            root
        };
        if !frame.value {
            if (kind == T_ATOM || kind == T_STRING) && frame.expect_key {
                frame.key = inc(frame.key);
                frame.expect_key = false;
                check_depth(wrapping_add(frame.depth, wrapping_mul(frame.key, 2)), in b);
            } else if kind == T_DOT && !frame.expect_key {
                frame.expect_key = true;
            } else if kind == T_EQ && !frame.expect_key {
                frame.value = true;
                frame.value_depth = wrapping_add(frame.depth, wrapping_mul(frame.key, 2));
            } else if kind == T_RIGHT_TABLE && frame.kind == C_TABLE && frame.key == 0 && nested {
                stack.truncate(top);
                i = inc(i);
                continue;
            } else {
                fail(P_KEY);
            }
            if nested {
                stack.try_set(top, frame);
            } else {
                root = frame;
            }
            i = inc(i);
            continue;
        }
        if kind == T_LEFT_ARRAY || kind == T_LEFT_TABLE {
            let base = if frame.kind == C_ARRAY {
                frame.depth
            } else {
                frame.value_depth
            };
            let depth = inc(base);
            check_depth(depth, in b);
            let k = if kind == T_LEFT_ARRAY {
                C_ARRAY
            } else {
                C_TABLE
            };
            stack.push(new_frame(k, depth));
        } else if kind == T_RIGHT_ARRAY || kind == T_RIGHT_TABLE {
            let expected = if kind == T_RIGHT_ARRAY {
                C_ARRAY
            } else {
                C_TABLE
            };
            if !nested || frame.kind != expected {
                fail(P_MISMATCHED);
            }
            stack.truncate(top);
        } else if kind == T_COMMA {
            if frame.kind == C_TABLE && nested {
                frame.key = 0;
                frame.expect_key = true;
                frame.value = false;
                stack.try_set(top, frame);
            } else if !nested {
                fail(P_COMMA);
            }
        }
        i = inc(i);
    }
    if stack.len() != 0 {
        fail(P_UNCLOSED);
    }
    n
}

// ---------------------------------------------------------------- TOML
//
// The `toml_edit` 0.22 grammar (`parser/document.rs` and the files it
// uses) and its `ParseState` (`parser/state.rs`), for `toml::from_str` into
// a `toml::Value`. Every syntax or semantic error is `P_TOML`, the one
// error the Rust code maps them to. Values are decoded only as far as the
// policy needs them: strings and keys to their decoded bytes, everything
// else to its kind.
//
// Items are nodes. A table's entries are a linked list in insertion order
// (`toml_edit`'s IndexMap order, which decides serde's datetime marker
// below); the walk of `validate_value` and the policy read them in key
// order (`toml::Table` is a BTreeMap).

// Node kinds. Item::Value: the scalars, an array and an inline table;
// Item::Table; Item::ArrayOfTables.
const N_STRING: u8 = 1;
const N_INTEGER: u8 = 2;
const N_FLOAT: u8 = 3;
const N_BOOL: u8 = 4;
const N_DATETIME: u8 = 5;
const N_ARRAY: u8 = 6;
const N_INLINE: u8 = 7;
const N_TABLE: u8 = 8;
const N_AOT: u8 = 9;

copy struct TNode {
    kind: u8,
    implicit: bool,
    dotted: bool,
    // A table or array: its first and last entries and their count; a
    // string: the range of its decoded bytes in `Toml.text`.
    first: u32,
    last: u32,
    count: u32
}

copy struct TEnt {
    // The key's decoded bytes in `Toml.text` (an array element has none)
    // and their hash.
    kstart: u32,
    klen: u32,
    hash: u64,
    child: u32,
    next: u32
}

struct Toml {
    nodes: ChunkSeq[TNode],
    ents: ChunkSeq[TEnt],
    text: ChunkSeq[u8],
    // The parsed key path: (start, len, hash) per part.
    path: ChunkSeq[u64],
    current: u32,
    pos: u64
}

fn terr() eff [Fail[LintFail]] {
    fail(P_TOML);
}

fn node(in t: Toml, id: u32) -> TNode {
    match t.nodes.try_get(widen_u64(id)) {
        Option::Some(n) => n,
        Option::None => TNode {
            kind: 0,
            implicit: false,
            dotted: false,
            first: NONE,
            last: NONE,
            count: 0
        },
    }
}

fn ent(in t: Toml, id: u32) -> TEnt {
    match t.ents.try_get(widen_u64(id)) {
        Option::Some(e) => e,
        Option::None => TEnt {
            kstart: 0,
            klen: 0,
            hash: 0,
            child: NONE,
            next: NONE
        },
    }
}

fn set_node(inout t: Toml, id: u32, n: TNode) {
    t.nodes.try_set(widen_u64(id), n);
}

fn new_node(inout t: Toml, kind: u8, implicit: bool, dotted: bool) -> u32 {
    let id = wrapping_u32(t.nodes.len());
    t.nodes.push(
        TNode {
            kind: kind,
            implicit: implicit,
            dotted: dotted,
            first: NONE,
            last: NONE,
            count: 0
        }
    );
    id
}

fn scalar(inout t: Toml, kind: u8) -> u32 {
    new_node(inout t, kind, false, false)
}

// Appends an entry for `child` (key `kstart..kstart+klen` of `text`) to
// container `c`.
fn append(inout t: Toml, c: u32, kstart: u64, klen: u64, hash: u64, child: u32) {
    let e = wrapping_u32(t.ents.len());
    t.ents.push(
        TEnt {
            kstart: wrapping_u32(kstart),
            klen: wrapping_u32(klen),
            hash: hash,
            child: child,
            next: NONE
        }
    );
    let mut n = node(in t, c);
    if n.last == NONE {
        n.first = e;
    } else {
        let mut l = ent(in t, n.last);
        l.next = e;
        t.ents.try_set(widen_u64(n.last), l);
    }
    n.last = e;
    n.count = wrapping_add(n.count, 1);
    set_node(inout t, c, n);
}

fn key_eq(in t: Toml, a: u64, alen: u64, b: u64, blen: u64) -> bool {
    if alen != blen {
        return false;
    }
    for i in 0..alen {
        if at(in t.text.as_slice(), wrapping_add(a, i)) != at(in t.text.as_slice(), wrapping_add(b, i)) {
            return false;
        }
    }
    true
}

// The entry of container `c` with the given key, or NONE.
fn lookup(in t: Toml, c: u32, kstart: u64, klen: u64, hash: u64) -> u32 {
    let mut e = node(in t, c).first;
    loop {
        if e == NONE {
            break;
        }
        let x = ent(in t, e);
        if x.hash == hash && key_eq(in t, widen_u64(x.kstart), widen_u64(x.klen), kstart, klen) {
            return e;
        }
        e = x.next;
    }
    NONE
}

// Unlinks entry `e` from container `c` (IndexMap `shift_remove`).
fn unlink(inout t: Toml, c: u32, e: u32) {
    let mut n = node(in t, c);
    let mut prev = NONE;
    let mut cur = n.first;
    loop {
        if cur == NONE {
            return;
        }
        if cur == e {
            break;
        }
        prev = cur;
        cur = ent(in t, cur).next;
    }
    let next = ent(in t, e).next;
    if prev == NONE {
        n.first = next;
    } else {
        let mut p = ent(in t, prev);
        p.next = next;
        t.ents.try_set(widen_u64(prev), p);
    }
    if n.last == e {
        n.last = prev;
    }
    n.count = wrapping_sub(n.count, 1);
    set_node(inout t, c, n);
    let mut x = ent(in t, e);
    x.next = NONE;
    t.ents.try_set(widen_u64(e), x);
}

fn fnv(in t: Toml, start: u64, len: u64) -> u64 {
    let mut h: u64 = 14695981039346656037;
    for i in 0..len {
        h = wrapping_mul(h ^ at(in t.text.as_slice(), wrapping_add(start, i)), 1099511628211);
    }
    h
}

fn cur(in s: Slice[u8], in t: Toml) -> u64 {
    at(in s, t.pos)
}

fn peek_at(in s: Slice[u8], in t: Toml, k: u64) -> u64 {
    at(in s, wrapping_add(t.pos, k))
}

fn bump(inout t: Toml) {
    t.pos = inc(t.pos);
}

fn is_digit(c: u64) -> bool {
    c >= 48 && c <= 57
}

fn is_hex(c: u64) -> bool {
    is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn hex_val(c: u64) -> u64 {
    if is_digit(c) {
        wrapping_sub(c, 48)
    } else if c >= 97 {
        wrapping_sub(c, 87)
    } else {
        wrapping_sub(c, 55)
    }
}

fn skip_ws(in s: Slice[u8], inout t: Toml) {
    loop {
        let c = cur(in s, in t);
        if c != 32 && c != 9 {
            break;
        }
        bump(inout t);
    }
}

// `newline`: LF or CRLF.
fn newline(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let c = cur(in s, in t);
    if c == 10 {
        bump(inout t);
    } else if c == 13 && peek_at(in s, in t, 1) == 10 {
        t.pos = wrapping_add(t.pos, 2);
    } else {
        terr();
    }
}

fn non_eol(c: u64) -> bool {
    c == 9 || (c >= 32 && c <= 126) || (c >= 128 && c != EOF)
}

// `comment`: `#` and the rest of the line's allowed characters.
fn comment(in s: Slice[u8], inout t: Toml) {
    bump(inout t);
    loop {
        if !non_eol(cur(in s, in t)) {
            break;
        }
        bump(inout t);
    }
}

// `line_ending`: a newline or the end of input.
fn line_ending(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    if cur(in s, in t) != EOF {
        newline(in s, inout t);
    }
}

// `line_trailing`: whitespace, an optional comment, a line ending.
fn line_trailing(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    skip_ws(in s, inout t);
    if cur(in s, in t) == 35 {
        comment(in s, inout t);
    }
    line_ending(in s, inout t);
}

// `ws_comment_newline`.
fn ws_comment_newline(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    loop {
        skip_ws(in s, inout t);
        let c = cur(in s, in t);
        if c == 35 {
            comment(in s, inout t);
            newline(in s, inout t);
        } else if c == 10 || c == 13 {
            newline(in s, inout t);
        } else {
            break;
        }
    }
}

// Appends the UTF-8 encoding of scalar `v` to the decoded text.
fn push_char(inout t: Toml, v: u64) {
    if v < 128 {
        t.text.push(wrapping_u8(v));
    } else if v < 2048 {
        t.text.push(wrapping_u8(192 | (v >> 6)));
        t.text.push(wrapping_u8(128 | (v & 63)));
    } else if v < 65536 {
        t.text.push(wrapping_u8(224 | (v >> 12)));
        t.text.push(wrapping_u8(128 | ((v >> 6) & 63)));
        t.text.push(wrapping_u8(128 | (v & 63)));
    } else {
        t.text.push(wrapping_u8(240 | (v >> 18)));
        t.text.push(wrapping_u8(128 | ((v >> 12) & 63)));
        t.text.push(wrapping_u8(128 | ((v >> 6) & 63)));
        t.text.push(wrapping_u8(128 | (v & 63)));
    }
}

// `escaped` after the backslash.
fn escape(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let c = cur(in s, in t);
    bump(inout t);
    if c == 98 {
        t.text.push(8);
    } else if c == 102 {
        t.text.push(12);
    } else if c == 110 {
        t.text.push(10);
    } else if c == 114 {
        t.text.push(13);
    } else if c == 116 {
        t.text.push(9);
    } else if c == 92 {
        t.text.push(92);
    } else if c == 34 {
        t.text.push(34);
    } else if c == 117 || c == 85 {
        let digits: u64 = if c == 117 {
            4
        } else {
            8
        };
        let mut v: u64 = 0;
        for i in 0..digits {
            let d = cur(in s, in t);
            if !is_hex(d) {
                terr();
            }
            v = wrapping_add(wrapping_mul(v, 16), hex_val(d));
            bump(inout t);
        }
        if v > 1114111 || (v >= 55296 && v <= 57343) {
            terr();
        }
        push_char(inout t, v);
    } else {
        terr();
    }
}

// Characters a basic string holds unescaped (and a multiline one, besides
// newlines).
fn basic_unescaped(c: u64) -> bool {
    c == 32 || c == 9 || c == 33 || (c >= 35 && c <= 91) || (c >= 93 && c <= 126) || (c >= 128 && c != EOF)
}

fn literal_char(c: u64) -> bool {
    c == 9 || (c >= 32 && c <= 38) || (c >= 40 && c <= 126) || (c >= 128 && c != EOF)
}

// `basic_string` from its opening quote; the decoded bytes go to `text`.
fn basic_string(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    bump(inout t);
    loop {
        let c = cur(in s, in t);
        if c == 34 {
            bump(inout t);
            return;
        } else if c == 92 {
            bump(inout t);
            escape(in s, inout t);
        } else if basic_unescaped(c) {
            t.text.push(wrapping_u8(c));
            bump(inout t);
        } else {
            terr();
        }
    }
}

fn literal_string(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    bump(inout t);
    loop {
        let c = cur(in s, in t);
        if c == 39 {
            bump(inout t);
            return;
        } else if literal_char(c) {
            t.text.push(wrapping_u8(c));
            bump(inout t);
        } else {
            terr();
        }
    }
}

// A run of `q` quotes inside a multiline string: fewer than three are
// content; three or more close it, the first `run - 3` (at most two) still
// content. Returns whether the string closed.
fn ml_quotes(in s: Slice[u8], inout t: Toml, q: u64) -> bool {
    let mut run: u64 = 0;
    loop {
        if cur(in s, in t) != q {
            break;
        }
        run = inc(run);
        bump(inout t);
        if run == 5 {
            break;
        }
    }
    if run < 3 {
        for i in 0..run {
            t.text.push(wrapping_u8(q));
        }
        return false;
    }
    // `opt(mlb_quotes(DELIM))` then the delimiter: the quotes past the
    // first five stay in the input.
    for i in 0..wrapping_sub(run, 3) {
        t.text.push(wrapping_u8(q));
    }
    true
}

// `ml_basic_string` after its opening delimiter.
fn ml_basic_string(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let c0 = cur(in s, in t);
    if c0 == 10 || (c0 == 13 && peek_at(in s, in t, 1) == 10) {
        newline(in s, inout t);
    }
    loop {
        let c = cur(in s, in t);
        if c == 34 {
            if ml_quotes(in s, inout t, 34) {
                return;
            }
        } else if c == 92 {
            // `mlb_escaped_nl`: a backslash, whitespace and a newline, then
            // any whitespace and newlines; otherwise an escape.
            let save = t.pos;
            bump(inout t);
            skip_ws(in s, inout t);
            let d = cur(in s, in t);
            if d == 10 || (d == 13 && peek_at(in s, in t, 1) == 10) {
                loop {
                    let e = cur(in s, in t);
                    if e == 32 || e == 9 {
                        bump(inout t);
                    } else if e == 10 || (e == 13 && peek_at(in s, in t, 1) == 10) {
                        newline(in s, inout t);
                    } else {
                        break;
                    }
                }
            } else {
                t.pos = inc(save);
                escape(in s, inout t);
            }
        } else if c == 10 || c == 13 {
            newline(in s, inout t);
            t.text.push(10);
        } else if basic_unescaped(c) {
            t.text.push(wrapping_u8(c));
            bump(inout t);
        } else {
            terr();
        }
    }
}

// `ml_literal_string` after its opening delimiter (CRLF decodes to LF).
fn ml_literal_string(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let c0 = cur(in s, in t);
    if c0 == 10 || (c0 == 13 && peek_at(in s, in t, 1) == 10) {
        newline(in s, inout t);
    }
    loop {
        let c = cur(in s, in t);
        if c == 39 {
            if ml_quotes(in s, inout t, 39) {
                return;
            }
        } else if c == 10 || c == 13 {
            newline(in s, inout t);
            t.text.push(10);
        } else if literal_char(c) {
            t.text.push(wrapping_u8(c));
            bump(inout t);
        } else {
            terr();
        }
    }
}

// `simple_key`: pushes (start, len, hash) of its decoded bytes to `path`.
fn simple_key(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let start = t.text.len();
    let c = cur(in s, in t);
    if c == 34 {
        basic_string(in s, inout t);
    } else if c == 39 {
        literal_string(in s, inout t);
    } else {
        let mut n: u64 = 0;
        loop {
            let d = cur(in s, in t);
            if !((d >= 65 && d <= 90) || (d >= 97 && d <= 122) || is_digit(d) || d == 45 || d == 95) {
                break;
            }
            t.text.push(wrapping_u8(d));
            bump(inout t);
            n = inc(n);
        }
        if n == 0 {
            terr();
        }
    }
    let len = wrapping_sub(t.text.len(), start);
    t.path.push(start);
    t.path.push(len);
    t.path.push(fnv(in t, start, len));
}

// `key`: dotted simple keys with whitespace around each; the parts are in
// `path`, which this clears first.
fn key(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    t.path.clear();
    loop {
        skip_ws(in s, inout t);
        simple_key(in s, inout t);
        skip_ws(in s, inout t);
        if cur(in s, in t) != 46 {
            break;
        }
        bump(inout t);
    }
}

fn path_parts(in t: Toml) -> u64 {
    t.path.len() / 3
}

fn part(in t: Toml, i: u64) -> (u64, u64, u64) {
    let j = wrapping_mul(i, 3);
    (
        word(in t.path.as_slice(), j),
        word(in t.path.as_slice(), inc(j)),
        word(in t.path.as_slice(), wrapping_add(j, 2))
    )
}

// `ParseState::descend_path` (and `inline_table::descend_path` when
// `inline`) over parts `0..n` of `path`.
fn descend(inout t: Toml, table: u32, n: u64, dotted: bool, inline: bool) -> u32 eff [Fail[LintFail]] {
    let mut c = table;
    for i in 0..n {
        let (ks, kl, h) = part(in t, i);
        let e = lookup(in t, c, ks, kl, h);
        if e == NONE {
            let kind = if inline {
                N_INLINE
            } else {
                N_TABLE
            };
            let child = new_node(inout t, kind, true, dotted);
            append(inout t, c, ks, kl, h, child);
            c = child;
        } else {
            let child = ent(in t, e).child;
            let x = node(in t, child);
            if !inline && x.kind == N_AOT {
                // The last table of the array (never empty here).
                c = ent(in t, x.last).child;
            } else if (inline && x.kind == N_INLINE) || (!inline && x.kind == N_TABLE) {
                if dotted && !x.implicit {
                    terr();
                }
                c = child;
            } else {
                terr();
            }
        }
    }
    c
}

// `on_keyval` / `table_from_pairs`: inserts `value` under the parsed key
// path into `table`.
fn insert_keyval(inout t: Toml, table: u32, value: u32, inline: bool) eff [Fail[LintFail]] {
    let n = path_parts(in t);
    let parent = wrapping_sub(n, 1);
    let target = descend(inout t, table, parent, true, inline);
    if node(in t, target).dotted == (parent == 0) {
        terr();
    }
    let (ks, kl, h) = part(in t, parent);
    if lookup(in t, target, ks, kl, h) != NONE {
        terr();
    }
    append(inout t, target, ks, kl, h, value);
}

// The scalar at the cursor that starts with `+`, `-` or a digit:
// `alt((date_time, float, integer))`.
fn number(in s: Slice[u8], inout t: Toml) -> u32 eff [Fail[LintFail]] {
    let start = t.pos;
    if date_time(in s, inout t) {
        return scalar(inout t, N_DATETIME);
    }
    t.pos = start;
    if float(in s, inout t) {
        return scalar(inout t, N_FLOAT);
    }
    t.pos = start;
    integer(in s, inout t);
    scalar(inout t, N_INTEGER)
}

// Exactly `n` digits at the cursor (`unsigned_digits::<n, n>`), their
// value, or false when fewer than `n` are there.
fn digits(in s: Slice[u8], inout t: Toml, n: u64, inout v: u64) -> bool {
    let mut x: u64 = 0;
    for i in 0..n {
        let d = peek_at(in s, in t, i);
        if !is_digit(d) {
            return false;
        }
        x = wrapping_add(wrapping_mul(x, 10), wrapping_sub(d, 48));
    }
    t.pos = wrapping_add(t.pos, n);
    v = x;
    true
}

// `partial_time`: false on a backtrack before the first colon.
fn partial_time(in s: Slice[u8], inout t: Toml) -> bool eff [Fail[LintFail]] {
    let mut h: u64 = 0;
    if !digits(in s, inout t, 2, inout h) || h > 23 {
        return false;
    }
    if cur(in s, in t) != 58 {
        return false;
    }
    bump(inout t);
    let mut m: u64 = 0;
    if !digits(in s, inout t, 2, inout m) || m > 59 {
        terr();
    }
    if cur(in s, in t) != 58 {
        terr();
    }
    bump(inout t);
    let mut sec: u64 = 0;
    if !digits(in s, inout t, 2, inout sec) || sec > 60 {
        terr();
    }
    // `opt(time_secfrac)`.
    if cur(in s, in t) == 46 && is_digit(peek_at(in s, in t, 1)) {
        bump(inout t);
        loop {
            if !is_digit(cur(in s, in t)) {
                break;
            }
            bump(inout t);
        }
    }
    true
}

// `date_time`: true when one was read, false on a backtrack.
fn date_time(in s: Slice[u8], inout t: Toml) -> bool eff [Fail[LintFail]] {
    let start = t.pos;
    let mut year: u64 = 0;
    if digits(in s, inout t, 4, inout year) && cur(in s, in t) == 45 {
        bump(inout t);
        let mut month: u64 = 0;
        if !digits(in s, inout t, 2, inout month) || month < 1 || month > 12 {
            terr();
        }
        if cur(in s, in t) != 45 {
            terr();
        }
        bump(inout t);
        let mut day: u64 = 0;
        if !digits(in s, inout t, 2, inout day) || day < 1 || day > 31 {
            terr();
        }
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        let max: u64 = if month == 2 && leap {
            29
        } else if month == 2 {
            28
        } else if month == 4 || month == 6 || month == 9 || month == 11 {
            30
        } else {
            31
        };
        if day > max {
            terr();
        }
        // `opt((time_delim, partial_time, opt(time_offset)))`.
        let after_date = t.pos;
        let d = cur(in s, in t);
        if d == 84 || d == 116 || d == 32 {
            bump(inout t);
            if partial_time(in s, inout t) {
                let o = cur(in s, in t);
                if o == 90 || o == 122 {
                    bump(inout t);
                } else if o == 43 || o == 45 {
                    bump(inout t);
                    let mut oh: u64 = 0;
                    if !digits(in s, inout t, 2, inout oh) || oh > 23 {
                        terr();
                    }
                    if cur(in s, in t) != 58 {
                        terr();
                    }
                    bump(inout t);
                    let mut om: u64 = 0;
                    if !digits(in s, inout t, 2, inout om) || om > 59 {
                        terr();
                    }
                }
            } else {
                t.pos = after_date;
            }
        }
        return true;
    }
    t.pos = start;
    partial_time(in s, inout t)
}

// Digits with single underscores between them (`_` must be followed by a
// digit, a cut). The first must already be checked by the caller.
fn digit_run(in s: Slice[u8], inout t: Toml, hex: bool, radix_max: u64, inout out: ChunkSeq[u8]) eff [Fail[LintFail]] {
    loop {
        let c = cur(in s, in t);
        let ok = if hex {
            is_hex(c)
        } else {
            is_digit(c) && wrapping_sub(c, 48) <= radix_max
        };
        if ok {
            out.push(wrapping_u8(c));
            bump(inout t);
        } else if c == 95 {
            bump(inout t);
            let d = cur(in s, in t);
            let dok = if hex {
                is_hex(d)
            } else {
                is_digit(d) && wrapping_sub(d, 48) <= radix_max
            };
            if !dok {
                terr();
            }
        } else {
            break;
        }
    }
}

// `dec_int`: false on a backtrack; the digits (sign excluded) go to `out`
// and `neg` tells the sign.
fn dec_int(in s: Slice[u8], inout t: Toml, inout out: ChunkSeq[u8], inout neg: bool) -> bool eff [Fail[LintFail]] {
    out.clear();
    let c = cur(in s, in t);
    neg = false;
    if c == 43 || c == 45 {
        neg = c == 45;
        bump(inout t);
    }
    let d = cur(in s, in t);
    if d >= 49 && d <= 57 {
        out.push(wrapping_u8(d));
        bump(inout t);
        digit_run(in s, inout t, false, 9, inout out);
        true
    } else if d == 48 {
        out.push(48);
        bump(inout t);
        true
    } else {
        false
    }
}

// `zero_prefixable_int`, a cut: at least one digit.
fn zp_int(in s: Slice[u8], inout t: Toml, inout out: ChunkSeq[u8]) eff [Fail[LintFail]] {
    let d = cur(in s, in t);
    if !is_digit(d) {
        terr();
    }
    out.push(wrapping_u8(d));
    bump(inout t);
    digit_run(in s, inout t, false, 9, inout out);
}

// The smallest decimal that rounds to f64 infinity, 2^1024 - 2^970
// (ties round to even, which overflows), as its significant digits; its
// decimal exponent is 308 (one digit before the point).
fn inf_threshold() -> Str {
    ""
}

// Whether the decimal with `digits` (no leading zeros unless it is 0) and
// exponent `exp` (value = 0.d1d2... * 10^(exp)) is at least the infinity
// threshold.
fn overflows(in d: ChunkSeq[u8], exp: i64) -> bool {
    // Skip leading zeros of the significand.
    let n = d.len();
    let mut lead: u64 = 0;
    loop {
        if lead >= n || at(in d.as_slice(), lead) != 48 {
            break;
        }
        lead = inc(lead);
    }
    if lead == n {
        return false;
    }
    // The value is 0.d[lead..] * 10^(exp - lead); the threshold is
    // 0.T * 10^309.
    let e = wrapping_sub(exp, wrapping_i64(lead));
    if e < 309 {
        return false;
    }
    if e > 309 {
        return true;
    }
    let th = inf_threshold().as_bytes();
    let m = th.len();
    let mut i: u64 = 0;
    loop {
        let a = if wrapping_add(lead, i) < n {
            at(in d.as_slice(), wrapping_add(lead, i))
        } else {
            48
        };
        let b = if i < m {
            at(in th, i)
        } else {
            48
        };
        if a != b {
            return a > b;
        }
        if wrapping_add(lead, i) >= n && i >= m {
            return true;
        }
        i = inc(i);
    }
    false
}

// `float`: true when one was read (`float_` then the +infinity cut, or
// `special_float`), false on a backtrack.
fn float(in s: Slice[u8], inout t: Toml) -> bool eff [Fail[LintFail]] {
    let start = t.pos;
    let mut ip = ChunkSeq::new[u8]();
    let mut neg = false;
    if dec_int(in s, inout t, inout ip, inout neg) {
        let c = cur(in s, in t);
        if c == 101 || c == 69 || c == 46 {
            // The significand's digits and the decimal exponent of the
            // point after the integer part.
            let mut sig = ChunkSeq::new[u8]();
            sig.extend(in ip.as_slice());
            let point = ip.len();
            if c == 46 {
                bump(inout t);
                zp_int(in s, inout t, inout sig);
            }
            let mut exp: i64 = 0;
            let e = cur(in s, in t);
            if e == 101 || e == 69 {
                bump(inout t);
                let sc = cur(in s, in t);
                let mut eneg = false;
                if sc == 43 || sc == 45 {
                    eneg = sc == 45;
                    bump(inout t);
                }
                let mut ed = ChunkSeq::new[u8]();
                zp_int(in s, inout t, inout ed);
                // Saturate: beyond a few thousand the result is decided.
                let mut v: i64 = 0;
                for i in 0..ed.len() {
                    if v < 100000 {
                        v = wrapping_add(wrapping_mul(v, 10), wrapping_i64(wrapping_sub(at(in ed.as_slice(), i), 48)));
                    }
                }
                exp = if eneg {
                    wrapping_neg_i64(v)
                } else {
                    v
                };
            }
            if !neg && overflows(in sig, wrapping_add(exp, wrapping_i64(point))) {
                terr();
            }
            return true;
        }
    }
    // `special_float`.
    t.pos = start;
    let c = cur(in s, in t);
    if c == 43 || c == 45 {
        bump(inout t);
    }
    let a = cur(in s, in t);
    let b = peek_at(in s, in t, 1);
    let d = peek_at(in s, in t, 2);
    if (a == 105 && b == 110 && d == 102) || (a == 110 && b == 97 && d == 110) {
        t.pos = wrapping_add(t.pos, 3);
        return true;
    }
    false
}

// Whether the digits `d` (radix `r`: 2, 8, 10 or 16) are at most `max`.
fn fits(in d: ChunkSeq[u8], r: u64, max: u64) -> bool {
    let lim = if r == 16 {
        max / 16
    } else if r == 10 {
        max / 10
    } else if r == 8 {
        max / 8
    } else {
        max / 2
    };
    let rest = wrapping_sub(max, wrapping_mul(lim, r));
    let mut v: u64 = 0;
    for i in 0..d.len() {
        let x = hex_val(at(in d.as_slice(), i));
        if v > lim || (v == lim && x > rest) {
            return false;
        }
        v = wrapping_add(wrapping_mul(v, r), x);
    }
    true
}

// `integer` (cut throughout): hex, octal, binary or decimal, in i64 range.
fn integer(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let i64_max: u64 = 9223372036854775807;
    let c = cur(in s, in t);
    let p = peek_at(in s, in t, 1);
    let mut ds = ChunkSeq::new[u8]();
    if c == 48 && (p == 120 || p == 111 || p == 98) {
        t.pos = wrapping_add(t.pos, 2);
        let hex = p == 120;
        let r: u64 = if p == 120 {
            16
        } else if p == 111 {
            8
        } else {
            2
        };
        let d = cur(in s, in t);
        let first = if hex {
            is_hex(d)
        } else {
            is_digit(d) && wrapping_sub(d, 48) < r
        };
        if !first {
            terr();
        }
        digit_run(in s, inout t, hex, wrapping_sub(r, 1), inout ds);
        if !fits(in ds, r, i64_max) {
            terr();
        }
        return;
    }
    let mut neg = false;
    if !dec_int(in s, inout t, inout ds, inout neg) {
        terr();
    }
    let max = if neg {
        inc(i64_max)
    } else {
        i64_max
    };
    if !fits(in ds, 10, max) {
        terr();
    }
}

fn expect_word(in s: Slice[u8], inout t: Toml, in w: Str) eff [Fail[LintFail]] {
    let b = w.as_bytes();
    for i in 0..b.len() {
        if cur(in s, in t) != at(in b, i) {
            terr();
        }
        bump(inout t);
    }
}

// A string value at the cursor (`string`): its decoded bytes are
// `text[start..]`.
fn string_value(in s: Slice[u8], inout t: Toml) -> u32 eff [Fail[LintFail]] {
    let start = t.text.len();
    let q = cur(in s, in t);
    if peek_at(in s, in t, 1) == q && peek_at(in s, in t, 2) == q {
        t.pos = wrapping_add(t.pos, 3);
        if q == 34 {
            ml_basic_string(in s, inout t);
        } else {
            ml_literal_string(in s, inout t);
        }
    } else if q == 34 {
        basic_string(in s, inout t);
    } else {
        literal_string(in s, inout t);
    }
    let id = scalar(inout t, N_STRING);
    let mut n = node(in t, id);
    n.first = wrapping_u32(start);
    n.count = wrapping_u32(wrapping_sub(t.text.len(), start));
    set_node(inout t, id, n);
    id
}

// `value`.
fn value(in s: Slice[u8], inout t: Toml) -> u32 eff [Fail[LintFail]] {
    let c = cur(in s, in t);
    if c == 34 || c == 39 {
        string_value(in s, inout t)
    } else if c == 91 {
        array(in s, inout t)
    } else if c == 123 {
        inline_table(in s, inout t)
    } else if c == 43 || c == 45 || is_digit(c) {
        number(in s, inout t)
    } else if c == 116 {
        expect_word(in s, inout t, in "true");
        scalar(inout t, N_BOOL)
    } else if c == 102 {
        expect_word(in s, inout t, in "false");
        scalar(inout t, N_BOOL)
    } else if c == 105 {
        expect_word(in s, inout t, in "inf");
        scalar(inout t, N_FLOAT)
    } else if c == 110 {
        expect_word(in s, inout t, in "nan");
        scalar(inout t, N_FLOAT)
    } else {
        // `_` (integer) and `.` (float) fail too.
        terr();
        0
    }
}

fn array(in s: Slice[u8], inout t: Toml) -> u32 eff [Fail[LintFail]] {
    bump(inout t);
    let id = new_node(inout t, N_ARRAY, false, false);
    ws_comment_newline(in s, inout t);
    if cur(in s, in t) == 93 {
        bump(inout t);
        return id;
    }
    loop {
        let v = value(in s, inout t);
        append(inout t, id, 0, 0, 0, v);
        ws_comment_newline(in s, inout t);
        let c = cur(in s, in t);
        if c == 44 {
            bump(inout t);
            ws_comment_newline(in s, inout t);
            if cur(in s, in t) == 93 {
                bump(inout t);
                return id;
            }
        } else if c == 93 {
            bump(inout t);
            return id;
        } else {
            terr();
        }
    }
    id
}

fn inline_table(in s: Slice[u8], inout t: Toml) -> u32 eff [Fail[LintFail]] {
    bump(inout t);
    let id = new_node(inout t, N_INLINE, false, false);
    let save = t.pos;
    skip_ws(in s, inout t);
    if cur(in s, in t) == 125 {
        bump(inout t);
        return id;
    }
    t.pos = save;
    // The key paths of the pairs, kept while their values parse.
    let mut paths = ChunkSeq::new[u64]();
    let mut values = ChunkSeq::new[u32]();
    loop {
        key(in s, inout t);
        if cur(in s, in t) != 61 {
            terr();
        }
        bump(inout t);
        skip_ws(in s, inout t);
        paths.push(t.path.len());
        paths.extend(in t.path.as_slice());
        let v = value(in s, inout t);
        values.push(v);
        skip_ws(in s, inout t);
        let c = cur(in s, in t);
        if c == 44 {
            bump(inout t);
        } else if c == 125 {
            bump(inout t);
            break;
        } else {
            terr();
        }
    }
    // `table_from_pairs`.
    let mut j: u64 = 0;
    for k in 0..values.len() {
        let n = word(in paths.as_slice(), j);
        j = inc(j);
        t.path.clear();
        for i in 0..n {
            t.path.push(word(in paths.as_slice(), j));
            j = inc(j);
        }
        let v = u32_at(in values, k);
        insert_keyval(inout t, id, v, true);
    }
    id
}

// `[a.b]` (`on_std_header`): `path` holds the header's key.
fn std_header(inout t: Toml, root: u32) eff [Fail[LintFail]] {
    let n = path_parts(in t);
    let parent = descend(inout t, root, wrapping_sub(n, 1), false, false);
    let (ks, kl, h) = part(in t, wrapping_sub(n, 1));
    let e = lookup(in t, parent, ks, kl, h);
    if e == NONE {
        let table = new_node(inout t, N_TABLE, false, false);
        append(inout t, parent, ks, kl, h, table);
        t.current = table;
        return;
    }
    let child = ent(in t, e).child;
    let mut x = node(in t, child);
    if x.kind != N_TABLE || !x.implicit || x.dotted {
        terr();
    }
    // The implicit table is taken out and inserted again when the header's
    // table is finished, so it moves to the end of its parent.
    unlink(inout t, parent, e);
    append(inout t, parent, ks, kl, h, child);
    x.implicit = false;
    x.dotted = false;
    set_node(inout t, child, x);
    t.current = child;
}

// `[[a.b]]` (`on_array_header`).
fn array_header(inout t: Toml, root: u32) eff [Fail[LintFail]] {
    let n = path_parts(in t);
    let parent = descend(inout t, root, wrapping_sub(n, 1), false, false);
    let (ks, kl, h) = part(in t, wrapping_sub(n, 1));
    let e = lookup(in t, parent, ks, kl, h);
    let aot = if e == NONE {
        let a = new_node(inout t, N_AOT, false, false);
        append(inout t, parent, ks, kl, h, a);
        a
    } else {
        let a = ent(in t, e).child;
        if node(in t, a).kind != N_AOT {
            terr();
        }
        a
    };
    let table = new_node(inout t, N_TABLE, false, false);
    append(inout t, aot, 0, 0, 0, table);
    t.current = table;
}

// `document`: the root table's node id (0).
fn parse_toml(in s: Slice[u8], inout t: Toml) eff [Fail[LintFail]] {
    let root = new_node(inout t, N_TABLE, false, false);
    t.current = root;
    if at(in s, 0) == 239 && at(in s, 1) == 187 && at(in s, 2) == 191 {
        t.pos = 3;
    }
    skip_ws(in s, inout t);
    loop {
        let c = cur(in s, in t);
        if c == EOF {
            break;
        }
        if c == 35 {
            comment(in s, inout t);
            line_ending(in s, inout t);
        } else if c == 91 {
            if peek_at(in s, in t, 1) == 91 {
                t.pos = wrapping_add(t.pos, 2);
                key(in s, inout t);
                if cur(in s, in t) != 93 || peek_at(in s, in t, 1) != 93 {
                    terr();
                }
                t.pos = wrapping_add(t.pos, 2);
                line_trailing(in s, inout t);
                array_header(inout t, root);
            } else {
                bump(inout t);
                key(in s, inout t);
                if cur(in s, in t) != 93 {
                    terr();
                }
                bump(inout t);
                line_trailing(in s, inout t);
                std_header(inout t, root);
            }
        } else if c == 10 || c == 13 {
            newline(in s, inout t);
        } else {
            key(in s, inout t);
            if cur(in s, in t) != 61 {
                terr();
            }
            bump(inout t);
            skip_ws(in s, inout t);
            // The value may hold inline tables, which use `path`.
            let mut keep = ChunkSeq::new[u64]();
            keep.extend(in t.path.as_slice());
            let v = value(in s, inout t);
            line_trailing(in s, inout t);
            t.path.clear();
            t.path.extend(in keep.as_slice());
            let current = t.current;
            insert_keyval(inout t, current, v, false);
        }
        skip_ws(in s, inout t);
    }
}

// serde's private datetime marker: a table whose first key it is becomes
// a `toml::Value::Datetime` (or an error), parsed by toml_datetime.
fn marker_first(in t: Toml) -> bool {
    let m = "$__toml_private_datetime".as_bytes();
    for id in 0..t.nodes.len() {
        let n = node(in t, wrapping_u32(id));
        if (n.kind == N_TABLE || n.kind == N_INLINE) && n.first != NONE {
            let e = ent(in t, n.first);
            if widen_u64(e.klen) == m.len() {
                let mut same = true;
                for i in 0..m.len() {
                    if at(in t.text.as_slice(), wrapping_add(widen_u64(e.kstart), i)) != at(in m, i) {
                        same = false;
                    }
                }
                if same {
                    return true;
                }
            }
        }
    }
    false
}

// Byte order of two keys (`String`'s `Ord`).
fn key_lt(in t: Toml, a: u32, b: u32) -> bool {
    let x = ent(in t, a);
    let y = ent(in t, b);
    let xl = widen_u64(x.klen);
    let yl = widen_u64(y.klen);
    let n = if xl < yl {
        xl
    } else {
        yl
    };
    for i in 0..n {
        let p = at(in t.text.as_slice(), wrapping_add(widen_u64(x.kstart), i));
        let q = at(in t.text.as_slice(), wrapping_add(widen_u64(y.kstart), i));
        if p != q {
            return p < q;
        }
    }
    xl < yl
}

// The entries of table `c` in key order, appended to `out`.
fn sorted_entries(in t: Toml, c: u32, inout out: ChunkSeq[u32]) {
    let base = out.len();
    let mut e = node(in t, c).first;
    loop {
        if e == NONE {
            break;
        }
        // Insertion into the sorted tail (keys are distinct).
        out.push(e);
        let mut j = wrapping_sub(out.len(), 1);
        loop {
            if j <= base {
                break;
            }
            let prev = u32_at(in out, wrapping_sub(j, 1));
            if !key_lt(in t, e, prev) {
                break;
            }
            out.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        out.try_set(j, e);
        e = ent(in t, e).next;
    }
}

fn is_table(k: u8) -> bool {
    k == N_TABLE || k == N_INLINE
}

// `validate_value` over the tree from the root.
fn validate_tree(in t: Toml, inout b: Budget) eff [Fail[LintFail]] {
    // Pending (node, depth) pairs.
    let mut stack = ChunkSeq::new[u64]();
    stack.push(0);
    stack.push(0);
    let mut enqueued: u64 = 1;
    let mut order = ChunkSeq::new[u32]();
    loop {
        let n = stack.len();
        if n == 0 {
            break;
        }
        let depth = word(in stack.as_slice(), wrapping_sub(n, 1));
        let id = wrapping_u32(word(in stack.as_slice(), wrapping_sub(n, 2)));
        stack.truncate(wrapping_sub(n, 2));
        charge(inout b, 1);
        b.nodes = inc(b.nodes);
        if depth > b.lim.depth || b.nodes > b.lim.nodes {
            fail(P_VALUE_DEPTH);
        }
        let x = node(in t, id);
        if x.kind == N_STRING {
            text(inout b, widen_u64(x.count));
        } else if x.kind == N_INTEGER || x.kind == N_FLOAT || x.kind == N_BOOL || x.kind == N_DATETIME {
            text(inout b, 8);
        } else {
            let len = widen_u64(x.count);
            enqueued = cadd(enqueued, len, P_TREE_OVERFLOW);
            if enqueued > b.lim.nodes {
                fail(P_NODE_LIMIT);
            }
            charge(inout b, len);
            if is_table(x.kind) {
                order.clear();
                sorted_entries(in t, id, inout order);
                for i in 0..order.len() {
                    let e = ent(in t, u32_at(in order, i));
                    if widen_u64(e.klen) > 128 {
                        fail(P_KEY_BYTES);
                    }
                    text(inout b, widen_u64(e.klen));
                    stack.push(widen_u64(e.child));
                    stack.push(inc(depth));
                }
            } else {
                let mut e = x.first;
                loop {
                    if e == NONE {
                        break;
                    }
                    let y = ent(in t, e);
                    stack.push(widen_u64(y.child));
                    stack.push(inc(depth));
                    e = y.next;
                }
            }
        }
    }
}

// The policy's lints, in `LintName` order; 7 for an unknown name.
fn lint_name(in t: Toml, e: TEnt) -> u64 {
    let s = widen_u64(e.kstart);
    let l = widen_u64(e.klen);
    if text_is(in t, s, l, in "overbroad_inout_projection") {
        0
    } else if text_is(in t, s, l, in "unused_effect_capability") {
        1
    } else if text_is(in t, s, l, in "demote_alloc_to_region") {
        2
    } else if text_is(in t, s, l, in "overly_restrictive_mode") {
        3
    } else if text_is(in t, s, l, in "missed_fip_opportunity") {
        4
    } else if text_is(in t, s, l, in "early_cancel_checkpoint") {
        5
    } else if text_is(in t, s, l, in "unredacted_pii_boundary") {
        6
    } else {
        7
    }
}

fn text_is(in t: Toml, start: u64, len: u64, in w: Str) -> bool {
    let b = w.as_bytes();
    if len != b.len() {
        return false;
    }
    for i in 0..len {
        if at(in t.text.as_slice(), wrapping_add(start, i)) != at(in b, i) {
            return false;
        }
    }
    true
}

// The entry of root-level table `c` with key `w`, or NONE.
fn get_key(in t: Toml, c: u32, in w: Str) -> u32 {
    let mut e = node(in t, c).first;
    loop {
        if e == NONE {
            break;
        }
        let x = ent(in t, e);
        if text_is(in t, widen_u64(x.kstart), widen_u64(x.klen), in w) {
            return e;
        }
        e = x.next;
    }
    NONE
}

const SEV_ALLOW: u64 = 1;
const SEV_WARN: u64 = 2;
const SEV_DENY: u64 = 3;

// `Policy::from_validated_value`: writes the severity (0 for none) of each
// lint to `levels[0..7]` and the configured mask to `levels[7]`.
fn extract(in t: Toml, inout b: Budget, inout levels: ChunkSeq[u64]) eff [Fail[LintFail]] {
    let lints = get_key(in t, 0, in "lints");
    if lints == NONE {
        return;
    }
    let lt = ent(in t, lints).child;
    if !is_table(node(in t, lt).kind) {
        fail(P_LINTS_SHAPE);
    }
    let mut sections = ChunkSeq::new[u32]();
    sorted_entries(in t, lt, inout sections);
    for i in 0..sections.len() {
        charge(inout b, 1);
        let se = ent(in t, u32_at(in sections, i));
        let value = node(in t, se.child);
        if text_is(in t, widen_u64(se.kstart), widen_u64(se.klen), in "vesper") {
            if !is_table(value.kind) {
                fail(P_VESPER_SHAPE);
            }
            if widen_u64(value.count) > 7 {
                fail(P_RULE_COUNT);
            }
            let mut rules = ChunkSeq::new[u32]();
            sorted_entries(in t, se.child, inout rules);
            for r in 0..rules.len() {
                charge(inout b, 1);
                let re = ent(in t, u32_at(in rules, r));
                let v = node(in t, re.child);
                if v.kind != N_STRING {
                    fail(P_SEVERITY_STRING);
                }
                let vs = widen_u64(v.first);
                let vl = widen_u64(v.count);
                let sev = if text_is(in t, vs, vl, in "allow") {
                    SEV_ALLOW
                } else if text_is(in t, vs, vl, in "warn") {
                    SEV_WARN
                } else if text_is(in t, vs, vl, in "deny") {
                    SEV_DENY
                } else {
                    fail(P_SEVERITY);
                    0
                };
                // `Policy::insert` (keys of one table are distinct, so no
                // rule is configured twice).
                if widen_u64(re.klen) > 128 {
                    fail(P_POLICY_KEY);
                }
                let lint = lint_name(in t, re);
                if lint == 7 {
                    fail(P_UNKNOWN_RULE);
                }
                if lint >= 2 && sev == SEV_DENY {
                    fail(P_UNAVAILABLE_DENY);
                }
                levels.try_set(lint, sev);
                let mask = word(in levels.as_slice(), 7) | wrapping_shl_u64(1, wrapping_u32(lint));
                levels.try_set(7, mask);
            }
        } else if text_is(in t, widen_u64(se.kstart), widen_u64(se.klen), in "plugins") {
            if !is_table(value.kind) {
                fail(P_PLUGINS_SHAPE);
            }
            if value.count != 0 {
                fail(P_PLUGINS);
            }
        } else {
            fail(P_UNKNOWN_SECTION);
        }
    }
}

// `Policy::parse`. The result: the severities of the seven lints in
// `LintName` order (0 none, 1 allow, 2 warn, 3 deny), the configured mask,
// then the usage: decoded bytes, tokens, nodes and work.
pub fn policy_parse(in source: Str, bytes: u64, depth: u64, tokens: u64, nodes: u64, work: u64) -> ChunkSeq[u64] eff [Fail[LintFail]] {
    let lim = Limits {
        bytes: bytes,
        depth: depth,
        tokens: tokens,
        nodes: nodes,
        work: work
    };
    validate_limits(in lim);
    let mut b = Budget {
        lim: lim,
        work: 0,
        nodes: 0,
        value_bytes: 0
    };
    let s = source.as_bytes();
    let ntokens = preflight(in s, inout b);
    let mut t = Toml {
        nodes: ChunkSeq::new[TNode](),
        ents: ChunkSeq::new[TEnt](),
        text: ChunkSeq::new[u8](),
        path: ChunkSeq::new[u64](),
        current: 0,
        pos: 0
    };
    parse_toml(in s, inout t);
    if marker_first(in t) {
        fail(P_UNSUPPORTED);
    }
    validate_tree(in t, inout b);
    let mut levels = ChunkSeq::with_capacity[u64](13);
    levels.resize(8, 0);
    levels.try_set(0, SEV_WARN);
    levels.try_set(1, SEV_WARN);
    extract(in t, inout b, inout levels);
    levels.push(b.value_bytes);
    levels.push(ntokens);
    levels.push(b.nodes);
    levels.push(b.work);
    levels
}

// ================================================================ analyze
//
// crates/vesper-lint/src/lib.rs `analyze`. Error codes are the indices of
// `LINT_ERRORS` in port.rs; skip reasons below 16 index `SKIP_REASONS`, and
// `16 + k` is the reason text of action `k` of the program (`Opaque`; the
// actions of all functions in order, as the callee that has it may be any
// function the skipped one reaches).

const L_INVALID_LIMITS: u64 = 0;
const L_FUNCTION_LIMIT: u64 = 1;
const L_FACT_LIMIT: u64 = 3;
const L_SIGNATURE_LIMIT: u64 = 4;
const L_STRUCT_FIELD_LIMIT: u64 = 5;
const L_SUBSTITUTION_LIMIT: u64 = 6;
const L_PROJECTION_DEPTH: u64 = 7;
const L_TYPE_COMPLEXITY: u64 = 8;
const L_TYPE_ARITY: u64 = 9;
const L_ARROW_SHAPE: u64 = 10;
const L_NESTED_EFFECT_ARITY: u64 = 11;
const L_ROW_SHAPE: u64 = 12;
const L_EFFECT_ARITY: u64 = 13;
const L_WORK_LIMIT: u64 = 14;

const R_UNRESOLVED_CALLEE: u64 = 0;
const R_OPEN_ROW: u64 = 1;
const R_HIGHER_ORDER: u64 = 2;
const R_UNRESOLVED_INSTANCE: u64 = 3;
const R_RECURSIVE: u64 = 4;
const R_UNRESOLVED_CALL: u64 = 5;
const R_UNRESOLVED_SUBSTITUTION: u64 = 6;
const R_UNMAPPED: u64 = 7;
const R_OPAQUE: u64 = 16;

// `Type` kinds of @vesper/ast `TypeNode`.
const TY_NAMED: u8 = 1;
const TY_TUPLE: u8 = 2;
const TY_FUNCTION: u8 = 3;
const TY_ROW: u8 = 4;
const TY_INFER: u8 = 5;
const TY_INT_LITERAL: u8 = 6;

const PASS_INOUT: u8 = 1;

const A_PERFORM: u8 = 0;
const A_CALL: u8 = 1;
const A_ACCESS: u8 = 2;
const A_OPAQUE: u8 = 3;

// A function's facts (`FunctionFacts` and its `declaration`).
copy struct FnFacts {
    name: u32,
    owned: bool,
    body: bool,
    start: u64,
    end: u64,
    // Lists of GenericNode and ParamRow ids.
    generics: u32,
    params: u32,
    result: u32,
    effects: u32,
    act_first: u32,
    act_len: u32,
    // A list of ParamRow ids: `parameters` (the `ParameterFacts`).
    facts: u32
}

// A `Param`; `fields` is the list of `struct_fields` of a parameter fact.
copy struct ParamRow {
    name: u32,
    pass: u8,
    projections: u32,
    ty: u32,
    start: u64,
    end: u64,
    fields: u32
}

// An `Action`. Perform: `a` an EffectNode. Call: `a` the callee's name, `b`
// a list of (name, Type) pairs. Access: `a` the root, `b` the path (names).
copy struct ActRow {
    kind: u8,
    a: u32,
    b: u32,
    pass: u8,
    moves: bool
}

struct Prog {
    names: Interner,
    // Each symbol's bytes in the text blob, for ordering.
    sym_start: ChunkSeq[u64],
    sym_len: ChunkSeq[u64],
    types: ChunkSeq[TypeNode],
    ilits: ChunkSeq[u64],
    lists: ChunkSeq[ListRef],
    pool: ChunkSeq[u32],
    effs: ChunkSeq[EffectNode],
    rows: ChunkSeq[EffectsNode],
    generics: ChunkSeq[GenericNode],
    params: ChunkSeq[ParamRow],
    acts: ChunkSeq[ActRow],
    fns: ChunkSeq[FnFacts],
    // The function index of each symbol, NONE for none.
    fn_of: ChunkSeq[u32]
}

// The word stream's cursor.
copy struct Rd {
    pos: u64
}

fn rd(in w: Slice[u64], inout r: Rd) -> u64 {
    let v = word(in w, r.pos);
    r.pos = inc(r.pos);
    v
}

fn list_new(inout p: Prog, in items: ChunkSeq[u32]) -> u32 {
    let id = wrapping_u32(p.lists.len());
    p.lists.push(
        ListRef {
            first: wrapping_u32(p.pool.len()),
            len: wrapping_u32(items.len())
        }
    );
    p.pool.extend(in items.as_slice());
    id
}

fn list_len(in p: Prog, l: u32) -> u64 {
    match p.lists.try_get(widen_u64(l)) {
        Option::Some(r) => widen_u64(r.len),
        Option::None => 0,
    }
}

fn list_at(in p: Prog, l: u32, i: u64) -> u32 {
    match p.lists.try_get(widen_u64(l)) {
        Option::Some(r) => u32_at(in p.pool, wrapping_add(widen_u64(r.first), i)),
        Option::None => NONE,
    }
}

fn type_at(in p: Prog, t: u32) -> TypeNode {
    match p.types.try_get(widen_u64(t)) {
        Option::Some(n) => n,
        Option::None => TypeNode {
            kind: 0,
            a: 0,
            b: 0,
            c: 0,
            d: 0
        },
    }
}

fn eff_at(in p: Prog, e: u32) -> EffectNode {
    match p.effs.try_get(widen_u64(e)) {
        Option::Some(n) => n,
        Option::None => EffectNode {
            label: NONE,
            name: NONE,
            args: 0
        },
    }
}

fn row_at(in p: Prog, r: u32) -> EffectsNode {
    match p.rows.try_get(widen_u64(r)) {
        Option::Some(n) => n,
        Option::None => EffectsNode {
            instances: 0,
            tail: NONE
        },
    }
}

fn param_at(in p: Prog, i: u32) -> ParamRow {
    match p.params.try_get(widen_u64(i)) {
        Option::Some(n) => n,
        Option::None => ParamRow {
            name: NONE,
            pass: 0,
            projections: 0,
            ty: NONE,
            start: 0,
            end: 0,
            fields: 0
        },
    }
}

fn act_at(in p: Prog, i: u64) -> ActRow {
    match p.acts.try_get(i) {
        Option::Some(n) => n,
        Option::None => ActRow {
            kind: A_OPAQUE,
            a: NONE,
            b: 0,
            pass: 0,
            moves: false
        },
    }
}

fn fn_at(in p: Prog, i: u64) -> FnFacts {
    match p.fns.try_get(i) {
        Option::Some(f) => f,
        Option::None => FnFacts {
            name: NONE,
            owned: false,
            body: false,
            start: 0,
            end: 0,
            generics: 0,
            params: 0,
            result: NONE,
            effects: 0,
            act_first: 0,
            act_len: 0,
            facts: 0
        },
    }
}

fn add_type(inout p: Prog, n: TypeNode) -> u32 {
    let id = wrapping_u32(p.types.len());
    p.types.push(n);
    id
}

// A name: its (start, len) words in the text blob, interned.
fn rd_name(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    let start = rd(in w, inout r);
    let len = rd(in w, inout r);
    let before = p.names.len();
    let sym = p.names.intern(in blob[start..wrapping_add(start, len)]);
    if p.names.len() != before {
        p.sym_start.push(start);
        p.sym_len.push(len);
    }
    sym.id()
}

fn rd_opt_name(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    if rd(in w, inout r) == 0 {
        NONE
    } else {
        rd_name(in w, inout r, inout p, in blob)
    }
}

fn rd_types(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    let n = rd(in w, inout r);
    let mut items = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        items.push(rd_type(in w, inout r, inout p, in blob));
    }
    list_new(inout p, in items)
}

fn rd_effect(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    let label = rd_opt_name(in w, inout r, inout p, in blob);
    let name = rd_name(in w, inout r, inout p, in blob);
    let args = rd_types(in w, inout r, inout p, in blob);
    let id = wrapping_u32(p.effs.len());
    p.effs.push(
        EffectNode {
            label: label,
            name: name,
            args: args
        }
    );
    id
}

fn rd_effects(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    let n = rd(in w, inout r);
    let mut items = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        items.push(rd_effect(in w, inout r, inout p, in blob));
    }
    let instances = list_new(inout p, in items);
    let tail = rd_opt_name(in w, inout r, inout p, in blob);
    let id = wrapping_u32(p.rows.len());
    p.rows.push(
        EffectsNode {
            instances: instances,
            tail: tail
        }
    );
    id
}

fn rd_type(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    let tag = rd(in w, inout r);
    if tag == 0 {
        let at = wrapping_u32(p.ilits.len());
        p.ilits.push(rd(in w, inout r));
        p.ilits.push(rd(in w, inout r));
        add_type(
            inout p,
            TypeNode {
                kind: TY_INT_LITERAL,
                a: at,
                b: 0,
                c: 0,
                d: 0
            }
        )
    } else if tag == 1 {
        let name = rd_name(in w, inout r, inout p, in blob);
        let args = rd_types(in w, inout r, inout p, in blob);
        add_type(
            inout p,
            TypeNode {
                kind: TY_NAMED,
                a: name,
                b: args,
                c: 0,
                d: 0
            }
        )
    } else if tag == 2 {
        let args = rd_types(in w, inout r, inout p, in blob);
        add_type(
            inout p,
            TypeNode {
                kind: TY_TUPLE,
                a: args,
                b: 0,
                c: 0,
                d: 0
            }
        )
    } else if tag == 3 {
        let n = rd(in w, inout r);
        let mut items = ChunkSeq::with_capacity[u32](wrapping_mul(n, 2));
        for i in 0..n {
            items.push(wrapping_u32(rd(in w, inout r)));
            items.push(rd_type(in w, inout r, inout p, in blob));
        }
        let params = list_new(inout p, in items);
        let result = rd_type(in w, inout r, inout p, in blob);
        let effects = rd_effects(in w, inout r, inout p, in blob);
        let mode = wrapping_u32(rd(in w, inout r));
        add_type(
            inout p,
            TypeNode {
                kind: TY_FUNCTION,
                a: params,
                b: result,
                c: effects,
                d: mode
            }
        )
    } else if tag == 4 {
        let effects = rd_effects(in w, inout r, inout p, in blob);
        add_type(
            inout p,
            TypeNode {
                kind: TY_ROW,
                a: effects,
                b: 0,
                c: 0,
                d: 0
            }
        )
    } else {
        add_type(
            inout p,
            TypeNode {
                kind: TY_INFER,
                a: 0,
                b: 0,
                c: 0,
                d: 0
            }
        )
    }
}

fn rd_param(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) -> u32 {
    let name = rd_name(in w, inout r, inout p, in blob);
    let pass = wrapping_u8(rd(in w, inout r));
    let n = rd(in w, inout r);
    let mut projections = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        let m = rd(in w, inout r);
        let mut names = ChunkSeq::with_capacity[u32](m);
        for j in 0..m {
            names.push(rd_name(in w, inout r, inout p, in blob));
        }
        projections.push(list_new(inout p, in names));
    }
    let projections = list_new(inout p, in projections);
    let ty = rd_type(in w, inout r, inout p, in blob);
    let start = rd(in w, inout r);
    let end = rd(in w, inout r);
    let id = wrapping_u32(p.params.len());
    p.params.push(
        ParamRow {
            name: name,
            pass: pass,
            projections: projections,
            ty: ty,
            start: start,
            end: end,
            fields: 0
        }
    );
    id
}

fn rd_function(in w: Slice[u64], inout r: Rd, inout p: Prog, in blob: Str) {
    let name = rd_name(in w, inout r, inout p, in blob);
    let owned = rd(in w, inout r) != 0;
    let body = rd(in w, inout r) != 0;
    let start = rd(in w, inout r);
    let end = rd(in w, inout r);
    let ng = rd(in w, inout r);
    let mut gs = ChunkSeq::with_capacity[u32](ng);
    for i in 0..ng {
        let gname = rd_name(in w, inout r, inout p, in blob);
        let bound = wrapping_u8(rd(in w, inout r));
        let row = rd(in w, inout r) != 0;
        gs.push(wrapping_u32(p.generics.len()));
        p.generics.push(
            GenericNode {
                name: gname,
                bound: bound,
                row: row
            }
        );
    }
    let generics = list_new(inout p, in gs);
    let np = rd(in w, inout r);
    let mut ps = ChunkSeq::with_capacity[u32](np);
    for i in 0..np {
        ps.push(rd_param(in w, inout r, inout p, in blob));
    }
    let params = list_new(inout p, in ps);
    let result = rd_type(in w, inout r, inout p, in blob);
    let effects = rd_effects(in w, inout r, inout p, in blob);
    let na = rd(in w, inout r);
    let act_first = wrapping_u32(p.acts.len());
    for i in 0..na {
        let kind = wrapping_u8(rd(in w, inout r));
        if kind == A_PERFORM {
            let e = rd_effect(in w, inout r, inout p, in blob);
            p.acts.push(
                ActRow {
                    kind: kind,
                    a: e,
                    b: 0,
                    pass: 0,
                    moves: false
                }
            );
        } else if kind == A_CALL {
            let callee = rd_name(in w, inout r, inout p, in blob);
            let n = rd(in w, inout r);
            let mut subs = ChunkSeq::with_capacity[u32](wrapping_mul(n, 2));
            for j in 0..n {
                subs.push(rd_name(in w, inout r, inout p, in blob));
                subs.push(rd_type(in w, inout r, inout p, in blob));
            }
            let b = list_new(inout p, in subs);
            p.acts.push(
                ActRow {
                    kind: kind,
                    a: callee,
                    b: b,
                    pass: 0,
                    moves: false
                }
            );
        } else if kind == A_ACCESS {
            let root = rd_name(in w, inout r, inout p, in blob);
            let n = rd(in w, inout r);
            let mut path = ChunkSeq::with_capacity[u32](n);
            for j in 0..n {
                path.push(rd_name(in w, inout r, inout p, in blob));
            }
            let b = list_new(inout p, in path);
            let pass = wrapping_u8(rd(in w, inout r));
            let moves = rd(in w, inout r) != 0;
            p.acts.push(
                ActRow {
                    kind: kind,
                    a: root,
                    b: b,
                    pass: pass,
                    moves: moves
                }
            );
        } else {
            p.acts.push(
                ActRow {
                    kind: A_OPAQUE,
                    a: NONE,
                    b: 0,
                    pass: 0,
                    moves: false
                }
            );
        }
    }
    let nf = rd(in w, inout r);
    let mut fs = ChunkSeq::with_capacity[u32](nf);
    for i in 0..nf {
        let id = rd_param(in w, inout r, inout p, in blob);
        let m = rd(in w, inout r);
        let mut fields = ChunkSeq::with_capacity[u32](m);
        for j in 0..m {
            fields.push(rd_name(in w, inout r, inout p, in blob));
        }
        let mut row = param_at(in p, id);
        row.fields = list_new(inout p, in fields);
        p.params.try_set(widen_u64(id), row);
        fs.push(id);
    }
    let facts = list_new(inout p, in fs);
    p.fns.push(
        FnFacts {
            name: name,
            owned: owned,
            body: body,
            start: start,
            end: end,
            generics: generics,
            params: params,
            result: result,
            effects: effects,
            act_first: act_first,
            act_len: wrapping_u32(na),
            facts: facts
        }
    );
}

fn decode(in w: Slice[u64], in blob: Str) -> Prog {
    let mut p = Prog {
        names: interner_new(),
        sym_start: ChunkSeq::new[u64](),
        sym_len: ChunkSeq::new[u64](),
        types: ChunkSeq::new[TypeNode](),
        ilits: ChunkSeq::new[u64](),
        lists: ChunkSeq::new[ListRef](),
        pool: ChunkSeq::new[u32](),
        effs: ChunkSeq::new[EffectNode](),
        rows: ChunkSeq::new[EffectsNode](),
        generics: ChunkSeq::new[GenericNode](),
        params: ChunkSeq::new[ParamRow](),
        acts: ChunkSeq::new[ActRow](),
        fns: ChunkSeq::new[FnFacts](),
        fn_of: ChunkSeq::new[u32]()
    };
    let mut r = Rd {
        pos: 0
    };
    let n = rd(in w, inout r);
    for i in 0..n {
        rd_function(in w, inout r, inout p, in blob);
    }
    p.fn_of.resize(p.names.len(), NONE);
    for i in 0..p.fns.len() {
        let f = fn_at(in p, i);
        p.fn_of.try_set(widen_u64(f.name), wrapping_u32(i));
    }
    p
}

// ---------------------------------------------------------------- limits

// `validate_type`: the explicit stack walk, error for error.
fn validate_type(in p: Prog, ty: u32) eff [Fail[LintFail]] {
    // (type, depth) pairs.
    let mut stack = ChunkSeq::new[u64]();
    stack.push(widen_u64(ty));
    stack.push(0);
    let mut nodes: u64 = 0;
    loop {
        let n = stack.len();
        if n == 0 {
            break;
        }
        let depth = word(in stack.as_slice(), wrapping_sub(n, 1));
        let t = wrapping_u32(word(in stack.as_slice(), wrapping_sub(n, 2)));
        stack.truncate(wrapping_sub(n, 2));
        nodes = inc(nodes);
        if depth > 32 || nodes > 512 {
            fail(L_TYPE_COMPLEXITY);
        }
        let x = type_at(in p, t);
        let d = inc(depth);
        if x.kind == TY_NAMED || x.kind == TY_TUPLE {
            let args = if x.kind == TY_NAMED {
                x.b
            } else {
                x.a
            };
            let len = list_len(in p, args);
            if len > 512 {
                fail(L_TYPE_ARITY);
            }
            for i in 0..len {
                stack.push(widen_u64(list_at(in p, args, i)));
                stack.push(d);
            }
        } else if x.kind == TY_FUNCTION {
            let row = row_at(in p, x.c);
            let np = list_len(in p, x.a) / 2;
            if np > 128 || list_len(in p, row.instances) > 64 {
                fail(L_ARROW_SHAPE);
            }
            for i in 0..np {
                stack.push(widen_u64(list_at(in p, x.a, inc(wrapping_mul(i, 2)))));
                stack.push(d);
            }
            stack.push(widen_u64(x.b));
            stack.push(d);
            push_row_args(in p, row, inout stack, d);
        } else if x.kind == TY_ROW {
            let row = row_at(in p, x.a);
            if list_len(in p, row.instances) > 64 {
                fail(L_ROW_SHAPE);
            }
            push_row_args(in p, row, inout stack, d);
        }
    }
}

fn push_row_args(in p: Prog, row: EffectsNode, inout stack: ChunkSeq[u64], d: u64) eff [Fail[LintFail]] {
    for i in 0..list_len(in p, row.instances) {
        let e = eff_at(in p, list_at(in p, row.instances, i));
        let n = list_len(in p, e.args);
        if n > 64 {
            fail(L_NESTED_EFFECT_ARITY);
        }
        for j in 0..n {
            stack.push(widen_u64(list_at(in p, e.args, j)));
            stack.push(d);
        }
    }
}

fn validate_effect(in p: Prog, e: u32) eff [Fail[LintFail]] {
    let x = eff_at(in p, e);
    let n = list_len(in p, x.args);
    if n > 64 {
        fail(L_EFFECT_ARITY);
    }
    for i in 0..n {
        validate_type(in p, list_at(in p, x.args, i));
    }
}

// The limit checks of `analyze`, in its order.
fn check_limits(in p: Prog, functions: u64, actions: u64, work: u64, depth: u64) eff [Fail[LintFail]] {
    if functions == 0
        || functions > 256
        || actions == 0
        || actions > 16384
        || work == 0
        || work > 1000000
        || depth == 0
        || depth > 64 {
        fail(L_INVALID_LIMITS);
    }
    if p.fns.len() > functions {
        fail(L_FUNCTION_LIMIT);
    }
    let mut count: u64 = 0;
    for i in 0..p.fns.len() {
        let f = fn_at(in p, i);
        count = wrapping_add(count, widen_u64(f.act_len));
        let row = row_at(in p, f.effects);
        if count > actions || list_len(in p, row.instances) > 64 || list_len(in p, f.facts) > 128 {
            fail(L_FACT_LIMIT);
        }
        if list_len(in p, f.params) > 128 || list_len(in p, f.generics) > 64 {
            fail(L_SIGNATURE_LIMIT);
        }
        validate_type(in p, f.result);
        for j in 0..list_len(in p, f.params) {
            validate_type(in p, param_at(in p, list_at(in p, f.params, j)).ty);
        }
        for j in 0..list_len(in p, f.facts) {
            let q = param_at(in p, list_at(in p, f.facts, j));
            validate_type(in p, q.ty);
            if list_len(in p, q.fields) > 128 {
                fail(L_STRUCT_FIELD_LIMIT);
            }
        }
        for j in 0..list_len(in p, row.instances) {
            validate_effect(in p, list_at(in p, row.instances, j));
        }
        for j in 0..widen_u64(f.act_len) {
            let a = act_at(in p, wrapping_add(widen_u64(f.act_first), j));
            if a.kind == A_PERFORM {
                validate_effect(in p, a.a);
            } else if a.kind == A_CALL {
                let n = list_len(in p, a.b) / 2;
                if n > 64 {
                    fail(L_SUBSTITUTION_LIMIT);
                }
                for k in 0..n {
                    validate_type(in p, list_at(in p, a.b, inc(wrapping_mul(k, 2))));
                }
            } else if a.kind == A_ACCESS {
                if list_len(in p, a.b) > 32 {
                    fail(L_PROJECTION_DEPTH);
                }
            }
        }
    }
}

// ---------------------------------------------------------------- types

fn opaque_type(in p: Prog, t: u32) -> bool {
    let x = type_at(in p, t);
    if x.kind == TY_NAMED || x.kind == TY_TUPLE {
        let args = if x.kind == TY_NAMED {
            x.b
        } else {
            x.a
        };
        for i in 0..list_len(in p, args) {
            if opaque_type(in p, list_at(in p, args, i)) {
                return true;
            }
        }
        false
    } else {
        true
    }
}

fn types_eq(in p: Prog, a: u32, b: u32) -> bool {
    let n = list_len(in p, a);
    if n != list_len(in p, b) {
        return false;
    }
    for i in 0..n {
        if !type_eq(in p, list_at(in p, a, i), list_at(in p, b, i)) {
            return false;
        }
    }
    true
}

fn effect_eq(in p: Prog, a: u32, b: u32) -> bool {
    if a == b {
        return true;
    }
    let x = eff_at(in p, a);
    let y = eff_at(in p, b);
    x.label == y.label && x.name == y.name && types_eq(in p, x.args, y.args)
}

fn row_eq(in p: Prog, a: u32, b: u32) -> bool {
    let x = row_at(in p, a);
    let y = row_at(in p, b);
    if x.tail != y.tail {
        return false;
    }
    let n = list_len(in p, x.instances);
    if n != list_len(in p, y.instances) {
        return false;
    }
    for i in 0..n {
        if !effect_eq(in p, list_at(in p, x.instances, i), list_at(in p, y.instances, i)) {
            return false;
        }
    }
    true
}

// Structural `Type` equality.
fn type_eq(in p: Prog, a: u32, b: u32) -> bool {
    if a == b {
        return true;
    }
    let x = type_at(in p, a);
    let y = type_at(in p, b);
    if x.kind != y.kind {
        return false;
    }
    if x.kind == TY_NAMED {
        x.a == y.a && types_eq(in p, x.b, y.b)
    } else if x.kind == TY_TUPLE {
        types_eq(in p, x.a, y.a)
    } else if x.kind == TY_FUNCTION {
        let n = list_len(in p, x.a);
        if n != list_len(in p, y.a) || x.d != y.d {
            return false;
        }
        for i in 0..n {
            let u = list_at(in p, x.a, i);
            let v = list_at(in p, y.a, i);
            if i % 2 == 0 {
                if u != v {
                    return false;
                }
            } else if !type_eq(in p, u, v) {
                return false;
            }
        }
        type_eq(in p, x.b, y.b) && row_eq(in p, x.c, y.c)
    } else if x.kind == TY_ROW {
        row_eq(in p, x.a, y.a)
    } else if x.kind == TY_INT_LITERAL {
        word(in p.ilits.as_slice(), widen_u64(x.a)) == word(in p.ilits.as_slice(), widen_u64(y.a))
            && word(in p.ilits.as_slice(), inc(widen_u64(x.a))) == word(in p.ilits.as_slice(), inc(widen_u64(y.a)))
    } else {
        true
    }
}

// `substitute` for the types that reach it (named and tuple types: the
// effect arguments `required` returns are never opaque). `subs` is a list
// of (name, Type) pairs.
fn substitute(inout p: Prog, t: u32, subs: u32) -> u32 {
    let x = type_at(in p, t);
    if x.kind == TY_NAMED {
        let n = list_len(in p, x.b);
        if n == 0 {
            for i in 0..list_len(in p, subs) / 2 {
                if list_at(in p, subs, wrapping_mul(i, 2)) == x.a {
                    return list_at(in p, subs, inc(wrapping_mul(i, 2)));
                }
            }
            return t;
        }
        let mut items = ChunkSeq::with_capacity[u32](n);
        for i in 0..n {
            let a = list_at(in p, x.b, i);
            items.push(substitute(inout p, a, subs));
        }
        let args = list_new(inout p, in items);
        add_type(
            inout p,
            TypeNode {
                kind: TY_NAMED,
                a: x.a,
                b: args,
                c: 0,
                d: 0
            }
        )
    } else if x.kind == TY_TUPLE {
        let n = list_len(in p, x.a);
        let mut items = ChunkSeq::with_capacity[u32](n);
        for i in 0..n {
            let a = list_at(in p, x.a, i);
            items.push(substitute(inout p, a, subs));
        }
        let args = list_new(inout p, in items);
        add_type(
            inout p,
            TypeNode {
                kind: TY_TUPLE,
                a: args,
                b: 0,
                c: 0,
                d: 0
            }
        )
    } else {
        t
    }
}

// ---------------------------------------------------------------- required

struct Work {
    remaining: u64,
    used: u64,
    depth: u64
}

fn tick(inout w: Work) eff [Fail[LintFail]] {
    if w.remaining == 0 {
        fail(L_WORK_LIMIT);
    }
    w.remaining = wrapping_sub(w.remaining, 1);
    w.used = inc(w.used);
}

// `required`'s result: `reason` is NONE-as-u64 for `Ok(effects)`.
struct Req {
    reason: u64,
    effects: ChunkSeq[u32]
}

const OK: u64 = 18446744073709551615;

fn req_err(reason: u64) -> Req {
    Req {
        reason: reason,
        effects: ChunkSeq::new[u32]()
    }
}

// `resolve`: the last instance of `row` matching `request`, or NONE.
fn resolve(in p: Prog, row: u32, request: u32) -> u32 {
    let inst = row_at(in p, row).instances;
    let q = eff_at(in p, request);
    let mut i = list_len(in p, inst);
    loop {
        if i == 0 {
            break;
        }
        i = wrapping_sub(i, 1);
        let id = list_at(in p, inst, i);
        let e = eff_at(in p, id);
        if e.name == q.name && types_eq(in p, e.args, q.args) && (q.label == NONE || e.label == q.label) {
            return id;
        }
    }
    NONE
}

fn contains_effect(in p: Prog, in list: ChunkSeq[u32], e: u32) -> bool {
    for i in 0..list.len() {
        if effect_eq(in p, u32_at(in list, i), e) {
            return true;
        }
    }
    false
}

fn required(inout p: Prog, name: u32, inout seen: ChunkSeq[bool], inout depth: u64, inout w: Work) -> Req eff [Fail[LintFail]] {
    tick(inout w);
    let fi = u32_at(in p.fn_of, widen_u64(name));
    if fi == NONE {
        return req_err(R_UNRESOLVED_CALLEE);
    }
    let f = fn_at(in p, widen_u64(fi));
    let row = row_at(in p, f.effects);
    if row.tail != NONE {
        return req_err(R_OPEN_ROW);
    }
    for i in 0..list_len(in p, f.generics) {
        match p.generics.try_get(widen_u64(list_at(in p, f.generics, i))) {
            Option::Some(g) => {
                if g.row {
                    return req_err(R_OPEN_ROW);
                }
            },
            Option::None => {},
        }
    }
    for i in 0..list_len(in p, f.params) {
        if opaque_type(in p, param_at(in p, list_at(in p, f.params, i)).ty) {
            return req_err(R_HIGHER_ORDER);
        }
    }
    if opaque_type(in p, f.result) {
        return req_err(R_HIGHER_ORDER);
    }
    for i in 0..list_len(in p, row.instances) {
        let e = eff_at(in p, list_at(in p, row.instances, i));
        for j in 0..list_len(in p, e.args) {
            if opaque_type(in p, list_at(in p, e.args, j)) {
                return req_err(R_UNRESOLVED_INSTANCE);
            }
        }
    }
    if !f.owned || !f.body {
        let mut out = ChunkSeq::new[u32]();
        for i in 0..list_len(in p, row.instances) {
            out.push(list_at(in p, row.instances, i));
        }
        return Req {
            reason: OK,
            effects: out
        };
    }
    let at_seen = match seen.try_get(widen_u64(fi)) {
        Option::Some(b) => b,
        Option::None => false,
    };
    if depth >= w.depth || at_seen {
        return req_err(R_RECURSIVE);
    }
    seen.try_set(widen_u64(fi), true);
    depth = inc(depth);
    let result = required_body(inout p, f, inout seen, inout depth, inout w);
    seen.try_set(widen_u64(fi), false);
    depth = wrapping_sub(depth, 1);
    result
}

fn required_body(inout p: Prog, f: FnFacts, inout seen: ChunkSeq[bool], inout depth: u64, inout w: Work) -> Req eff [Fail[LintFail]] {
    let mut out = ChunkSeq::new[u32]();
    let mut requested = ChunkSeq::new[u32]();
    for k in 0..widen_u64(f.act_len) {
        tick(inout w);
        let a = act_at(in p, wrapping_add(widen_u64(f.act_first), k));
        requested.clear();
        if a.kind == A_PERFORM {
            requested.push(a.a);
        } else if a.kind == A_CALL {
            let ti = u32_at(in p.fn_of, widen_u64(a.a));
            if ti == NONE {
                return req_err(R_UNRESOLVED_CALL);
            }
            let target = fn_at(in p, widen_u64(ti));
            let nsubs = list_len(in p, a.b) / 2;
            for i in 0..list_len(in p, target.generics) {
                let gname = match p.generics.try_get(widen_u64(list_at(in p, target.generics, i))) {
                    Option::Some(g) => g.name,
                    Option::None => NONE,
                };
                let mut found = false;
                for j in 0..nsubs {
                    if list_at(in p, a.b, wrapping_mul(j, 2)) == gname {
                        found = true;
                    }
                }
                if !found {
                    return req_err(R_UNRESOLVED_SUBSTITUTION);
                }
            }
            for j in 0..nsubs {
                if opaque_type(in p, list_at(in p, a.b, inc(wrapping_mul(j, 2)))) {
                    return req_err(R_UNRESOLVED_SUBSTITUTION);
                }
            }
            let callee = required(inout p, a.a, inout seen, inout depth, inout w);
            if callee.reason != OK {
                return req_err(callee.reason);
            }
            for i in 0..callee.effects.len() {
                let e = eff_at(in p, u32_at(in callee.effects, i));
                let n = list_len(in p, e.args);
                let mut items = ChunkSeq::with_capacity[u32](n);
                for j in 0..n {
                    let t = list_at(in p, e.args, j);
                    items.push(substitute(inout p, t, a.b));
                }
                let args = list_new(inout p, in items);
                let id = wrapping_u32(p.effs.len());
                p.effs.push(
                    EffectNode {
                        label: e.label,
                        name: e.name,
                        args: args
                    }
                );
                requested.push(id);
            }
        } else if a.kind == A_OPAQUE {
            return req_err(wrapping_add(R_OPAQUE, wrapping_add(widen_u64(f.act_first), k)));
        } else {
            continue;
        }
        for i in 0..requested.len() {
            let found = resolve(in p, f.effects, u32_at(in requested, i));
            if found == NONE {
                return req_err(R_UNMAPPED);
            }
            if !contains_effect(in p, in out, found) {
                out.push(found);
            }
        }
    }
    Req {
        reason: OK,
        effects: out
    }
}

// ---------------------------------------------------------------- display

fn put_sym(inout o: ChunkSeq[u8], in p: Prog, in blob: Str, sym: u32) {
    let s = word(in p.sym_start.as_slice(), widen_u64(sym));
    let n = word(in p.sym_len.as_slice(), widen_u64(sym));
    let x = blob.as_bytes();
    o.extend(in x[s..wrapping_add(s, n)]);
}

fn sym_is(in p: Prog, in blob: Str, sym: u32, in w: Str) -> bool {
    let s = word(in p.sym_start.as_slice(), widen_u64(sym));
    let n = word(in p.sym_len.as_slice(), widen_u64(sym));
    let b = w.as_bytes();
    if n != b.len() {
        return false;
    }
    let x = blob.as_bytes();
    for i in 0..n {
        if at(in x, wrapping_add(s, i)) != at(in b, i) {
            return false;
        }
    }
    true
}

fn put_types(inout o: ChunkSeq[u8], in p: Prog, in blob: Str, list: u32, stride: u64, offset: u64) {
    let n = if stride == 2 {
        list_len(in p, list) / 2
    } else {
        list_len(in p, list)
    };
    for i in 0..n {
        if i != 0 {
            put(inout o, in ", ");
        }
        put_type(inout o, in p, in blob, list_at(in p, list, wrapping_add(wrapping_mul(i, stride), offset)));
    }
}

// `Display for Type` for the types that reach a message (named and tuple
// types: the effects of a finding are never opaque; the function arrow and
// `_` are kept for completeness).
fn put_type(inout o: ChunkSeq[u8], in p: Prog, in blob: Str, t: u32) {
    let x = type_at(in p, t);
    if x.kind == TY_NAMED {
        if sym_is(in p, in blob, x.a, in "dyn") && list_len(in p, x.b) == 1 {
            put(inout o, in "dyn ");
            put_type(inout o, in p, in blob, list_at(in p, x.b, 0));
            return;
        }
        put_sym(inout o, in p, in blob, x.a);
        if list_len(in p, x.b) != 0 {
            o.push(91);
            put_types(inout o, in p, in blob, x.b, 1, 0);
            o.push(93);
        }
    } else if x.kind == TY_TUPLE {
        o.push(40);
        put_types(inout o, in p, in blob, x.a, 1, 0);
        o.push(41);
    } else if x.kind == TY_FUNCTION {
        put(inout o, in "fn(");
        put_types(inout o, in p, in blob, x.a, 2, 1);
        put(inout o, in ") -> ");
        put_type(inout o, in p, in blob, x.b);
    } else {
        o.push(95);
    }
}

fn put_effect(inout o: ChunkSeq[u8], in p: Prog, in blob: Str, e: u32) {
    let x = eff_at(in p, e);
    if x.label != NONE {
        put_sym(inout o, in p, in blob, x.label);
        put(inout o, in ": ");
    }
    put_sym(inout o, in p, in blob, x.name);
    if list_len(in p, x.args) != 0 {
        o.push(91);
        put_types(inout o, in p, in blob, x.args, 1, 0);
        o.push(93);
    }
}

// ---------------------------------------------------------------- paths

// Byte order of two symbols.
fn sym_cmp(in p: Prog, in blob: Str, a: u32, b: u32) -> i64 {
    if a == b {
        return 0;
    }
    let x = blob.as_bytes();
    let sa = word(in p.sym_start.as_slice(), widen_u64(a));
    let la = word(in p.sym_len.as_slice(), widen_u64(a));
    let sb = word(in p.sym_start.as_slice(), widen_u64(b));
    let lb = word(in p.sym_len.as_slice(), widen_u64(b));
    let n = if la < lb {
        la
    } else {
        lb
    };
    for i in 0..n {
        let u = at(in x, wrapping_add(sa, i));
        let v = at(in x, wrapping_add(sb, i));
        if u != v {
            return if u < v {
                -1
            } else {
                1
            };
        }
    }
    if la < lb {
        -1
    } else if la > lb {
        1
    } else {
        0
    }
}

// `Vec<String>` order of two paths (lists of names).
fn path_lt(in p: Prog, in blob: Str, a: u32, b: u32) -> bool {
    let n = list_len(in p, a);
    let m = list_len(in p, b);
    let k = if n < m {
        n
    } else {
        m
    };
    for i in 0..k {
        let c = sym_cmp(in p, in blob, list_at(in p, a, i), list_at(in p, b, i));
        if c != 0 {
            return c < 0;
        }
    }
    n < m
}

fn path_eq(in p: Prog, a: u32, b: u32) -> bool {
    let n = list_len(in p, a);
    if n != list_len(in p, b) {
        return false;
    }
    for i in 0..n {
        if list_at(in p, a, i) != list_at(in p, b, i) {
            return false;
        }
    }
    true
}

// Whether path `a` starts with path `b`.
fn starts_with(in p: Prog, a: u32, b: u32) -> bool {
    let n = list_len(in p, b);
    if n > list_len(in p, a) {
        return false;
    }
    for i in 0..n {
        if list_at(in p, a, i) != list_at(in p, b, i) {
            return false;
        }
    }
    true
}

// Sorts `paths` (action indices, each an Access) by path, merging runs.
fn sort_paths(in p: Prog, in blob: Str, f: FnFacts, inout paths: ChunkSeq[u32]) {
    let n = paths.len();
    if n < 2 {
        return;
    }
    let mut src = ChunkSeq::with_capacity[u32](n);
    src.extend(in paths.as_slice());
    let mut dst = ChunkSeq::with_capacity[u32](n);
    dst.resize(n, 0);
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = if wrapping_add(lo, width) < n {
                wrapping_add(lo, width)
            } else {
                n
            };
            let hi = if wrapping_add(mid, width) < n {
                wrapping_add(mid, width)
            } else {
                n
            };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            loop {
                if k >= hi {
                    break;
                }
                let take_right = if i >= mid {
                    true
                } else if j >= hi {
                    false
                } else {
                    let a = act_path(in p, f, u32_at(in src, j));
                    let b = act_path(in p, f, u32_at(in src, i));
                    path_lt(in p, in blob, a, b)
                };
                if take_right {
                    dst.try_set(k, u32_at(in src, j));
                    j = inc(j);
                } else {
                    dst.try_set(k, u32_at(in src, i));
                    i = inc(i);
                }
                k = inc(k);
            }
            lo = hi;
        }
        src.clear();
        src.extend(in dst.as_slice());
        width = wrapping_mul(width, 2);
    }
    paths.clear();
    paths.extend(in src.as_slice());
}

fn act_path(in p: Prog, f: FnFacts, k: u32) -> u32 {
    act_at(in p, wrapping_add(widen_u64(f.act_first), widen_u64(k))).b
}

// `minimize`: sorted, without paths that extend a kept one.
fn minimize(in p: Prog, in blob: Str, f: FnFacts, inout paths: ChunkSeq[u32]) {
    sort_paths(in p, in blob, f, inout paths);
    let mut out = ChunkSeq::with_capacity[u32](paths.len());
    for i in 0..paths.len() {
        let k = u32_at(in paths, i);
        let path = act_path(in p, f, k);
        let mut covered = false;
        for j in 0..out.len() {
            if starts_with(in p, path, act_path(in p, f, u32_at(in out, j))) {
                covered = true;
                break;
            }
        }
        if !covered {
            out.push(k);
        }
    }
    paths.clear();
    paths.extend(in out.as_slice());
}

fn put_paths(inout o: ChunkSeq[u8], in p: Prog, in blob: Str, f: FnFacts, in paths: ChunkSeq[u32]) {
    for i in 0..paths.len() {
        if i != 0 {
            put(inout o, in ", ");
        }
        let path = act_path(in p, f, u32_at(in paths, i));
        for j in 0..list_len(in p, path) {
            if j != 0 {
                o.push(46);
            }
            put_sym(inout o, in p, in blob, list_at(in p, path, j));
        }
    }
}

fn contains_path(in p: Prog, f: FnFacts, in paths: ChunkSeq[u32], path: u32) -> bool {
    for i in 0..paths.len() {
        if path_eq(in p, act_path(in p, f, u32_at(in paths, i)), path) {
            return true;
        }
    }
    false
}

fn list_has(in p: Prog, list: u32, x: u32) -> bool {
    for i in 0..list_len(in p, list) {
        if list_at(in p, list, i) == x {
            return true;
        }
    }
    false
}

// `projection_findings` for function `fi`; findings go to `out`, counted in
// `count`.
fn projection_findings(in p: Prog, in blob: Str, fi: u64, inout w: Work, inout out: ChunkSeq[u64], inout count: u64) eff [Fail[LintFail]] {
    let f = fn_at(in p, fi);
    for k in 0..widen_u64(f.act_len) {
        if act_at(in p, wrapping_add(widen_u64(f.act_first), k)).kind == A_OPAQUE {
            return;
        }
    }
    let mut writes = ChunkSeq::new[u32]();
    let mut reads = ChunkSeq::new[u32]();
    for pi in 0..list_len(in p, f.facts) {
        let q = param_at(in p, list_at(in p, f.facts, pi));
        if q.pass != PASS_INOUT || list_len(in p, q.projections) != 0 || list_len(in p, q.fields) == 0 {
            continue;
        }
        writes.clear();
        reads.clear();
        let mut blocked = false;
        for k in 0..widen_u64(f.act_len) {
            tick(inout w);
            let a = act_at(in p, wrapping_add(widen_u64(f.act_first), k));
            if a.kind != A_ACCESS || a.a != q.name {
                continue;
            }
            if list_len(in p, a.b) == 0 || a.moves || !list_has(in p, q.fields, list_at(in p, a.b, 0)) {
                blocked = true;
                break;
            }
            if a.pass == PASS_INOUT {
                if !contains_path(in p, f, in writes, a.b) {
                    writes.push(wrapping_u32(k));
                }
            } else if !contains_path(in p, f, in reads, a.b) {
                reads.push(wrapping_u32(k));
            }
        }
        if blocked || writes.len() == 0 {
            continue;
        }
        minimize(in p, in blob, f, inout writes);
        minimize(in p, in blob, f, inout reads);
        let mut kept = ChunkSeq::with_capacity[u32](reads.len());
        for i in 0..reads.len() {
            let r = u32_at(in reads, i);
            let mut under = false;
            for j in 0..writes.len() {
                if starts_with(in p, act_path(in p, f, r), act_path(in p, f, u32_at(in writes, j))) {
                    under = true;
                    break;
                }
            }
            if !under {
                kept.push(r);
            }
        }
        reads.clear();
        reads.extend(in kept.as_slice());
        let mut all = true;
        for i in 0..list_len(in p, q.fields) {
            let field = list_at(in p, q.fields, i);
            let mut whole = false;
            for j in 0..writes.len() {
                let path = act_path(in p, f, u32_at(in writes, j));
                if list_len(in p, path) == 1 && list_at(in p, path, 0) == field {
                    whole = true;
                    break;
                }
            }
            if !whole {
                all = false;
                break;
            }
        }
        if all {
            continue;
        }
        out.push(0);
        out.push(fi);
        out.push(q.start);
        out.push(q.end);
        out.push(pi);
        out.push(writes.len());
        for i in 0..writes.len() {
            out.push(widen_u64(u32_at(in writes, i)));
        }
        out.push(reads.len());
        for i in 0..reads.len() {
            out.push(widen_u64(u32_at(in reads, i)));
        }
        let mut msg = ChunkSeq::new[u8]();
        put(inout msg, in "inout ");
        put_sym(inout msg, in p, in blob, q.name);
        put(inout msg, in " mutates {");
        put_paths(inout msg, in p, in blob, f, in writes);
        put(inout msg, in "} and reads {");
        put_paths(inout msg, in p, in blob, f, in reads);
        put(inout msg, in "}; narrower signature needs caller review (diagnostic only)");
        push_text(inout out, in msg.as_slice());
        count = inc(count);
    }
}

// `analyze`. `facts` and `blob` are port.rs's encoding of the program.
// The result: the work used, the findings (each its rule (0 L0101,
// 1 L0102), function index, span, the rule's detail and the message), then
// the skipped functions (function index, reason).
pub fn analyze(in facts: Slice[u64], in blob: Str, functions: u64, actions: u64, work: u64, call_depth: u64) -> ChunkSeq[u64] eff [Fail[LintFail]] {
    let mut p = decode(in facts, in blob);
    check_limits(in p, functions, actions, work, call_depth);
    let mut w = Work {
        remaining: work,
        used: 0,
        depth: call_depth
    };
    let mut findings = ChunkSeq::new[u64]();
    let mut nfindings: u64 = 0;
    let mut skipped = ChunkSeq::new[u64]();
    let mut seen = ChunkSeq::new[bool]();
    seen.resize(p.fns.len(), false);
    for fi in 0..p.fns.len() {
        let f = fn_at(in p, fi);
        if !f.owned || !f.body {
            continue;
        }
        let mut depth: u64 = 0;
        let req = required(inout p, f.name, inout seen, inout depth, inout w);
        if req.reason == OK {
            let inst = row_at(in p, f.effects).instances;
            for i in 0..list_len(in p, inst) {
                let e = list_at(in p, inst, i);
                if !contains_effect(in p, in req.effects, e) {
                    findings.push(1);
                    findings.push(fi);
                    findings.push(f.start);
                    findings.push(f.end);
                    findings.push(i);
                    let mut msg = ChunkSeq::new[u8]();
                    put(inout msg, in "unused effect capability ");
                    put_effect(inout msg, in p, in blob, e);
                    push_text(inout findings, in msg.as_slice());
                    nfindings = inc(nfindings);
                }
            }
        } else {
            skipped.push(fi);
            skipped.push(req.reason);
        }
        projection_findings(in p, in blob, fi, inout w, inout findings, inout nfindings);
    }
    let mut out = ChunkSeq::with_capacity[u64](wrapping_add(wrapping_add(findings.len(), skipped.len()), 3));
    out.push(w.used);
    out.push(nfindings);
    out.extend(in findings.as_slice());
    out.push(skipped.len() / 2);
    out.extend(in skipped.as_slice());
    out
}

// ================================================================ edits

const E_EDIT_LIMIT: u64 = 15;
const E_STALE: u64 = 16;
const E_CANDIDATE: u64 = 18;

copy struct EditKey {
    start: u64,
    end: u64,
    index: u64
}

impl Ord for EditKey {}

fn char_boundary(in s: Slice[u8], i: u64) -> bool {
    if i == s.len() {
        return true;
    }
    if i > s.len() {
        return false;
    }
    let c = at(in s, i);
    c < 128 || c >= 192
}

// `apply_edits`: `edits` holds the count, then per edit its span and the
// (start, len) of its expected text and replacement in `texts`.
pub fn apply_edits(in source: Str, in edits: Slice[u64], in texts: Str, max_bytes: u64) -> ChunkSeq[u8] eff [Fail[LintFail]] {
    let n = word(in edits, 0);
    let s = source.as_bytes();
    let x = texts.as_bytes();
    if n > 8192 || s.len() > max_bytes || max_bytes > 262144 {
        fail(E_EDIT_LIMIT);
    }
    let mut keys = ChunkSeq::with_capacity[EditKey](n);
    for i in 0..n {
        let b = inc(wrapping_mul(i, 6));
        keys.push(
            EditKey {
                start: word(in edits, b),
                end: word(in edits, inc(b)),
                index: i
            }
        );
    }
    sort(inout keys.as_slice_mut());
    let mut end: u64 = 0;
    let mut bytes = s.len();
    for k in 0..n {
        let e = match keys.try_get(k) {
            Option::Some(e) => e,
            Option::None => EditKey {
                start: 0,
                end: 0,
                index: 0
            },
        };
        let b = inc(wrapping_mul(e.index, 6));
        let es = word(in edits, wrapping_add(b, 2));
        let el = word(in edits, wrapping_add(b, 3));
        let rl = word(in edits, wrapping_add(b, 5));
        if e.start < end || e.start >= e.end || e.end > s.len() || !char_boundary(in s, e.start) || !char_boundary(in s, e.end) || wrapping_sub(e.end, e.start) != el {
            fail(E_STALE);
        }
        for i in 0..el {
            if at(in s, wrapping_add(e.start, i)) != at(in x, wrapping_add(es, i)) {
                fail(E_STALE);
            }
        }
        end = e.end;
        bytes = wrapping_add(wrapping_sub(bytes, el), rl);
        if bytes > max_bytes {
            fail(E_CANDIDATE);
        }
    }
    let mut out = ChunkSeq::with_capacity[u8](bytes);
    let mut cursor: u64 = 0;
    for k in 0..n {
        let e = match keys.try_get(k) {
            Option::Some(e) => e,
            Option::None => EditKey {
                start: 0,
                end: 0,
                index: 0
            },
        };
        let b = inc(wrapping_mul(e.index, 6));
        let rs = word(in edits, wrapping_add(b, 4));
        let rl = word(in edits, wrapping_add(b, 5));
        out.extend(in s[cursor..e.start]);
        out.extend(in x[rs..wrapping_add(rs, rl)]);
        cursor = e.end;
    }
    out.extend(in s[cursor..s.len()]);
    out
}
